---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { getWhatsAppUrl } from '@/data/siteData';

const naskah = getNaskahById('93');
if (!naskah) {
  throw new Error("Naskah ID 93 not found");
}

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Panduan Tekstil', url: '/blog/' },
  { name: 'Panduan Perawatan Tote Bag', url: '/panduan-perawatan-tote-bag/' }
];

const waCareUrl = getWhatsAppUrl({
  notes: "Halo Tim ToteBag, saya ingin konsultasi perawatan dan spesifikasi bahan tote bag",
  sourcePage: "/panduan-perawatan-tote-bag/"
});

const faqItems = naskah.faqs.map((f, i) => ({
  id: `faq-93-${i}`,
  question: f.question,
  answer: f.answer,
  category: 'umum' as const
}));
---

<BaseLayout
  title={naskah.seoTitle || "Panduan Merawat Tote Bag Berdasarkan Bahan | Tote Bag"}
  description={naskah.metaDescription}
  canonicalUrl={naskah.canonical}
  jsonLd={naskah.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <header class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-75">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge-accent">PANDUAN PERAWATAN &amp; DURABILITAS</span>
        </div>
        <h1 class="hero-title mb-3">
          {naskah.h1}
        </h1>
        <p class="lead text-muted fs-5 mb-0" style="line-height: 1.7;">
          Panduan praktis menjaga kebersihan, ketahanan warna kain, serta keawetan sablon tote bag Anda berdasarkan jenis serat kain: Canvas, Blacu, Spunbond, Drill, hingga Kulit Sintetis.
        </p>
      </div>
    </div>
  </header>

  <!-- Direct Answer Box (AEO GEO Optimized) -->
  <section class="pb-5">
    <div class="container">
      <div class="p-4 p-md-5 rounded-4 bg-light border border-success-subtle shadow-sm mb-5">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="badge bg-success text-white">Ringkasan Prinsip Perawatan</span>
          <span class="text-muted small">Edukasi Praktisi Tekstil</span>
        </div>
        <p class="fs-5 text-dark mb-0" style="line-height: 1.8;">
          {naskah.directAnswer}
        </p>
      </div>

      <!-- Panduan Perawatan Berdasarkan Bahan Matrix -->
      <div class="mb-5">
        <div class="text-center max-w-75 mx-auto mb-4">
          <h2 class="h3 fw-bold mb-2">Instruksi Perawatan Sesuai Karakteristik Bahan</h2>
          <p class="text-muted small">
            Setiap material kain memiliki respon berbeda terhadap air, suhu panas setrika, dan deterjen kimia.
          </p>
        </div>

        <div class="row g-4">
          <!-- 1. Canvas -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-success-subtle text-success border">Kain Tenun Kuat</span>
                <span class="small text-muted fw-bold">Canvas</span>
              </div>
              <h3 class="h5 fw-bold mb-2">Canvas (Twill / Marsoto)</h3>
              <p class="small text-muted mb-3">
                Bahan serat katun-poliester berbobot tebal yang sangat kokoh namun membutuhkan penanganan khusus agar tidak pudar.
              </p>
              <ul class="list-unstyled small text-muted mb-0 border-top pt-3 d-flex flex-column gap-2">
                <li><strong>Cara Cuci:</strong> Cuci tangan dengan air dingin dan deterjen cair lembut. Hindari mesin cuci bersiklus kencang.</li>
                <li><strong>Penyikatan:</strong> Gunakan sikat berbulu halus hanya pada bagian noda, hindari menggosok keras area sablon.</li>
                <li><strong>Penjemuran:</strong> Balik tas (bagian dalam di luar) dan gantung di area berangin tanpa terik matahari langsung.</li>
                <li><strong>Penyetrikaan:</strong> Suhu sedang, setrika dari bagian dalam tas.</li>
              </ul>
            </div>
          </div>

          <!-- 2. Blacu -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-warning-subtle text-dark border">Serat Alami Unbleached</span>
                <span class="small text-muted fw-bold">Blacu</span>
              </div>
              <h3 class="h5 fw-bold mb-2">Blacu Natural</h3>
              <p class="small text-muted mb-3">
                Kain kapas mentah tanpa proses pemutih kimia. Memiliki karakter alami berserat rapat yang rentan menyusut bila terkena air panas.
              </p>
              <ul class="list-unstyled small text-muted mb-0 border-top pt-3 d-flex flex-column gap-2">
                <li><strong>Cara Cuci:</strong> Rendam singkat maksimal 10 menit dengan air dingin. Jangan gunakan deterjen pemutih (bleach).</li>
                <li><strong>Pemerasan:</strong> Tekan lembut dengan handuk bersih, jangan dipelintir kencang agar serat kapas tidak kusut permanen.</li>
                <li><strong>Penjemuran:</strong> Rentangkan pada gantungan datar di tempat teduh agar bentuk tas tetap simetris.</li>
                <li><strong>Penyetrikaan:</strong> Suhu sedang-tinggi dengan sedikit semprotan uap air.</li>
              </ul>
            </div>
          </div>

          <!-- 3. Spunbond -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-primary-subtle text-primary border">Non-Woven Polypropylene</span>
                <span class="small text-muted fw-bold">Spunbond</span>
              </div>
              <h3 class="h5 fw-bold mb-2">Spunbond Eco</h3>
              <p class="small text-muted mb-3">
                Material sintetis higienis dan ekonomis. Memiliki titik leleh rendah sehingga mutlak dihindarkan dari panas langsung.
              </p>
              <ul class="list-unstyled small text-muted mb-0 border-top pt-3 d-flex flex-column gap-2">
                <li><strong>Cara Cuci:</strong> DILARANG mencuci di mesin cuci. Cukup lap permukaan kotor dengan kain microfiber basah.</li>
                <li><strong>Perendaman:</strong> Bila sangat kotor, bilas cepat di air sabun dingin lalu angin-anginkan.</li>
                <li><strong>PANTANGAN BESAR:</strong> JANGAN disetrika! Panas setrika akan langsung melelehkan serat polipropilena spunbond.</li>
                <li><strong>Penyimpanan:</strong> Lipat rapi di tempat kering terlindung dari sinar UV matahari terus-menerus.</li>
              </ul>
            </div>
          </div>

          <!-- 4. Kulit Sintetis -->
          <div class="col-12 col-md-6">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-dark-subtle text-dark border">PU / PVC Leather</span>
                <span class="small text-muted fw-bold">Semi-Kulit</span>
              </div>
              <h3 class="h5 fw-bold mb-2">Kulit Sintetis (Executive Gift)</h3>
              <p class="small text-muted mb-3">
                Tampilan mewah dan kedap air. Musuh utamanya adalah kelembapan tinggi yang memicu jamur serta panas berlebih yang membuat lapisan pecah-pecah.
              </p>
              <ul class="list-unstyled small text-muted mb-0 border-top pt-3 d-flex flex-column gap-2">
                <li><strong>Pembersihan Rutin:</strong> Seka debu harian dengan lap kering lembut. Noda basah dibersihkan dengan sabun bayi encer.</li>
                <li><strong>Perawatan Kulit:</strong> Oleskan leather conditioner atau lotion pelembab tipis-tipis setiap 1-2 bulan.</li>
                <li><strong>Penyimpanan:</strong> Berikan gumpalan kertas di dalam tas agar bentuk tidak penyok, simpan bersama silica gel.</li>
              </ul>
            </div>
          </div>

          <!-- 5. Drill & Cordura -->
          <div class="col-12 col-md-6">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="badge bg-info-subtle text-dark border">Heavy-Duty Synthetic</span>
                <span class="small text-muted fw-bold">Drill &amp; Cordura</span>
              </div>
              <h3 class="h5 fw-bold mb-2">Kain Drill &amp; Cordura</h3>
              <p class="small text-muted mb-3">
                Material serbaguna dengan jalinan benang kuat yang tahan gesekan dan sangat awet untuk pemakaian harian outdoor.
              </p>
              <ul class="list-unstyled small text-muted mb-0 border-top pt-3 d-flex flex-column gap-2">
                <li><strong>Cara Cuci:</strong> Aman dicuci tangan atau mesin cuci dengan putaran rendah (gentle cycle).</li>
                <li><strong>Pengeringan:</strong> Cepat kering, cukup diangin-anginkan di tempat teduh.</li>
                <li><strong>Perawatan Sablon:</strong> Hindari menyetrika langsung sablon karet/plastisol, gunakan pelapis kain katun tipis di atasnya.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- 4 Golden Rules Merawat Sablon & Sablon DTF -->
      <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm mb-5">
        <h2 class="h3 fw-bold mb-3">4 Aturan Emas Menjaga Kualitas Cetak Sablon &amp; DTF</h2>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 bg-light border h-100">
              <h3 class="h6 fw-bold text-success mb-1">1. Setrika Dari Balik Kain (Inside-Out)</h3>
              <p class="small text-muted mb-0">Panas langsung dari tapak setrika dapat melunakkan tinta sablon plastisol atau lem DTF dan membuatnya menempel pada besi setrika.</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 bg-light border h-100">
              <h3 class="h6 fw-bold text-success mb-1">2. Hindari Penggunaan Pemutih Klorin</h3>
              <p class="small text-muted mb-0">Cairan pemutih dapat mengikis pigmen warna tinta sablon dan memicu retakan mikro pada permukaan gambar.</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 bg-light border h-100">
              <h3 class="h6 fw-bold text-success mb-1">3. Jangan Rendam Terlalu Lama</h3>
              <p class="small text-muted mb-0">Perendaman lebih dari 30 menit dapat merusak daya rekat binder tinta pada serat kain tenun dan menyebabkan bau apek.</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 bg-light border h-100">
              <h3 class="h6 fw-bold text-success mb-1">4. Hindari Pemerasan Melintir Ekstrem</h3>
              <p class="small text-muted mb-0">Memeras dengan memuntir kain tepat di area gambar sablon berisiko menyebabkan tinta pecah atau meregang tidak rata.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="mb-5">
        <div class="text-center max-w-75 mx-auto mb-4">
          <h2 class="h3 fw-bold mb-2">Pertanyaan Seputar Perawatan Tote Bag</h2>
          <p class="text-muted small">Jawaban teknis dari spesialis produksi tekstil konveksi.</p>
        </div>
        <div class="max-w-75 mx-auto">
          <FAQAccordion items={faqItems} defaultOpen={0} />
        </div>
      </div>

      <!-- CTA Box -->
      <div class="p-4 p-md-5 rounded-4 text-white text-center shadow" style="background: linear-gradient(135deg, #1B4D3E 0%, #0d2820 100%);">
        <h2 class="h3 fw-bold mb-3">Butuh Tote Bag Berkualitas Tinggi yang Tahan Lama?</h2>
        <p class="max-w-75 mx-auto text-white-50 mb-4" style="line-height: 1.7;">
          Kami memproduksi tote bag custom menggunakan material grade A dengan standar jahitan rantai dan teknik sablon teruji tahan cuci berulang kali.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
          <a href={waCareUrl} target="_blank" rel="noopener noreferrer" class="btn btn-warning btn-lg fw-bold">
            Konsultasi Spesifikasi via WA
          </a>
          <a href="/jenis-bahan-tote-bag/" class="btn btn-outline-light btn-lg">
            Lihat Karakteristik Lengkap Bahan
          </a>
        </div>
      </div>

      <!-- Related Navigation -->
      <div class="mt-4 text-center">
        <p class="small text-muted">
          Pelajari panduan lainnya: <a href="/jenis-bahan-tote-bag/" class="text-decoration-underline text-success">Karakteristik Bahan</a> &bull; <a href="/panduan-produksi-tote-bag/" class="text-decoration-underline text-success">Standar QC Produksi</a> &bull; <a href="/tote-bag-custom/" class="text-decoration-underline text-success">Custom Sablon &amp; DTF</a> &bull; <a href="/harga-tote-bag-custom/" class="text-decoration-underline text-success">Estimasi Harga</a>
        </p>
      </div>

    </div>
  </section>
</BaseLayout>
