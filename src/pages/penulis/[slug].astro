---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { authors, articles, getWhatsAppUrl } from '@/data/siteData';

export async function getStaticPaths() {
  return Object.values(authors).map(author => ({
    params: { slug: author.slug },
    props: { author }
  }));
}

const { author } = Astro.props;
const authorArticles = articles.filter(a => a.authorId === author.id);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Penulis', url: '#' },
  { name: author.name, url: `/penulis/${author.slug}/` }
];

const waAuthorUrl = getWhatsAppUrl({
  notes: `Inquiry via halaman penulis: ${author.name}`,
  sourcePage: `/penulis/${author.slug}/`
});

// JSON-LD Person Schema
const sameAsLinks = author.socials ? [
  author.socials.instagram,
  author.socials.x,
  author.socials.linkedin
].filter(Boolean) : [];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": author.name,
  "jobTitle": author.role,
  "description": author.bio,
  "image": `https://totebag.web.id${author.imageUrl}`,
  "url": `https://totebag.web.id/penulis/${author.slug}/`,
  ...(sameAsLinks.length > 0 ? { "sameAs": sameAsLinks } : {}),
  "worksFor": {
    "@id": "https://totebag.web.id/#organization"
  }
};
---

<BaseLayout
  title={`${author.name} — ${author.role}`}
  description={`Profil ${author.name}, ${author.role} di ToteBag.web.id. Pengalaman SEO, web development, dan strategi pengadaan tote bag custom.`}
  canonicalUrl={`https://totebag.web.id/penulis/${author.slug}/`}
  jsonLd={personSchema}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="p-4 p-lg-5 rounded-4 bg-white border">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-md-3 text-center">
            <img 
              src={author.imageUrl} 
              alt={author.name} 
              width="150" 
              height="150" 
              class="rounded-circle border p-1 shadow-sm"
              style="object-fit: cover;"
            />
          </div>
          <div class="col-12 col-md-9">
            <span class="badge-accent mb-2">PROFIL PENULIS &amp; STRATEGIS</span>
            <h1 class="h2 fw-bold mb-1">{author.name}</h1>
            <p class="text-success fw-semibold mb-2">{author.role}</p>

            {author.socials && (
              <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                {author.socials.instagram && (
                  <a 
                    href={author.socials.instagram} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline-secondary btn-sm py-1 px-2 d-inline-flex align-items-center gap-1 text-dark"
                    style="font-size: 0.775rem;"
                    aria-label={`Instagram ${author.name}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#E1306C" viewBox="0 0 16 16">
                      <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
                    </svg>
                    <span>Instagram</span>
                  </a>
                )}
                {author.socials.x && (
                  <a 
                    href={author.socials.x} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline-secondary btn-sm py-1 px-2 d-inline-flex align-items-center gap-1 text-dark"
                    style="font-size: 0.775rem;"
                    aria-label={`X ${author.name}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#000000" viewBox="0 0 16 16">
                      <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
                    </svg>
                    <span>X</span>
                  </a>
                )}
                {author.socials.linkedin && (
                  <a 
                    href={author.socials.linkedin} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline-secondary btn-sm py-1 px-2 d-inline-flex align-items-center gap-1 text-dark"
                    style="font-size: 0.775rem;"
                    aria-label={`LinkedIn ${author.name}`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#0A66C2" viewBox="0 0 16 16">
                      <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
                    </svg>
                    <span>LinkedIn</span>
                  </a>
                )}
              </div>
            )}

            <p class="text-muted mb-4">
              {author.bio}
            </p>

            <div class="mb-4">
              <strong class="d-block small text-dark mb-2">Fokus Keahlian &amp; Riset Tekstil:</strong>
              <div class="d-flex flex-wrap gap-2">
                {author.expertise.map(exp => (
                  <span class="badge-brand">{exp}</span>
                ))}
              </div>
            </div>

            <a href={waAuthorUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-sm">
              Konsultasi Pengadaan &amp; Strategi Bersama Kami
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Daftar Artikel Penulis -->
  <section class="section-space pt-0">
    <div class="container">
      <h2 class="h4 fw-bold mb-4">Artikel &amp; Panduan oleh {author.name}</h2>
      <div class="row g-4">
        {authorArticles.map(art => (
          <div class="col-12 col-md-6 col-lg-4">
            <article class="custom-card h-100 d-flex flex-column">
              <div class="p-4 d-flex flex-column flex-grow-1">
                <span class="badge-brand align-self-start mb-2">{art.category}</span>
                <h3 class="h5 fw-bold mb-2">
                  <a href={`/blog/${art.slug}/`} class="text-decoration-none text-reset">
                    {art.title}
                  </a>
                </h3>
                <p class="small text-muted mb-3 flex-grow-1">
                  {art.excerpt}
                </p>
                <a href={`/blog/${art.slug}/`} class="btn btn-brand-outline btn-sm align-self-start mt-auto">
                  Baca Panduan &rarr;
                </a>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
