---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { getWhatsAppUrl, products } from '@/data/siteData';

const naskah = getNaskahById('09');
if (!naskah) {
  throw new Error("Naskah ID 09 not found");
}

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Karakteristik Bahan', url: '/jenis-bahan-tote-bag/' }
];

const waUrl = getWhatsAppUrl({
  notes: "Konsultasi karakteristik bahan tote bag",
  sourcePage: "/jenis-bahan-tote-bag/"
});

const faqItems = naskah.faqs.map((f, i) => ({
  id: `faq-09-${i}`,
  question: f.question,
  answer: f.answer,
  category: 'bahan' as const
}));
---

<BaseLayout
  title={naskah.seoTitle || "Jenis Bahan Tote Bag dan Cara Memilihnya | Tote Bag"}
  description={naskah.metaDescription}
  canonicalUrl={naskah.canonical}
  jsonLd={naskah.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <header class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-75">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge-accent">PANDUAN MATERIAL &amp; KAIN</span>
        </div>
        <h1 class="hero-title mb-3">
          {naskah.h1}
        </h1>
        <p class="lead text-muted fs-5 mb-0" style="line-height: 1.7;">
          Panduan teknis memahami perbedaan kerapatan serat, ketebalan (oz/gsm), daya tahan beban, dan kesesuaian teknik cetak logo pada berbagai kain tote bag.
        </p>
      </div>
    </div>
  </header>

  <!-- Comparison Matrix Table Section -->
  <section class="py-3">
    <div class="container">
      <div class="p-4 rounded-4 bg-white border shadow-sm mb-5">
        <h2 class="h5 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
          <span class="badge bg-success text-white">Matriks</span>
          <span>Perbandingan Cepat 4 Karakteristik Bahan:</span>
        </h2>
        <div class="table-responsive">
          <table class="table table-bordered align-middle mb-0" style="font-size: 0.92rem;">
            <thead class="table-light">
              <tr>
                <th scope="col" style="min-width: 140px;">Bahan Kain</th>
                <th scope="col">Ketebalan / Gramasi</th>
                <th scope="col">Kekuatan Beban</th>
                <th scope="col">Karakter Visual</th>
                <th scope="col">Rekomendasi Pemakaian</th>
                <th scope="col">Koleksi</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Canvas (Twill &amp; Marsoto)</strong></td>
                <td>10 - 14 oz (Tebal &amp; Kaku)</td>
                <td><span class="badge bg-success">Hingga 10 kg</span></td>
                <td>Premium, kokoh, berstruktur elegan</td>
                <td>Merchandise eksklusif, onboarding kit, ritel</td>
                <td><a href="/produk/tote-bag-canvas/" class="text-success fw-bold text-decoration-none">Lihat Canvas &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Dinir D300 &amp; D600</strong></td>
                <td>Sedang - Tebal (Polyester PVC)</td>
                <td><span class="badge bg-success">7 - 9 kg</span></td>
                <td>Tahan air, permukaan doff, kuat</td>
                <td>Tas seminar kit dinas, safety campaign, outdoor</td>
                <td><a href="/produk/" class="text-success fw-bold text-decoration-none">Lihat Dinir &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Cordura Heavy Duty</strong></td>
                <td>Tebal (Nylon / Polyester 1000D)</td>
                <td><span class="badge bg-dark">10 - 12 kg</span></td>
                <td>Waterproof, anti gesek, tactical</td>
                <td>Merchandise industri tambang, gathering korporat</td>
                <td><a href="/produk/" class="text-success fw-bold text-decoration-none">Lihat Cordura &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Blacu Super Grade A</strong></td>
                <td>Sedang (Serat Kapas Alami)</td>
                <td><span class="badge bg-primary">3 - 6 kg</span></td>
                <td>Broken white natural, vintage, eco</td>
                <td>Seminar kit nasional, souvenir kampus, workshop</td>
                <td><a href="/produk/tote-bag-blacu/" class="text-success fw-bold text-decoration-none">Lihat Blacu &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Mika Transparan PVC</strong></td>
                <td>0.5 - 0.7 mm (Plastik Tebal)</td>
                <td><span class="badge bg-info text-dark">4 - 6 kg</span></td>
                <td>Bening jernih kristal, 100% anti air</td>
                <td>Hampers kecantikan, merchandise konser, pameran seni</td>
                <td><a href="/produk/" class="text-success fw-bold text-decoration-none">Lihat Mika &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Denim Jeans</strong></td>
                <td>10 - 12 oz (Kain Jeans)</td>
                <td><span class="badge bg-primary">6 - 8 kg</span></td>
                <td>Kasual, berjiwa muda, awet</td>
                <td>Merchandise distro apparel, komunitas kreatif</td>
                <td><a href="/produk/" class="text-success fw-bold text-decoration-none">Lihat Denim &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Satin Printing</strong></td>
                <td>Halus &amp; Mengkilap (Bridal)</td>
                <td><span class="badge bg-secondary">3 - 5 kg</span></td>
                <td>Full printing CMYK tajam &amp; kilau mewah</td>
                <td>Goodie bag pariwisata, souvenir pameran visual</td>
                <td><a href="/produk/" class="text-success fw-bold text-decoration-none">Lihat Satin &rarr;</a></td>
              </tr>
              <tr>
                <td><strong>Spunbond Non-Woven</strong></td>
                <td>75 - 100 gsm (Ringan)</td>
                <td><span class="badge bg-secondary">2 - 3 kg</span></td>
                <td>Banyak pilihan warna cerah, higienis</td>
                <td>Goodie bag expo, pameran massal, tas belanja</td>
                <td><a href="/produk/tote-bag-spunbond/" class="text-success fw-bold text-decoration-none">Lihat Spunbond &rarr;</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="row g-5">
        <!-- Content Column (col-12 col-lg-8) -->
        <div class="col-12 col-lg-8">

          <!-- Direct Answer Callout Box -->
          {naskah.directAnswer && (
            <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success mb-4 shadow-sm">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <span class="badge bg-success text-white">Ringkasan Seleksi</span>
                <span class="fs-6">Prinsip Menentukan Bahan:</span>
              </div>
              <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
                {naskah.directAnswer}
              </p>
            </div>
          )}

          <!-- Quick Navigation / Table of Contents -->
          {naskah.toc && naskah.toc.length > 0 && (
            <div class="p-4 rounded-4 bg-light border mb-4">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                <span>Daftar Pembahasan Panduan:</span>
              </div>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                {naskah.toc.map((item, idx) => (
                  <li class={item.level === 3 ? 'ps-3' : ''}>
                    <a href={`#${item.id}`} class="text-decoration-none text-success fw-medium">
                      {idx + 1}. {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Dynamic HTML Content parsed from Naskah -->
          <div class="article-content-body d-flex flex-column gap-3 text-muted" style="line-height: 1.85; font-size: 1.05rem;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>

          <!-- FAQ Accordion -->
          {faqItems.length > 0 && (
            <div class="mt-5 pt-4 border-top">
              <span class="badge-accent mb-2">TANYA JAWAB MATERIAL</span>
              <h2 class="h4 fw-bold text-dark mb-3">Pertanyaan yang Sering Diajukan</h2>
              <FAQAccordion items={faqItems} accordionId="faqAccordion09" />
            </div>
          )}

          <!-- Bottom Action Banner -->
          <div class="p-4 p-lg-5 rounded-4 bg-brand-dark text-white mt-5">
            <span class="badge bg-warning text-dark fw-bold mb-2">SAMPEL KAIN GRATIS</span>
            <h3 class="h4 fw-bold mb-2 text-white">Masih Ragu Menentukan Jenis Kain?</h3>
            <p class="small text-white-50 mb-4" style="max-width: 600px;">
              Untuk pemesanan institusi di atas 300 unit, kami menyediakan sampel fisik (sample proofing) kain canvas atau blacu sebelum proses potong dan jahit massal dimulai.
            </p>
            <div class="d-flex flex-wrap gap-2">
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/></svg>
                Minta Rekomendasi Kain via WA
              </a>
              <a href="/produk/" class="btn btn-outline-light">
                Jelajahi Semua Produk
              </a>
            </div>
          </div>

        </div>

        <!-- Sticky Sidebar (col-12 col-lg-4) -->
        <div class="col-12 col-lg-4">
          <div class="sticky-sidebar d-flex flex-column gap-4" style="top: 85px;">

            <!-- Material Detail Cards -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                <span>Halaman Kategori Bahan:</span>
              </h3>
              <div class="d-flex flex-column gap-3">
                <a href="/produk/tote-bag-canvas/" class="p-3 rounded-3 border text-decoration-none hover-bg-light d-block">
                  <div class="fw-bold text-dark small">Tote Bag Canvas</div>
                  <div class="text-muted" style="font-size: 0.78rem;">Tebal, kokoh, tekstur rapat, formal &amp; premium</div>
                </a>
                <a href="/produk/tote-bag-blacu/" class="p-3 rounded-3 border text-decoration-none hover-bg-light d-block">
                  <div class="fw-bold text-dark small">Tote Bag Blacu</div>
                  <div class="text-muted" style="font-size: 0.78rem;">Serat unbleached alami, broken white, ekonomis</div>
                </a>
                <a href="/produk/tote-bag-spunbond/" class="p-3 rounded-3 border text-decoration-none hover-bg-light d-block">
                  <div class="fw-bold text-dark small">Tote Bag Spunbond</div>
                  <div class="text-muted" style="font-size: 0.78rem;">Praktis, tahan air, budget hemat volume ribuan</div>
                </a>
                <a href="/produk/tote-bag-kulit/" class="p-3 rounded-3 border text-decoration-none hover-bg-light d-block">
                  <div class="fw-bold text-dark small">Tote Bag Kulit Sintetis</div>
                  <div class="text-muted" style="font-size: 0.78rem;">Waterproof, prestisius, cocok untuk VIP &amp; Direksi</div>
                </a>
              </div>
            </div>

            <!-- Related Pillar Pages -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3">Panduan Lainnya:</h3>
              <div class="d-flex flex-column gap-2 small">
                <a href="/tote-bag/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Pengertian, Jenis &amp; Kegunaan
                </a>
                <a href="/blog/canvas-vs-blacu-mana-yang-lebih-cocok/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Canvas vs Blacu: Perbandingan Bahan
                </a>
                <a href="/tote-bag-custom/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Jasa Sablon &amp; Cetak DTF Logo
                </a>
                <a href="/cara-pesan/" class="text-decoration-none text-dark py-1 hover-text-success">
                  &bull; Cara Memesan &amp; Konsultasi DP
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-content-body :global(h2) {
    font-size: 1.45rem;
    font-weight: 700;
    color: #173F38;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(23, 63, 56, 0.1);
  }

  .article-content-body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    color: #2b3330;
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .article-content-body :global(p) {
    margin-bottom: 1.1rem;
    line-height: 1.85;
  }

  .article-content-body :global(ul),
  .article-content-body :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: 1.2rem;
  }

  .article-content-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-content-body :global(a) {
    color: #173F38;
    font-weight: 600;
    text-decoration: underline;
  }

  .article-content-body :global(a:hover) {
    color: #C18755;
  }

  .hover-bg-light:hover {
    background: rgba(23, 63, 56, 0.05);
  }

  .hover-text-success:hover {
    color: #173F38 !important;
  }
</style>
