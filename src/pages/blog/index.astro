---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { getBlogArticles } from '@/utils/naskah';
import { getWhatsAppUrl } from '@/data/siteData';

const articles = getBlogArticles();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Blog Edukasi', url: '/blog/' }
];

const blogWaUrl = getWhatsAppUrl({
  notes: "Inquiry dari Blog Edukasi",
  sourcePage: "/blog/"
});

const formatDate = (dateStr: string) => {
  try {
    const [year, month, day] = dateStr.split('-');
    const months = [
      'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
      'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
    ];
    return `${parseInt(day, 10)} ${months[parseInt(month, 10) - 1]} ${year}`;
  } catch (e) {
    return dateStr;
  }
};
---

<BaseLayout
  title="Blog Edukasi Tote Bag Custom B2B — Panduan Bahan & Cetak"
  description="Kumpulan panduan komprehensif seputar pengadaan tote bag custom: perbandingan kain canvas vs blacu vs spunbond, standar ukuran seminar, dan teknik cetak logo."
  canonicalUrl="https://totebag.web.id/blog/"
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-end g-4">
        <div class="col-12 col-lg-8">
          <span class="badge-accent mb-2">EDUKASI &amp; RISET MATERIAL</span>
          <h1 class="hero-title mb-3">Blog &amp; Panduan Pengadaan Tote Bag</h1>
          <p class="lead text-muted fs-5 mb-0" style="line-height: 1.7;">
            Panduan praktis dan objektif yang ditulis oleh praktisi produksi tekstil untuk membantu Anda mengambil keputusan vendor yang tepat dan efisien.
          </p>
        </div>
        <div class="col-12 col-lg-4 text-lg-end">
          <a href={blogWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand">
            Konsultasi Spesifikasi via WA
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Grid -->
  <section class="section-space pt-2">
    <div class="container">
      <div class="row g-4">
        {articles.map(art => (
          <div class="col-12 col-md-6 col-lg-4">
            <article class="custom-card h-100 d-flex flex-column shadow-sm rounded-4 overflow-hidden border bg-white">
              
              <!-- Subtle decorative top indicator -->
              <div class="w-100" style="height: 4px; background: linear-gradient(90deg, #173F38, #C18755);"></div>

              <div class="p-4 d-flex flex-column flex-grow-1">
                
                <!-- Category Cluster -->
                <div class="mb-3">
                  <span class="badge-accent text-truncate" style="font-size: 0.72rem; padding: 0.35rem 0.75rem;">
                    {art.cluster}
                  </span>
                </div>

                <!-- Date & Read Time Row -->
                <div class="d-flex align-items-center gap-2 text-muted mb-3" style="font-size: 0.78rem;">
                  <span class="d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <time datetime={art.jadwal}>{formatDate(art.jadwal)}</time>
                  </span>
                  <span class="opacity-50">•</span>
                  <span class="d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>{art.readTime}</span>
                  </span>
                </div>

                <!-- Article Title -->
                <h2 class="h5 fw-bold mb-2">
                  <a href={art.url} class="text-decoration-none text-dark hover-text-success d-block" style="line-height: 1.45; font-size: 1.12rem;">
                    {art.h1}
                  </a>
                </h2>

                <!-- Excerpt -->
                <p class="small text-muted mb-4 flex-grow-1" style="line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  {art.metaDescription || (art.directAnswer ? art.directAnswer.slice(0, 140) + '...' : '')}
                </p>

                <!-- Footer with CTA -->
                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                  <span class="text-muted small" style="font-size: 0.78rem;">Oleh <strong>M. Maulana Ishaq</strong></span>
                  <a href={art.url} class="btn btn-sm btn-brand-outline d-inline-flex align-items-center gap-1" style="font-size: 0.78rem; padding: 0.35rem 0.75rem;">
                    <span>Baca Panduan</span>
                    <span>&rarr;</span>
                  </a>
                </div>

              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hover-text-success:hover {
    color: #173F38 !important;
  }
</style>
