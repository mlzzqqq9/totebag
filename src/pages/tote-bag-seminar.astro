---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tote Bag Seminar Custom', url: '/tote-bag-seminar/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/tote-bag-seminar/#webpage",
      "url": "https://totebag.web.id/tote-bag-seminar/",
      "name": "Tote Bag Seminar Custom untuk Berbagai Acara | ToteBag",
      "description": "Pilihan bahan, ukuran, desain, dan cara memesan tote bag seminar custom untuk berbagai kebutuhan acara.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/tote-bag-seminar/#breadcrumb"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://totebag.web.id/#website",
      "url": "https://totebag.web.id/",
      "name": "ToteBag",
      "inLanguage": "id-ID"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/tote-bag-seminar/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tote Bag Seminar Custom",
          "item": "https://totebag.web.id/tote-bag-seminar/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/tote-bag-seminar/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa bahan tote bag terbaik untuk seminar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bahan terbaik bergantung pada jenis acara dan isi tas. Canvas cocok untuk penggunaan berulang dan kesan premium, blacu untuk tampilan natural, spunbond untuk kebutuhan distribusi ringan dalam jumlah besar, dan drill untuk tampilan yang lebih rapi."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa ukuran tote bag seminar yang ideal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk dokumen A4, pilih ukuran tas yang memberikan ruang tambahan di luar dimensi kertas 21 × 29,7 cm. Ukuran contoh 30 × 35 cm atau 35 × 40 cm dapat dipertimbangkan, dengan gusset jika membawa tumbler atau beberapa barang tebal. Ukur seluruh isi terlebih dahulu."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah tote bag seminar bisa diberi logo acara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tote bag seminar dapat direncanakan dengan logo perusahaan atau acara menggunakan sablon, DTF, atau bordir sesuai material, desain, ukuran cetak, dan hasil konfirmasi vendor."
          }
        },
        {
          "@type": "Question",
          "name": "Apa isi paket seminar kit dengan tote bag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paket seminar kit dapat berisi tote bag custom, notebook atau blocknote, pulpen, lanyard dan ID card, serta tumbler. Isi dipilih berdasarkan kebutuhan peserta, jenis acara, dan anggaran."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa harga tote bag seminar custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Harga ditentukan oleh jenis bahan, ukuran, jumlah pesanan, desain cetak, aksesori, dan jadwal pengerjaan. Mintalah penawaran tertulis berdasarkan spesifikasi yang sama agar pilihan vendor dapat dibandingkan."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana memesan tote bag seminar sebelum tanggal acara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Siapkan jumlah peserta, spesifikasi bahan dan ukuran, file logo, lokasi pengiriman, serta tanggal acara. Kirim brief ke vendor, tinjau penawaran dan mockup, lalu konfirmasi sampel jika diperlukan sebelum persetujuan produksi."
          }
        }
      ]
    }
  ]
};

const seminarPackages = [
