<script is:inline>
  (function () {
    const form = document.getElementById('rfqSeminarForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        e.stopPropagation();
        form.classList.add('was-validated');
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.focus();
        }
        return;
      }

      form.classList.add('was-validated');

      const data = new FormData(form);
      const val = function (k) {
        return String(data.get(k) || '').trim();
      };

      const nama = val('nama');
      const acara = val('acara');
      const jumlah = val('jumlah');
      const bahan = val('bahan') || 'Perlu rekomendasi';
      const tanggal = val('tanggal') || 'Belum ditentukan';
      const kota = val('kota') || 'Belum ditentukan';
      const catatan = val('catatan') || 'Perlu diskusi';

      const lines = [
        'Halo tim ToteBag.web.id, saya ingin konsultasi tote bag seminar custom.',
        '',
        'Nama/instansi: ' + nama,
        'Jenis acara: ' + acara,
        'Perkiraan jumlah: ' + jumlah + ' pcs',
        'Bahan: ' + bahan,
        'Tanggal acara: ' + tanggal,
        'Kota pengiriman: ' + kota,
        'Spesifikasi/catatan: ' + catatan,
        '',
        'Mohon informasi opsi bahan, ukuran, penawaran, dan estimasi jadwal pengerjaan. Terima kasih.',
        'Referensi: https://totebag.web.id/tote-bag-seminar/'
      ];

      const text = lines.join('\n');
      const waUrl = 'https://wa.me/6282131087971?text=' + encodeURIComponent(text);

