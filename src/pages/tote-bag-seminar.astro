---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tote Bag Seminar Custom', url: '/tote-bag-seminar/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/tote-bag-seminar/#webpage",
      "url": "https://totebag.web.id/tote-bag-seminar/",
      "name": "Tote Bag Seminar Custom untuk Berbagai Acara | ToteBag",
      "description": "Pilihan bahan, ukuran, desain, dan cara memesan tote bag seminar custom untuk berbagai kebutuhan acara.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/tote-bag-seminar/#breadcrumb"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://totebag.web.id/#website",
      "url": "https://totebag.web.id/",
      "name": "ToteBag",
      "inLanguage": "id-ID"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/tote-bag-seminar/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tote Bag Seminar Custom",
          "item": "https://totebag.web.id/tote-bag-seminar/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/tote-bag-seminar/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa bahan tote bag terbaik untuk seminar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bahan terbaik bergantung pada jenis acara dan isi tas. Canvas cocok untuk penggunaan berulang dan kesan premium, blacu untuk tampilan natural, spunbond untuk kebutuhan distribusi ringan dalam jumlah besar, dan drill untuk tampilan yang lebih rapi."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa ukuran tote bag seminar yang ideal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk dokumen A4, pilih ukuran tas yang memberikan ruang tambahan di luar dimensi kertas 21 × 29,7 cm. Ukuran contoh 30 × 35 cm atau 35 × 40 cm dapat dipertimbangkan, dengan gusset jika membawa tumbler atau beberapa barang tebal. Ukur seluruh isi terlebih dahulu."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah tote bag seminar bisa diberi logo acara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tote bag seminar dapat direncanakan dengan logo perusahaan atau acara menggunakan sablon, DTF, atau bordir sesuai material, desain, ukuran cetak, dan hasil konfirmasi vendor."
          }
        },
        {
          "@type": "Question",
          "name": "Apa isi paket seminar kit dengan tote bag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paket seminar kit dapat berisi tote bag custom, notebook atau blocknote, pulpen, lanyard dan ID card, serta tumbler. Isi dipilih berdasarkan kebutuhan peserta, jenis acara, dan anggaran."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa harga tote bag seminar custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Harga ditentukan oleh jenis bahan, ukuran, jumlah pesanan, desain cetak, aksesori, dan jadwal pengerjaan. Mintalah penawaran tertulis berdasarkan spesifikasi yang sama agar pilihan vendor dapat dibandingkan."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana memesan tote bag seminar sebelum tanggal acara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Siapkan jumlah peserta, spesifikasi bahan dan ukuran, file logo, lokasi pengiriman, serta tanggal acara. Kirim brief ke vendor, tinjau penawaran dan mockup, lalu konfirmasi sampel jika diperlukan sebelum persetujuan produksi."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Tote Bag Seminar Custom untuk Berbagai Acara | ToteBag"
  description="Pesan tote bag seminar custom untuk kantor, kampus, workshop, dan instansi. Bandingkan bahan, ukuran, desain logo, dan paket seminar kit. Konsultasi sekarang."
  canonicalUrl="https://totebag.web.id/tote-bag-seminar/"
  ogImage="https://totebag.web.id/media/tote-bag-seminar-kit-canvas.webp"
  jsonLd={schemaJson}
>
  <!-- Topbar Context Bar -->
  <aside class="seminar-topbar py-2 text-center text-white small" aria-label="Informasi layanan">
    <div class="container">
      Kebutuhan seminar, workshop, kampus &amp; pengadaan perusahaan • Konsultasi spesifikasi melalui WhatsApp
    </div>
  </aside>

  <!-- Breadcrumbs & Quick Anchor Navigation -->
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
    <nav class="quick-nav d-none d-md-flex flex-wrap gap-2 pt-2 pb-1" aria-label="Navigasi cepat halaman">
      <span class="small fw-semibold text-muted align-self-center me-1">Lompat ke:</span>
      <a href="#bahan" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Pilihan Bahan</a>
      <a href="#acara" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Jenis Acara</a>
      <a href="#ukuran" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Ukuran &amp; Kapasitas</a>
      <a href="#branding" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Desain Logo</a>
      <a href="#paket" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Paket Seminar Kit</a>
      <a href="#biaya" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Cost per Use</a>
      <a href="#proses" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Alur Order</a>
      <a href="#faq" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">FAQ</a>
      <a href="#penawaran" class="badge badge-cta text-decoration-none px-3 py-2 rounded-pill">Minta Penawaran ↗</a>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="section-space-sm pt-3 pb-5 hero-seminar" id="konten">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">Solusi tas seminar &amp; event B2B</span>
          </div>
          <h1 class="hero-title mb-3" style="font-size: clamp(2.2rem, 3.8vw, 3.2rem);">
            Tote Bag Seminar Custom untuk Berbagai Acara
          </h1>
          <p class="lead text-muted fs-5 mb-4" style="line-height: 1.75;">
            Tote bag seminar custom adalah tas acara yang dibuat sesuai kebutuhan peserta dan identitas penyelenggara. Pilih bahan, ukuran, warna, serta penempatan logo berdasarkan isi seminar kit, jumlah peserta, dan jenis acara—mulai dari workshop kampus hingga konferensi perusahaan.
          </p>
          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="#penawaran" class="btn btn-brand btn-lg">
              Konsultasi &amp; Minta Penawaran
            </a>
            <a href="#bahan" class="btn btn-brand-outline btn-lg">
              Bandingkan Bahan
            </a>
          </div>
          <p class="small text-muted mb-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-check text-success me-1 align-text-bottom" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.464 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
              <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
            </svg>
            Pemesanan berdasarkan brief • Mockup dan spesifikasi dikonfirmasi • Berbasis Malang
          </p>
        </div>
        <div class="col-12 col-lg-5">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
            <img 
              src="/media/tote-bag-seminar-kit-canvas.webp" 
              alt="Tote bag seminar kit custom bahan canvas lengkap dengan tumbler dan notes" 
              width="724" 
              height="543" 
              class="w-100 h-100 object-fit-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Benefit Cards / KPIs -->
  <section class="py-2 py-md-3 mb-4" aria-label="Ringkasan kebutuhan">
    <div class="container">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
        <div class="col">
          <div class="card h-100 p-3 p-md-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-dark border align-self-start mb-2">Fleksibilitas</span>
            <strong class="text-dark fs-6 d-block mb-1">Untuk berbagai acara</strong>
            <span class="text-muted small">Seminar, workshop, rapat, pelatihan &amp; expo</span>
          </div>
        </div>
        <div class="col">
          <div class="card h-100 p-3 p-md-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-dark border align-self-start mb-2">Varian Kain</span>
            <strong class="text-dark fs-6 d-block mb-1">Material fleksibel</strong>
            <span class="text-muted small">Blacu, spunbond, canvas, drill dan lainnya</span>
          </div>
        </div>
        <div class="col">
          <div class="card h-100 p-3 p-md-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-dark border align-self-start mb-2">Aplikasi Logo</span>
            <strong class="text-dark fs-6 d-block mb-1">Branding custom</strong>
            <span class="text-muted small">Logo, warna, teks acara &amp; aksesori</span>
          </div>
        </div>
        <div class="col">
          <div class="card h-100 p-3 p-md-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-dark border align-self-start mb-2">Transparan</span>
            <strong class="text-dark fs-6 d-block mb-1">Alur pengadaan jelas</strong>
            <span class="text-muted small">Brief, penawaran, approval, QC &amp; pengiriman</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 05: Mengapa tote bag seminar penting bagi pengalaman peserta? + TOC -->
  <section class="section-space pt-4 pb-5">
    <div class="container">
      <div class="max-w-75 mb-4">
        <span class="badge-accent mb-2">Panduan pemilihan</span>
        <h2 class="section-title mb-3">Mengapa tote bag seminar penting bagi pengalaman peserta?</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          Tas seminar bukan hanya wadah dokumen. Tas yang nyaman dibawa membantu peserta menyimpan modul dan perlengkapan sepanjang acara; identitas visual pada tas juga dapat memperpanjang paparan merek ketika tas digunakan kembali. Manfaat tersebut bergantung pada desain, kualitas material, serta kebiasaan penggunaan penerima—bukan jaminan hasil branding.
        </p>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-brand align-self-start mb-3 fw-bold">01 / Fungsional</span>
            <h3 class="h5 fw-bold mb-2">Perlengkapan lebih tertata</h3>
            <p class="text-muted small mb-0">
              Gabungkan stopmap, modul, alat tulis, lanyard, dan tumbler dalam satu tas yang ukurannya sesuai.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-brand align-self-start mb-3 fw-bold">02 / Branding</span>
            <h3 class="h5 fw-bold mb-2">Identitas acara terlihat</h3>
            <p class="text-muted small mb-0">
              Tempatkan logo dan nama acara secara proporsional agar tetap mudah dibaca tanpa memenuhi seluruh permukaan tas.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="badge bg-light text-brand align-self-start mb-3 fw-bold">03 / Pengalaman</span>
            <h3 class="h5 fw-bold mb-2">Layak digunakan kembali</h3>
            <p class="text-muted small mb-0">
              Pilih ketahanan, bentuk, dan model tali sesuai muatan serta konteks peserta agar tas berpotensi dipakai setelah seminar.
            </p>
          </div>
        </div>
      </div>

      <!-- Table of Contents -->
      <nav class="p-4 rounded-4 bg-surface-alt border" aria-label="Daftar isi panduan">
        <h3 class="h6 fw-bold text-dark mb-3">Jelajahi panduan ini</h3>
        <div class="row row-cols-1 row-cols-md-2 g-2">
          <div class="col">
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <li><a href="#bahan" class="text-brand text-decoration-none fw-semibold">→ Perbandingan bahan</a></li>
              <li><a href="#acara" class="text-brand text-decoration-none fw-semibold">→ Rekomendasi berdasarkan acara</a></li>
              <li><a href="#ukuran" class="text-brand text-decoration-none fw-semibold">→ Ukuran &amp; kapasitas</a></li>
              <li><a href="#branding" class="text-brand text-decoration-none fw-semibold">→ Desain &amp; branding</a></li>
            </ul>
          </div>
          <div class="col">
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <li><a href="#paket" class="text-brand text-decoration-none fw-semibold">→ Kombinasi seminar kit</a></li>
              <li><a href="#biaya" class="text-brand text-decoration-none fw-semibold">→ Cost per use &amp; anggaran</a></li>
              <li><a href="#proses" class="text-brand text-decoration-none fw-semibold">→ Alur pesan B2B</a></li>
              <li><a href="#faq" class="text-brand text-decoration-none fw-semibold">→ Pertanyaan umum (FAQ)</a></li>
            </ul>
          </div>
        </div>
      </nav>
    </div>
  </section>

  <!-- Section 06: #bahan — Pilihan bahan tote bag seminar custom -->
  <section id="bahan" class="section-space bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mb-4">
        <span class="badge-accent mb-2">Material &amp; fungsi</span>
        <h2 class="section-title mb-3">Pilihan bahan tote bag seminar custom</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          <strong>Bahan terbaik tidak selalu yang paling tebal.</strong> Untuk seminar massal dengan isi ringan, spunbond dapat memadai; untuk paket yang dipakai berulang, canvas atau drill dapat lebih cocok. Bandingkan karakteristiknya sebelum menetapkan bahan.
        </p>
      </div>

      <div class="table-responsive rounded-4 border bg-white shadow-sm mb-3">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="min-width: 150px;">Bahan</th>
              <th scope="col" style="min-width: 220px;">Karakter</th>
              <th scope="col" style="min-width: 220px;">Cocok untuk</th>
              <th scope="col" style="min-width: 240px;">Pertimbangan</th>
            </tr>
          </thead>
          <tbody class="small">
            <tr>
              <th scope="row" class="fw-bold text-dark">Canvas / kanvas</th>
              <td>Tenunan relatif kokoh, tampilan berstruktur</td>
              <td>Konferensi, corporate gathering, seminar eksekutif</td>
              <td>Gramasi, penguatan tali, jahitan, dan kebutuhan lapisan</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Blacu</th>
              <td>Nuansa natural, ringan, tekstur kasual</td>
              <td>Seminar kampus, workshop kreatif, acara komunitas</td>
              <td>Ketebalan, transparansi kain dan kualitas jahitan</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Spunbond</th>
              <td>Non-woven, ringan, efisien untuk distribusi sederhana</td>
              <td>Expo, sosialisasi, acara peserta besar</td>
              <td>Ketebalan kain dan batas muatan; jangan diasumsikan cocok untuk beban berat</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Drill</th>
              <td>Tenunan serat diagonal dengan kesan rapi</td>
              <td>Diklat, bimtek, pelatihan kedinasan</td>
              <td>Jenis drill, lining, resleting, dan finishing</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Polyester / D300–D600</th>
              <td>Tampilan teknis, pilihan ketahanan terhadap percikan bervariasi</td>
              <td>Event lapangan, workshop mobilitas tinggi</td>
              <td>Lapisan dan daya tahan air harus diperiksa per spesifikasi</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Denim / PU / PVC</th>
              <td>Alternatif visual spesifik, dari kasual hingga formal</td>
              <td>Event kreatif, souvenir tamu khusus, aktivitas tematik</td>
              <td>Bobot, kenyamanan, perawatan dan kecocokan desain</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="small text-muted mb-4 fst-italic">
        Catatan: kemampuan membawa beban dipengaruhi desain, jahitan, ukuran, jenis tali, dan kualitas produksi. Angka kapasitas tidak dapat dijamin hanya dari nama kain.
      </p>

      <!-- CTA Box Bahan -->
      <div class="p-4 rounded-4 bg-white border shadow-sm d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <h3 class="h5 fw-bold text-dark mb-1">Sudah menentukan pilihan material?</h3>
          <p class="text-muted small mb-0">Pelajari detail masing-masing jenis kain sebelum meminta penawaran.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/produk/tote-bag-canvas/" class="btn btn-outline-success btn-sm">Detail canvas</a>
          <a href="/produk/tote-bag-blacu/" class="btn btn-outline-success btn-sm">Detail blacu</a>
          <a href="/produk/tote-bag-spunbond/" class="btn btn-outline-success btn-sm">Detail spunbond</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 07: #acara — Rekomendasi tote bag untuk setiap jenis acara -->
  <section id="acara" class="section-space">
    <div class="container">
      <div class="max-w-75 mb-5">
        <span class="badge-accent mb-2">Pilih berdasarkan kebutuhan</span>
        <h2 class="section-title mb-3">Rekomendasi tote bag untuk setiap jenis acara</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          Tentukan material dan model dari karakter peserta serta barang yang dibawa, bukan sekadar tren visual. Berikut skenario pemilihan untuk memudahkan brief awal.
        </p>
      </div>

      <div class="row g-4">
        <!-- 1. Kampus -->
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <span class="badge bg-light text-dark border align-self-start mb-2 small">Seminar kampus</span>
            <h3 class="h5 fw-bold mb-2">Blacu untuk tampilan natural</h3>
            <p class="text-muted small flex-grow-1">
              Cocok ketika peserta membawa modul, notes, pulpen, serta materi ringan. Pilih warna natural dan logo acara yang jelas.
            </p>
            <a href="#penawaran" class="fw-bold text-brand small text-decoration-none mt-2">Diskusikan tas kampus →</a>
          </article>
        </div>

        <!-- 2. Perusahaan -->
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <span class="badge bg-light text-dark border align-self-start mb-2 small">Konferensi perusahaan</span>
            <h3 class="h5 fw-bold mb-2">Canvas untuk kesan profesional</h3>
            <p class="text-muted small flex-grow-1">
              Pertimbangkan bahan lebih berstruktur, saku, dan alas tambahan jika memuat beberapa perlengkapan atau barang tebal.
            </p>
            <a href="#penawaran" class="fw-bold text-brand small text-decoration-none mt-2">Diskusikan tas corporate →</a>
          </article>
        </div>

        <!-- 3. Diklat -->
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <span class="badge bg-light text-dark border align-self-start mb-2 small">Diklat &amp; bimtek</span>
            <h3 class="h5 fw-bold mb-2">Drill untuk kebutuhan rapi</h3>
            <p class="text-muted small flex-grow-1">
              Model berpenutup atau beresleting dapat dipertimbangkan saat membawa dokumen penting selama beberapa sesi.
