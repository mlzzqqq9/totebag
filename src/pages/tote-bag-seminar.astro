---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { seminarFaqs, getWhatsAppUrl } from '@/data/siteData';

const naskah = getNaskahById('43');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan & Solusi', url: '/layanan/' },
  { name: 'Tote Bag Seminar', url: '/tote-bag-seminar/' }
];

const seminarWaUrl = getWhatsAppUrl({
  notes: "Konsultasi pengadaan tas seminar / workshop event",
  sourcePage: "/tote-bag-seminar/"
});
---

<BaseLayout
  title={naskah?.seoTitle || "Tote Bag Seminar Custom untuk Berbagai Acara | Tote Bag"}
  description={naskah?.metaDescription || "Solusi tote bag seminar custom untuk konferensi akademik, workshop dinas, dan expo. Bahan blacu dan spunbond efisien, muat dokumen A4 dan tumbler."}
  canonicalUrl={naskah?.canonical || "https://totebag.web.id/tote-bag-seminar/"}
  jsonLd={naskah?.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">SOLUSI SEMINAR &amp; WORKSHOP</span>
          </div>
          <h1 class="hero-title mb-3" style="font-size: clamp(2rem, 3.4vw, 2.7rem);">
            {naskah?.h1 || "Tote Bag Seminar Custom untuk Berbagai Acara"}
          </h1>
          <p class="lead text-muted fs-5 mb-4">
            Dirancang proporsional untuk memuat stopmap folio A4, sertifikat, modul materi, dan botol minum peserta. Waktu produksi terukur agar pesanan tiba sebelum tanggal pelaksanaan acara.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href={seminarWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-lg">
              Minta Penawaran Tas Seminar
            </a>
            <a href="/cara-pesan/" class="btn btn-brand-outline btn-lg">
              Jadwal &amp; Alur Pemesanan
            </a>
          </div>
        </div>
        <div class="col-12 col-lg-5">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
            <img 
              src="/media/portfolio-seminar-malang.svg" 
              alt="Tote bag seminar blacu untuk konferensi akademik" 
              width="600" 
              height="450" 
              class="w-100 h-100 object-fit-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Direct Answer & Core Insights from Naskah 43 -->
  {naskah?.directAnswer && (
    <section class="py-3">
      <div class="container">
        <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success shadow-sm">
          <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
            <span class="badge bg-success text-white">Ringkasan Seminar Kit</span>
            <span class="fs-6">Prinsip Menentukan Tas Acara:</span>
          </div>
          <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
            {naskah.directAnswer}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- 3 Opsi Bahan Tas Seminar -->
  <section class="section-space bg-surface-alt mt-4">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">REKOMENDASI MODEL SEMINAR</span>
        <h2 class="section-title mb-3">Pilihan Bahan Sesuai Anggaran &amp; Kapasitas</h2>
        <p class="section-subtitle mx-auto">
          Setiap acara memiliki karakteristik muatan berbeda. Kami bantu sesuaikan ukuran tas dengan isi seminar kit Anda.
        </p>
      </div>

      <div class="row g-4">
        <!-- Opsi 1 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">KAMPUS &amp; DINAS</div>
            <h3 class="h5 fw-bold mb-2">Blacu Super Grade A</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Bahan primadona seminar nasional: ramah lingkungan, warna broken white alami, dan harga sangat ekonomis untuk pesanan 100–500 pcs.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Kapasitas:</strong> Muat stopmap polio, buku catatan, tumbler, bolpoin, dan ID card.
            </div>
            <a href="/produk/tote-bag-blacu/" class="btn btn-outline-success btn-sm w-100">
              Lihat Detail Blacu
            </a>
          </div>
        </div>

        <!-- Opsi 2 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">EXPO &amp; JALAN SEHAT</div>
            <h3 class="h5 fw-bold mb-2">Spunbond Press &amp; Jahit</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Opsi paling hemat untuk pameran expo, wisuda, atau jalan sehat dengan peserta ribuan. Ringan, tahan cipratan air, dan tersedia 20+ pilihan warna kain.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Kapasitas:</strong> Muat flyer promosi, snack box, air mineral, dan souvenir ringan.
            </div>
            <a href="/produk/tote-bag-spunbond/" class="btn btn-outline-success btn-sm w-100">
              Lihat Detail Spunbond
            </a>
          </div>
        </div>

        <!-- Opsi 3 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">KONFERENSI NASIONAL</div>
            <h3 class="h5 fw-bold mb-2">Canvas Twill Semi-Formal</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Untuk simposium medis, kongres profesi, atau rapat kerja direksi. Tampilan sangat kokoh, dapat ditambahkan kantong saku luar atau resleting atas.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Kapasitas:</strong> Muat laptop hingga 14 inch, binder tebal, dan perangkat elektronik.
            </div>
            <a href="/produk/tote-bag-canvas/" class="btn btn-outline-success btn-sm w-100">
              Lihat Detail Canvas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Section from Naskah 43 -->
  {naskah?.bodyHtml && (
    <section class="section-space-sm pt-0">
      <div class="container">
        <div class="p-4 rounded-4 bg-light border">
          <h2 class="h5 fw-bold text-dark mb-3">Panduan Persiapan Tote Bag Seminar</h2>
          <div class="article-content-body text-muted small" style="line-height: 1.8;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mx-auto mb-4 text-center">
        <h2 class="section-title mb-2">FAQ Tote Bag Seminar</h2>
        <p class="section-subtitle mx-auto">Pertanyaan seputar deadline kilat, toleransi ukuran dokumen, dan sampel sebelum produksi massal.</p>
      </div>
      <div class="max-w-75 mx-auto">
        <FAQAccordion items={seminarFaqs} accordionId="seminarPageFaq" />
      </div>
    </div>
  </section>
</BaseLayout>
