  <!-- Script Penanganan Form RFQ ke WhatsApp (Zero Emojis, Zero Em-Dashes) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('blacuRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelB')?.value || 'BLA-01';
        const qty = document.getElementById('rfqQtyB')?.value || '100 pcs';
        const print = document.getElementById('rfqPrintB')?.value || 'Sablon Rubber';
        const deadline = document.getElementById('rfqDeadlineB')?.value || 'Segera';
        const city = document.getElementById('rfqCityB')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Blacu Custom:

*Model Blacu:* ${model}
*Estimasi Kuantiti:* ${qty}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
