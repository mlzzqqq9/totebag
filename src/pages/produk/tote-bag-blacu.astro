---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Tote Bag Blacu Custom', url: '/produk/tote-bag-blacu/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/produk/tote-bag-blacu/#webpage",
      "url": "https://totebag.web.id/produk/tote-bag-blacu/",
      "name": "Tote Bag Blacu Custom Seminar & Event: Katalog Model & Harga Pabrik | ToteBag",
      "description": "Katalog tote bag blacu custom langsung dari konveksi workshop Malang. Pilihan bahan blacu super grade A, jahitan kuat, sablon manual atau DTF, harga mulai Rp 12.000, MOQ 50 pcs.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/produk/tote-bag-blacu/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/produk/tote-bag-blacu/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Produk",
          "item": "https://totebag.web.id/produk/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tote Bag Blacu Custom",
          "item": "https://totebag.web.id/produk/tote-bag-blacu/"
        }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://totebag.web.id/produk/tote-bag-blacu/#product",
      "name": "Tote Bag Blacu Custom Seminar & Event",
      "image": "https://totebag.web.id/media/tote-bag-blacu-polos.webp",
      "description": "Konveksi tote bag blacu super grade A untuk seminar kampus, workshop pelatihan, dan souvenir ramah lingkungan. Jahitan rapi dan sablon awet.",
      "brand": {
        "@type": "Brand",
        "name": "ToteBag"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": 8500,
        "highPrice": 18500,
        "offerCount": 4,
        "priceValidUntil": "2027-12-31",
        "validFrom": "2025-01-01",
        "availability": "https://schema.org/InStock",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "IDR" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "ID" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 3,
              "maxValue": 7,
              "unitCode": "d"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 4,
              "unitCode": "d"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "ID",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 7,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "52"
      },
      "review": {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Budi Santoso" },
        "reviewBody": "Tas blacu untuk seminar nasional kampus kami sangat rapi jahitannya, sablon presisi dan selesai tepat waktu."
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/produk/tote-bag-blacu/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa keunggulan kain blacu dibandingkan bahan spunbond?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kain blacu terbuat dari serat kapas alami tenun bertekstur rapat, sehingga jauh lebih kuat, tidak mudah robek, dan dapat dicuci berulang kali. Berbeda dengan spunbond yang terbuat dari polypropylene plastik sintetis tipis."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal order (MOQ) tote bag blacu custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimal order standar adalah 50 pcs per desain untuk efisiensi biaya pembuatan plat sablon. Untuk kuantiti 100, 300, hingga 1.000+ pcs, harga satuan akan jauh lebih hemat."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah sablon pada kain blacu mudah luntur saat dicuci?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak. Kami menggunakan pasta sablon rubber berkualitas tinggi dan finishing curing pemanas. Tinta mengikat serat kapas alami secara permanen dan tahan dicuci berulang kali."
          }
        }
      ]
    }
  ]
};

const blacuModels = [
  {
    id: 'bla-01',
    code: 'BLA-01',
    slug: 'tote-bag-blacu-standard-seminar',
    name: 'Flat Classic Blacu Super (30 x 40 cm)',
    category: 'Seminar Kampus & Event',
    badge: 'Paling Populer',
    badgeClass: 'bg-success text-white',
    price: 'Rp 12.000',
    priceRange: 'Rp 8.500 - Rp 12.000',
    moq: '50 pcs',
    image: '/media/tote-bag-blacu-polos.webp',
    material: 'Blacu Super Grade A (Tenunan Rapat)',
    dimensions: '30 x 40 cm (Flat vertikal muat map A4)',
    target: 'Seminar nasional, ospek mahasiswa, dies natalis, pelatihan guru, dan souvenir buku.',
    features: [
      'Bahan Blacu Super Grade A warna broken white alami',
      'Muat dokumen A4, stopmap folio, dan notebook',
      'Tali jinjing webbing katun senada 3 cm (panjang 60 cm)',
      'Sablon manual rubber 1-2 warna presisi',
      'Kapasitas beban aman hingga 4-5 kg'
    ],
    waMessage: 'Halo ToteBag, saya tertarik memesan Model BLA-01 (Flat Classic Blacu Super 30x40 cm).'
  },
  {
    id: 'bla-02',
    code: 'BLA-02',
    slug: 'tote-bag-blacu-super-broken-white',
    name: 'Blacu Gusset Alas Bawah (35 x 40 x 8 cm)',
    category: 'Workshop & Paket Seminar Kit',
    badge: 'Daya Muat Lega',
    badgeClass: 'bg-primary text-white',
    price: 'Rp 15.500',
    priceRange: 'Rp 11.500 - Rp 15.500',
    moq: '50 pcs',
    image: '/media/portfolio-blacu-350pcs.webp',
    material: 'Blacu Super Greige Tebal',
    dimensions: '35 x 40 x 8 cm (Bottom Gusset)',
    target: 'Workshop perusahaan, bimtek kedinasan, seminar kit lengkap dengan tumbler dan snack box.',
    features: [
      'Alas bawah 8 cm memberi ruang ekstra tanpa sesak',
      'Muat tumbler minum tegak, binder tebal, dan box makan',
      'Tali webbing katun tebal dengan jahitan silang penguat',
      'Opsi penutup perekat velcro atau kancing jepret',
      'Kapasitas beban uji hingga 7 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran untuk Model BLA-02 (Blacu Gusset Alas Bawah 35x40x8 cm).'
  },
  {
    id: 'bla-03',
    code: 'BLA-03',
    slug: 'tote-bag-blacu-gusset-box',
    name: 'Blacu Kombinasi Saku Depan Fungsional',
    category: 'Merchandise Butik & Komunitas',
    badge: 'Praktis & Trendi',
    badgeClass: 'bg-secondary text-white',
    price: 'Rp 17.000',
    priceRange: 'Rp 13.000 - Rp 17.000',
    moq: '50 pcs',
    image: '/media/foto-blacu.jpg',
    material: 'Blacu Super Grade A + Saku Depan',
    dimensions: '32 x 38 x 8 cm',
    target: 'Goodybag butik fashion, merchandise kafe, souvenir gathering alumni, event pameran seni.',
    features: [
      'Saku tempel di bagian luar untuk pulpen, HP, dan kartu nama',
      'Desain modern dengan sentuhan estetika minimalis',
      'Kombinasi sablon logo di badan tas dan saku depan',
      'Jahitan tepi obras ganda rapi tidak berserabut',
      'Mudah dilipat dan ringan dibawa bepergian'
    ],
    waMessage: 'Halo ToteBag, saya ingin konsultasi Model BLA-03 (Blacu Kombinasi Saku Depan).'
  },
  {
    id: 'bla-04',
    code: 'BLA-04',
    slug: 'tote-bag-blacu-kombinasi-saku',
    name: 'Blacu Resleting YKK & Kancing Magnet',
    category: 'Corporate Merchandise & Ritel',
    badge: 'Keamanan Ekstra',
    badgeClass: 'bg-dark text-white',
    price: 'Rp 18.500',
    priceRange: 'Rp 14.500 - Rp 18.500',
    moq: '50 pcs',
    image: '/media/tote-bag-blacu-sablon.webp',
    material: 'Blacu Super Rapat + Resleting YKK',
    dimensions: '35 x 40 cm',
    target: 'Souvenir kantor, merchandise organisasi, tas belanja harian dengan keamanan isi tas.',
    features: [
      'Resleting YKK anti-macet menjaga berkas aman dari tumpahan',
      'Opsi kancing magnet neodinium rapi di bagian dalam',
      'Jahitan double-stitch di seluruh sambungan beban tali',
      'Pilihan cetak sablon rubber atau DTF full color',
      'Daya tahan pakai hingga puluhan kali pemakaian'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran Model BLA-04 (Blacu Resleting YKK).'
