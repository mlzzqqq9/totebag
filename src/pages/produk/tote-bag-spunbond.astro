const spunbondModels = [
  {
    id: 'spn-01',
    code: 'SPN-01',
    slug: 'goodie-bag-spunbond-oval-dcut',
    name: 'Flat Spunbond Press 75 GSM (25 x 35 cm)',
    category: 'Promosi Massal & Brosur',
    badge: 'Super Hemat',
    badgeClass: 'bg-success text-white',
    price: 'Rp 4.500',
    priceRange: 'Rp 2.900 - Rp 4.500',
    moq: '100 pcs',
    image: '/media/tote-bag-spunbond-color.webp',
    material: 'Polypropylene Non-Woven 75 GSM (Metode Press Ultrasonic)',
    dimensions: '25 x 35 cm (Flat)',
    target: 'Goodie bag pameran, pembagian brosur expo, launching produk baru, seminar singkat.',
    features: [
      'Proses press mesin ultrasonic rapi dan presisi',
      'Ringan dan mudah didistribusikan dalam jumlah ribuan pcs',
      'Tersedia puluhan pilihan warna kain solid cerah',
      'Sablon 1-2 warna kontras tajam',
      'Kapasitas beban aman hingga 2-3 kg'
    ],
    waMessage: 'Halo ToteBag, saya tertarik order Model SPN-01 (Flat Spunbond Press 75 GSM).'
  },
  {
    id: 'spn-02',
    code: 'SPN-02',
    slug: 'tote-bag-spunbond-press-event',
    name: 'Spunbond Jahit Box Gusset 75 GSM (30 x 40 x 10 cm)',
    category: 'Expo Dagang & Goodie Bag',
    badge: 'Best Seller Event',
    badgeClass: 'bg-primary text-white',
    price: 'Rp 6.500',
    priceRange: 'Rp 4.500 - Rp 6.500',
    moq: '100 pcs',
    image: '/media/foto-spunbond.jpg',
    material: 'Spunbond 75 GSM dengan Metode Jahit Konveksi',
    dimensions: '30 x 40 x 10 cm (Bottom & Side Gusset)',
    target: 'Tas pameran instansi, bursa kerja jobfair, seminar kampus, dan paket goodie bag merchandise.',
    features: [
      'Alas dan samping 10 cm muat map dokumen, botol minum, dan buku agenda',
      'Metode jahit jarum mesin konveksi lebih kuat dibanding press biasa',
      'Tali jinjing webbing spunbond ganda nyaman di tangan',
      'Sablon logo luas di panel depan dan belakang',
      'Kapasitas beban aman hingga 4-5 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran untuk Model SPN-02 (Spunbond Jahit Box Gusset 75 GSM).'
  },
  {
    id: 'spn-03',
    code: 'SPN-03',
    slug: 'tote-bag-spunbond-box-lipat-samping',
    name: 'Spunbond Jahit Heavy 100 GSM (35 x 40 x 10 cm)',
    category: 'Paket Sembako & Souvenir Berat',
    badge: 'Ekstra Tebal & Kuat',
    badgeClass: 'bg-dark text-white',
    price: 'Rp 8.500',
    priceRange: 'Rp 6.200 - Rp 8.500',
    moq: '100 pcs',
    image: '/media/tote-bag-spunbond-color.webp',
    material: 'Spunbond Heavy 100 GSM (Tebal & Kaku)',
    dimensions: '35 x 40 x 10 cm (Boxy Stand-up)',
    target: 'Baksos sembako korporat, hampers lebaran/natal instansi, katering box, souvenir gathering.',
    features: [
      'Ketebalan 100 gsm tidak menerawang dan kaku mandiri',
      'Jahitan keliling ganda sanggup menahan minyak, beras, dan box berat',
      'Tali jinjing diperkuat jahitan silang di sambungan bibir tas',
      'Pilihan warna solid elegan (hitam, navy, maroon, hijau botol)',
      'Kapasitas beban uji hingga 7-8 kg'
    ],
    waMessage: 'Halo ToteBag, saya ingin konsultasi Model SPN-03 (Spunbond Jahit Heavy 100 GSM).'
  },
  {
    id: 'spn-04',
    code: 'SPN-04',
    slug: 'tote-bag-spunbond-jahit-box-100gsm',
    name: 'Spunbond Serut Drawstring Ransel (30 x 40 cm)',
    category: 'Olahraga & Event Komunitas',
    badge: 'Praktis Ransel',
    badgeClass: 'bg-secondary text-white',
    price: 'Rp 7.500',
    priceRange: 'Rp 5.200 - Rp 7.500',
    moq: '100 pcs',
    image: '/media/foto-spunbond.jpg',
    material: 'Spunbond 75 GSM + Tali Kur Tebal',
    dimensions: '30 x 40 cm (Model Serut Gendong)',
