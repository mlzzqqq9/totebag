  <!-- Script Penanganan Form RFQ ke WhatsApp (Zero Emojis, Zero Em-Dashes) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('spunbondRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelS')?.value || 'SPN-02';
        const qty = document.getElementById('rfqQtyS')?.value || '500 pcs';
        const print = document.getElementById('rfqPrintS')?.value || 'Sablon 1 Warna';
        const deadline = document.getElementById('rfqDeadlineS')?.value || 'Segera';
        const city = document.getElementById('rfqCityS')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Spunbond Custom:

*Model Spunbond:* ${model}
*Estimasi Kuantiti:* ${qty}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
