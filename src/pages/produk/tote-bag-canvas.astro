  <!-- Script Penanganan Form RFQ ke WhatsApp (Zero Emojis, Zero Em-Dashes) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('canvasRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModel')?.value || 'CAN-02';
        const qty = document.getElementById('rfqQty')?.value || '100 pcs';
        const closure = document.getElementById('rfqClosure')?.value || 'Magnet';
        const print = document.getElementById('rfqPrint')?.value || 'Sablon Rubber';
        const deadline = document.getElementById('rfqDeadline')?.value || 'Segera';
        const city = document.getElementById('rfqCity')?.value || 'Malang';
        const note = document.getElementById('rfqNote')?.value || '-';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Canvas Custom:

*Model Canvas:* ${model}
*Estimasi Kuantiti:* ${qty}
*Pilihan Penutup:* ${closure}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}
*Catatan Tambahan:* ${note}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
