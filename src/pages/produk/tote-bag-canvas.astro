---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Tote Bag Canvas Custom', url: '/produk/tote-bag-canvas/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/produk/tote-bag-canvas/#webpage",
      "url": "https://totebag.web.id/produk/tote-bag-canvas/",
      "name": "Tote Bag Canvas Custom: Katalog Model, Spesifikasi & Harga Pabrik | ToteBag",
      "description": "Katalog lengkap tote bag canvas custom untuk perusahaan, seminar, dan merchandise. Pilihan bobot kain 10-14 oz, jahitan kuat, harga transparan mulai Rp 40.000, MOQ 50 pcs.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/produk/tote-bag-canvas/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/produk/tote-bag-canvas/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Produk",
          "item": "https://totebag.web.id/produk/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tote Bag Canvas Custom",
          "item": "https://totebag.web.id/produk/tote-bag-canvas/"
        }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://totebag.web.id/produk/tote-bag-canvas/#product",
      "name": "Tote Bag Canvas Custom B2B & Event",
      "image": "https://totebag.web.id/media/tote-bag-canvas-twill.webp",
      "description": "Konveksi tote bag canvas heavy-duty 10-14 oz untuk merchandise korporat, onboarding kit, seminar, dan retail fashion. Pilihan resleting YKK, alas gusset, dan sablon eco-friendly.",
      "brand": {
        "@type": "Brand",
        "name": "ToteBag"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": 35000,
        "highPrice": 85000,
        "offerCount": 6,
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "IDR" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "ID" }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "ID",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 7,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "64"
      },
      "review": {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Dr. Retno Wulandari" },
        "reviewBody": "Kain canvas twill tebal dan jahitan sangat rapi, sangat pantas untuk event seminar dan onboarding kit perusahaan."
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/produk/tote-bag-canvas/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Berapa bobot kain (oz/GSM) terbaik untuk tote bag canvas laptop dan kerja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk membawa laptop dan berkas berat, gunakan kain canvas minimal 12 oz hingga 14 oz (350-420 GSM). Pada ketebalan ini, tas memiliki struktur mandiri (self-standing), tidak mudah roboh, dan mampu menahan beban 7-12 kg tanpa robek pada sambungan tali."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal pemesanan (MOQ) tote bag canvas custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimal pemesanan standar di ToteBag adalah 50 pcs per desain untuk efisiensi biaya cetak sablon. Untuk kuantiti 100, 300, hingga 1.000+ pcs, harga satuan akan jauh lebih hemat mengikuti skala produksi konveksi."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa kali tas tote kanvas harus dipakai agar ramah lingkungan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Berdasarkan studi siklus hidup lingkungan (LCA), sebuah tas tote kanvas katun perlu digunakan setidaknya 51 hingga 131 kali pemakaian untuk mengimbangi jejak karbon dari kantong plastik sekali pakai. Memilih kanvas berkualitas 12 oz+ yang tahan bertahun-tahun adalah kunci keberlanjutan yang nyata."
          }
        },
        {
          "@type": "Question",
          "name": "Bolehkah mencuci tas canvas menggunakan mesin cuci atau mesin pengering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sangat disarankan mencuci dengan tangan menggunakan air suam kuku dan detergen lembut. Jika terpaksa memakai mesin cuci, gunakan kantong jaring (mesh bag) dengan siklus lembut. Jangan gunakan mesin pengering (dryer) karena suhu panas tinggi akan menyusutkan kain katun hingga 10% dan membuat sablon retak."
          }
        },
        {
          "@type": "Question",
          "name": "Apa perbedaan canvas twill, canvas greige, dan canvas marsoto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Canvas greige adalah kain mentah unbleached berwarna broken white alami (10 oz). Canvas twill memiliki pola tenun diagonal halus dan padat (12 oz, sangat populer untuk corporate gift). Sedangkan canvas marsoto memiliki tekstur bintik rapat, sangat tebal dan kokoh (14 oz, grade militer/work bag)."
          }
        }
      ]
    }
  ]
};

