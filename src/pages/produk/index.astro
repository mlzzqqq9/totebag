---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import { categories, products, getWhatsAppUrl } from '@/data/siteData';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' }
];

const catalogWaUrl = getWhatsAppUrl({
  notes: "Inquiry dari halaman Katalog Semua Produk",
  sourcePage: "/produk/"
});

// CollectionPage JSON-LD schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Katalog Tote Bag Custom B2B",
  "description": "Daftar lengkap model tote bag custom berbahan canvas, blacu, spunbond, dan kulit sintetis untuk pengadaan perusahaan dan seminar.",
  "url": "https://totebag.web.id/produk/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.map((prod, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://totebag.web.id/produk/${prod.slug}/`,
      "name": prod.name
    }))
  }
};
---

<BaseLayout
  title="Katalog Tote Bag Custom B2B — Canvas, Blacu, Spunbond, Kulit"
  description="Jelajahi pilihan tote bag custom untuk merchandise kantor, seminar kit, dan goodie bag event. Spesifikasi teknis kain lengkap, opsi sablon/DTF, dan konsultasi penawaran."
  canonicalUrl="https://totebag.web.id/produk/"
  jsonLd={collectionSchema}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Header -->
  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-end g-4">
        <div class="col-12 col-lg-8">
          <span class="badge-accent mb-2">KATALOG LENGKAP</span>
          <h1 class="hero-title mb-3">Katalog Tote Bag Custom B2B</h1>
          <p class="lead text-muted fs-5 mb-0">
            Pilihan model tote bag yang dapat disesuaikan menurut dimensi, warna bahan, penambahan furing/zipper, serta teknik cetak logo acara Anda.
          </p>
        </div>
        <div class="col-12 col-lg-4 text-lg-end">
          <a href={catalogWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand">
            Minta Penawaran Kuantiti Khusus
          </a>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="d-flex flex-wrap gap-2 pt-4 mt-2 border-top">
        <a href="/produk/" class="btn btn-brand btn-sm">Semua Produk ({products.length})</a>
        {categories.map(cat => (
          <a href={`/produk/${cat.slug}/`} class="btn btn-brand-outline btn-sm">
            {cat.shortName}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <section class="section-space pt-4">
    <div class="container">
      <div class="row g-4">
        {products.map(prod => (
          <div class="col-12 col-sm-6 col-lg-4">
            <ProductCard product={prod} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Material Comparison Table -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">PANDUAN PERBANDINGAN</span>
        <h2 class="section-title mb-3">Tabel Perbandingan Karakteristik Bahan</h2>
        <p class="section-subtitle mx-auto">
          Gunakan panduan berikut untuk mencocokkan karakter bahan dengan jenis event dan alokasi anggaran Anda.
        </p>
      </div>

      <div class="table-responsive">
        <table class="table table-specs w-100">
          <thead>
            <tr>
              <th>Bahan</th>
              <th>Karakter Tekstur</th>
              <th>Daya Tahan Beban</th>
              <th>Metode Cetak Logo</th>
              <th>Kesesuaian Penggunaan</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="fw-bold text-dark">Canvas Twill (12 oz)</td>
              <td>Tebal, kaku, bertekstur tenun twill rapat, tidak menerawang</td>
              <td>Sangat Kuat (Hingga 8 - 10 kg)</td>
              <td>Sablon Rubber, Plastisol, DTF, Bordir</td>
              <td>Merchandise Kantor, Onboarding Kit, Gift Premium</td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Canvas Greige (10 oz)</td>
              <td>Alami unbleached, bintik serat katun organik, rustic modern</td>
              <td>Kuat (Hingga 6 - 8 kg)</td>
              <td>Sablon Waterbased, Rubber, DTF</td>
              <td>Event Seni, Komunitas, Kampanye Ramah Lingkungan</td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Blacu Super Grade A</td>
              <td>Halus, warna broken white/ivory, fleksibel dan ringan</td>
              <td>Sedang (Hingga 3 - 5 kg)</td>
              <td>Sablon Manual Rubber (1-3 Warna)</td>
              <td>Seminar Kit Kampus, Workshop, Souvenir Acara</td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Spunbond 75 - 100 gsm</td>
              <td>Non-woven sintetis, kedap percikan air, sangat ringan</td>
              <td>Ringan (Hingga 2 - 4 kg)</td>
              <td>Sablon Manual 1-2 Warna Tajam</td>
              <td>Expo Pameran Dagang, Goodie Bag Massal, Promosi Toko</td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Kulit Sintetis (PU)</td>
              <td>Mewah, elegan, semi-leather tahan gores, tahan air</td>
              <td>Kuat &amp; Berstruktur (Hingga 6 kg)</td>
              <td>Deboss Logo Tenggelam, Foil Emas/Perak</td>
              <td>Executive VIP Kit, Souvenir Direksi &amp; Tamu Kehormatan</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-4 p-4 rounded-4 bg-white border d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div>
          <div class="fw-bold text-dark mb-1">Butuh rekomendasi ukuran atau bahan untuk event Anda?</div>
          <p class="small text-muted mb-0">Tim kami dapat membantu menghitung kebutuhan bahan sesuai isi paket seminar kit Anda.</p>
        </div>
        <a href={catalogWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand flex-shrink-0">
          Konsultasi Gratis via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
