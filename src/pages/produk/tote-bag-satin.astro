  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('satinRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelS')?.value || 'SAT-01';
        const qty = document.getElementById('rfqQtyS')?.value || '50 pcs';
        const deadline = document.getElementById('rfqDeadlineS')?.value || 'Segera';
        const city = document.getElementById('rfqCityS')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Satin Full Print Sublimasi:

*Model Satin:* ${model}
*Estimasi Kuantiti:* ${qty}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
