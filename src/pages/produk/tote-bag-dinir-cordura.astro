---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { categories, products, corporateFaqs, getWhatsAppUrl } from '@/data/siteData';

const category = categories.find(c => c.slug === 'tote-bag-dinir-cordura') || categories[0];
const categoryProducts = products.filter(p => p.categorySlug === 'tote-bag-dinir-cordura');
const categoryFaqs = corporateFaqs;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: category.title, url: `/produk/${category.slug}/` }
];

const categoryWaUrl = getWhatsAppUrl({
  categoryName: category.title,
  sourcePage: `/produk/${category.slug}/`
});
---

<BaseLayout
  title={`${category.title} — Solusi Tangguh & Tahan Air`}
  description="Penyedia tote bag bahan dinir D300, D600, dan cordura nilon tahan air untuk kebutuhan safety campaign, tambang, outdoor, dan merchandise korporat kokoh."
  canonicalUrl={`https://totebag.web.id/produk/${category.slug}/`}
  categoryName={category.title}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <span class="badge-accent mb-2">KATEGORI MATERIAL</span>
          <h1 class="hero-title mb-3">{category.title}</h1>
          <p class="lead text-muted fs-5 mb-4">{category.tagline}</p>
          <p class="text-muted mb-4" style="line-height: 1.7;">{category.overview}</p>
          <div class="d-flex flex-wrap gap-3">
            <a href={categoryWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-lg">
              Konsultasi Dinir &amp; Cordura via WA
            </a>
            <a href="/harga-tote-bag-custom/" class="btn btn-brand-outline btn-lg">
              Hitung Estimasi Anggaran
            </a>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="rounded-4 overflow-hidden border shadow-sm ratio ratio-4x3">
            <img 
              src={category.imageUrl} 
              alt={category.title} 
              class="w-100 h-100 object-fit-cover" 
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilihan Produk Kategori -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="h3 fw-bold mb-1">Pilihan Model {category.shortName}</h2>
          <p class="text-muted small mb-0">Spesifikasi material tangguh berstandar industri.</p>
        </div>
      </div>

      <div class="row g-4 mb-5">
        {categoryProducts.map(prod => (
          <div class="col-12 col-sm-6 col-lg-4">
            <ProductCard product={prod} />
          </div>
        ))}
      </div>

      <!-- Detail Karakteristik Bahan -->
      <div class="p-4 p-md-5 rounded-4 bg-light border mb-5">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-lg-6">
            <h3 class="h4 fw-bold mb-3">Keunggulan Bahan Dinir &amp; Cordura</h3>
            <p class="text-muted small mb-4" style="line-height: 1.8;">
              {category.materialDescription}
            </p>
            <ul class="list-unstyled d-flex flex-column gap-2 mb-0 small text-muted">
              {category.benefits.map(b => (
                <li class="d-flex align-items-center gap-2">
                  <span class="badge rounded-circle bg-success-subtle text-success p-1">✓</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="col-12 col-lg-6">
            <div class="p-4 rounded-3 bg-white border">
              <div class="fw-bold text-dark mb-2">Peruntukan Utama:</div>
              <div class="d-flex flex-wrap gap-2 mb-4">
                {category.recommendedUses.map(use => (
                  <span class="badge bg-light text-dark border px-3 py-2">{use}</span>
                ))}
              </div>
              <div class="pt-3 border-top">
                <a href={categoryWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand w-100">
                  Minta Sampel Kain Dinir / Cordura
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Kategori -->
      {categoryFaqs.length > 0 && (
        <div class="max-w-75 mx-auto">
          <div class="text-center mb-4">
            <h2 class="h4 fw-bold mb-2">FAQ Pemesanan {category.shortName}</h2>
            <p class="text-muted small">Pertanyaan umum seputar waktu pengerjaan dan minimal order.</p>
          </div>
          <FAQAccordion items={categoryFaqs} defaultOpen={0} />
        </div>
      )}
    </div>
  </section>
</BaseLayout>
