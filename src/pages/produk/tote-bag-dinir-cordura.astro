---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Tote Bag Dinir & Cordura', url: '/produk/tote-bag-dinir-cordura/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/produk/tote-bag-dinir-cordura/#webpage",
      "url": "https://totebag.web.id/produk/tote-bag-dinir-cordura/",
      "name": "Tote Bag Dinir D300, D600 & Cordura Custom: Katalog Model & Harga Pabrik | ToteBag",
      "description": "Katalog tote bag bahan dinir D300, D600, dan cordura nilon tahan air untuk kebutuhan safety campaign, tambang, outdoor, dan merchandise korporat kokoh. Mulai Rp 28.000, MOQ 50 pcs.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/produk/tote-bag-dinir-cordura/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/produk/tote-bag-dinir-cordura/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Produk",
          "item": "https://totebag.web.id/produk/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tote Bag Dinir & Cordura",
          "item": "https://totebag.web.id/produk/tote-bag-dinir-cordura/"
        }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://totebag.web.id/produk/tote-bag-dinir-cordura/#product",
      "name": "Tote Bag Dinir & Cordura Custom",
      "image": "https://totebag.web.id/media/tote-bag-cordura.webp",
      "description": "Pabrik konveksi tote bag bahan Dinir D300, D600, dan kain Cordura coating tahan air untuk perlengkapan outdoor, kontraktor, industri, dan merchandise kedinasan.",
      "brand": {
        "@type": "Brand",
        "name": "ToteBag"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": 21000,
        "highPrice": 48000,
        "offerCount": 4,
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "IDR" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "ID" }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "ID",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 7,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "56"
      },
      "review": {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Ir. Hendra Kusuma" },
        "reviewBody": "Pengadaan tas dinir D600 untuk event kelistrikan sangat memuaskan, jahitan presisi dan bahan kedap air."
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/produk/tote-bag-dinir-cordura/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah bahan Dinir dan Cordura tahan air?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya. Kain Dinir D300, D600, dan Cordura memiliki lapisan coating PVC/PU di bagian dalam yang menahan cipratan air hujan ringan, sehingga berkas dokumen dan laptop di dalamnya tetap terlindungi."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal order (MOQ) untuk tote bag Dinir dan Cordura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimal pemesanan standar adalah 50 pcs per desain. Kami juga melayani pesanan ratusan hingga ribuan pcs untuk pengadaan korporat dengan harga grosir pabrik."
          }
        }
      ]
    }
  ]
};

const dinirModels = [
  {
    id: 'din-01',
    code: 'DIN-01',
    slug: 'tote-bag-dinir-d300-resleting-standard',
    name: 'Dinir D300 Resleting Standard (30 x 40 cm)',
    category: 'Diklat & Bimtek Instansi',
    badge: 'Ekonomis Tangguh',
    badgeClass: 'bg-primary text-white',
    price: 'Rp 28.000',
    priceRange: 'Rp 21.000 - Rp 28.000',
    moq: '50 pcs',
    image: '/media/foto-dinir.jpg',
    material: 'Polyester Dinir D300 Water Repellent',
    dimensions: '30 x 40 cm (Flat vertikal)',
    target: 'Pelatihan dinas, sertifikasi kompetensi, seminar teknis kementerian, dan rapat kerja tahunan.',
    features: [
      'Lapisan coating tahan air melindungi map dokumen',
      'Penutup ritsleting menjaga isi tas tidak tercecer',
      'Tali webbing polyester tebal 3.8 cm kuat di bahu',
      'Sablon rubber tebal 1-2 warna kontras tajam',
      'Kapasitas beban aman hingga 6-8 kg'
    ],
    waMessage: 'Halo ToteBag, saya tertarik memesan Model DIN-01 (Dinir D300 Resleting Standard).'
  },
  {
    id: 'din-02',
    code: 'DIN-02',
    slug: 'tote-bag-dinir-d600-premium-saku',
    name: 'Dinir D600 Gusset Heavy-Duty (35 x 40 x 10 cm)',
    category: 'Safety Campaign & Industri',
    badge: 'Heavy-Duty Industrial',
    badgeClass: 'bg-dark text-white',
    price: 'Rp 34.000',
    priceRange: 'Rp 26.500 - Rp 34.000',
    moq: '50 pcs',
    image: '/media/foto-cordura.jpg',
    material: 'Polyester Dinir D600 Super Tebal',
    dimensions: '35 x 40 x 10 cm (Bottom & Side Gusset)',
    target: 'Kontraktor proyek, safety campaign K3 pertambangan, pabrik manufaktur, logistik armada.',
    features: [
      'Kerapatan benang 600 Denier ekstra tebal anti robek gesekan',
      'Alas bawah dan samping 10 cm muat perlengkapan kerja berat',
      'Jahitan double-stitch di seluruh sambungan tumpu tali',
      'Opsi saku depan serbaguna dengan resleting',
      'Kapasitas beban uji hingga 10-12 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran untuk Model DIN-02 (Dinir D600 Gusset Heavy-Duty).'
  },
  {
    id: 'cor-01',
    code: 'COR-01',
    slug: 'tote-bag-cordura-tactical-heavy-duty',
    name: 'Cordura Tactical Splashproof (35 x 42 x 10 cm)',
    category: 'Outdoor & Tactical Merchandise',
    badge: 'Best Seller Tactical',
    badgeClass: 'bg-success text-white',
    price: 'Rp 42.000',
    priceRange: 'Rp 34.000 - Rp 42.000',
    moq: '50 pcs',
    image: '/media/tote-bag-cordura.webp',
    material: 'Kain Cordura Nilon Asli (Waterproof Coating)',
    dimensions: '35 x 42 x 10 cm',
    target: 'Komunitas adventure, merchandise otomotif, apparel outdoor, corporate gift premium.',
    features: [
      'Serat nilon Cordura original sangat ulet dan kedap air',
      'Resleting waterproof dengan tarikan paracord tactical',
      'Tali webbing nilon standar militer anti putus',
      'Bordir komputer timbul atau sablon plastisol presisi',
      'Kapasitas beban uji lab hingga 15 kg'
    ],
    waMessage: 'Halo ToteBag, saya ingin konsultasi Model COR-01 (Cordura Tactical Splashproof).'
  },
  {
    id: 'cor-02',
    code: 'COR-02',
    slug: 'tote-bag-cordura-roll-top-multipocket',
    name: 'Cordura Multi-Pocket Executive Laptop Bag',
    category: 'Tas Kerja & Eksekutif Lapangan',
    badge: 'Multi-Kompartemen',
    badgeClass: 'bg-warning text-dark',
    price: 'Rp 48.000',
    priceRange: 'Rp 39.500 - Rp 48.000',
    moq: '50 pcs',
    image: '/media/tote-bag-cordura.webp',
    material: 'Cordura Nilon + Lapisan Busa Pelindung',
    dimensions: '38 x 42 x 12 cm',
    target: 'Tas kerja engineer lapangan, konsultan proyek, surveyor, merchandise BUMN.',
    features: [
      'Kompartemen khusus laptop 14-15.6 inch berlapis busa empuk',
      'Dua saku depan bersekat untuk charger, mouse, dan buku catatan',
      'Dual handle: Tali jinjing tebal + tali selempang lepas-pasang',
      'Alas bawah kokoh tahan gesekan permukaan kasar',
      'Kapasitas beban maksimal hingga 15 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran Model COR-02 (Cordura Multi-Pocket Executive Laptop Bag).'
  }
];
---

<BaseLayout
  title="Tote Bag Dinir D300, D600 & Cordura Custom: Katalog Model & Harga Pabrik"
  description="Katalog tote bag bahan dinir D300, D600, dan cordura nilon tahan air untuk kebutuhan safety campaign, tambang, outdoor, dan merchandise korporat kokoh. Mulai Rp 28.000, MOQ 50 pcs."
  canonicalUrl="https://totebag.web.id/produk/tote-bag-dinir-cordura/"
  ogImage="https://totebag.web.id/media/tote-bag-cordura.webp"
  jsonLd={schemaJson}
>
  <!-- Topbar Announcement Strip -->
  <aside class="dinir-topbar py-2 text-center text-white small" style="background-color: var(--brand-primary, #173F38);" aria-label="Informasi konveksi dinir dan cordura">
    <div class="container">
      Konveksi Tote Bag Dinir D300, D600 &amp; Cordura Tahan Air • Jahitan Double-Stitch Standar Industri • Kirim Seluruh Indonesia
    </div>
  </aside>

  <!-- Breadcrumbs & Quick-Nav In-Page Navigation -->
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
    <nav class="quick-nav d-none d-md-flex flex-wrap gap-2 pt-2 pb-1" aria-label="Navigasi cepat halaman dinir cordura">
      <span class="small fw-semibold text-muted align-self-center me-1">Lompat ke:</span>
      <a href="#katalog-produk" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Katalog Model &amp; Harga</a>
      <a href="#tabel-harga" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Tabel Harga Grosir</a>
      <a href="#keunggulan" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Keunggulan Material</a>
      <a href="#faq" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">FAQ</a>
      <a href="#penawaran" class="badge badge-cta bg-brand text-white text-decoration-none px-3 py-2 rounded-pill shadow-sm">Minta Penawaran</a>
    </nav>
  </div>

  <!-- Hero Header Section -->
  <section class="section-space-sm pt-3 pb-4 hero-dinir" id="konten">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">KATALOG PRODUK &amp; KONVEKSI OUTDOOR</span>
          </div>
          <h1 class="hero-title mb-3">
            Tote Bag Dinir D300, D600 &amp; Cordura Custom: Tangguh, Tahan Air &amp; Heavy-Duty
          </h1>

          <p class="lead text-muted fs-5 mb-3" style="line-height: 1.7;">
            Pilihan tas merchandise paling kokoh untuk medan kerja aktif, proyek kontraktor, industri tambang, dan pelatihan kedinasan. Dilapisi coating tahan air dengan opsi resleting YKK dan kompartemen laptop berbusa empuk.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="#katalog-produk" class="btn btn-brand btn-lg">
              Lihat 4 Model Produk ↓
            </a>
            <a href="#penawaran" class="btn btn-brand-outline btn-lg">
              Konsultasi WhatsApp
            </a>
          </div>

          <div class="d-flex flex-wrap gap-3 text-muted small">
            <span><strong class="text-success">✓</strong> Mulai Rp 28.000 / pcs (MOQ 50 pcs)</span>
            <span><strong class="text-success">✓</strong> Lapisan Coating Tahan Cipratan Air</span>
            <span><strong class="text-success">✓</strong> Mampu Menahan Beban 10-15 kg</span>
            <span><strong class="text-success">✓</strong> Sablon Rubber Tebal &amp; Bordir Komputer</span>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="position-relative">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
              <img 
                src="/media/tote-bag-cordura.webp" 
                alt="Tote bag cordura tactical tahan air warna hitam dengan saku dan resleting kuat" 
                width="800" 
                height="600" 
                class="w-100 h-100 object-fit-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="position-absolute bottom-0 end-0 m-3 px-3 py-2 bg-white rounded-3 shadow-sm border text-dark d-none d-sm-block" style="max-width: 250px; z-index: 5;">
              <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-circle p-1 bg-success text-white" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">✓</span>
                <div>
                  <strong class="d-block text-brand fw-bold" style="font-size: 0.85rem; line-height: 1.2;">Water Repellent</strong>
                  <span class="text-muted" style="font-size: 0.75rem; line-height: 1.2;">Uji Beban 15 kg • Anti Robek</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKETPLACE CATALOG SECTION (Tampil Langsung di Depan) -->
  <section class="section-space pt-2 pb-5" id="katalog-produk">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
          <span class="badge-accent mb-2">PILIHAN MODEL SIAP ORDER</span>
          <h2 class="section-title mb-1">Katalog Model Tote Bag Dinir &amp; Cordura</h2>
          <p class="text-muted small mb-0">Klik tombol penawaran pada model yang sesuai untuk langsung mengirimkan brief ke tim sales kami.</p>
        </div>
        <div class="mt-2 mt-md-0">
          <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">MOQ Standar: 50 Pcs per Desain</span>
        </div>
      </div>

      <!-- Grid 4 Model Marketplace Cards -->
      <div class="row g-4 mb-5">
        {dinirModels.map(item => (
          <div class="col-12 col-md-6">
            <article class="card h-100 rounded-4 bg-white border shadow-sm overflow-hidden d-flex flex-column">
              <!-- Product Image Wrapper -->
              <div class="position-relative overflow-hidden border-bottom">
                <a href={`/produk/${item.slug}/`} class="d-block ratio ratio-4x3 bg-light text-decoration-none">
                  <img 
                    src={item.image} 
                    alt={`${item.name} bahan dinir cordura custom logo`}
                    width="600" 
                    height="450" 
                    class="w-100 h-100 object-fit-cover"
                    loading="lazy"
                  />
                </a>
                <span class={`position-absolute top-0 end-0 m-3 badge ${item.badgeClass} rounded-pill shadow-sm`} style="font-size: 0.75rem; z-index: 2;">
                  {item.badge}
                </span>
              </div>

              <!-- Product Details -->
              <div class="p-4 d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small fw-bold">{item.code} • {item.category}</span>
                  <span class="badge bg-light text-dark border small">MOQ {item.moq}</span>
                </div>
                <h3 class="h5 fw-bold mb-2">
                  <a href={`/produk/${item.slug}/`} class="text-decoration-none text-dark hover-brand">
                    {item.name}
                  </a>
                </h3>

                <div class="p-2 mb-3 rounded-2 bg-surface-alt border">
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Bahan Material:</span>
                    <strong class="text-dark">{item.material}</strong>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Ukuran Standar:</span>
                    <strong class="text-dark">{item.dimensions}</strong>
                  </div>
                </div>

                <div class="mb-3">
                  <div class="text-muted small fw-bold mb-1">Spesifikasi Fitur:</div>
                  <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-1">
                    {item.features.map(f => (
                      <li class="d-flex align-items-start gap-1">
                        <span class="text-success fw-bold">✓</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-auto pt-3 border-top">
                  <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                      <span class="text-muted" style="font-size: 0.75rem;">Mulai dari:</span>
                      <div class="h4 fw-bold text-brand mb-0">{item.price} <small class="text-muted fw-normal" style="font-size: 0.75rem;">/ pcs</small></div>
                    </div>
                    <span class="small text-muted text-end">{item.priceRange}</span>
                  </div>

                  <div class="d-flex gap-2">
                    <a 
                      href={`/produk/${item.slug}/`} 
                      class="btn btn-outline-dark flex-grow-1 text-center py-2"
                      style="font-size: 0.85rem; font-weight: 600;"
                    >
                      Detail Produk
                    </a>
                    <a 
                      href={`https://wa.me/6282131087971?text=${encodeURIComponent(item.waMessage)}`} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="btn btn-brand flex-grow-1 text-center py-2"
                      style="font-size: 0.85rem; font-weight: 600;"
                    >
                      Minta Penawaran
                    </a>
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>

      <!-- Tabel Skala Harga Grosir Dinir & Cordura -->
      <div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm mb-4" id="tabel-harga">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
          <div>
            <h3 class="h4 fw-bold mb-1">Tabel Skala Harga Grosir Dinir &amp; Cordura</h3>
            <p class="text-muted small mb-0">Harga satuan semakin hemat mengikuti kuantiti pesanan pengadaan korporat.</p>
          </div>
          <span class="badge bg-success-subtle text-success fw-bold px-3 py-2 rounded-pill mt-2 mt-md-0">Pabrik Konveksi Langsung</span>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-specs align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Model &amp; Spesifikasi Bahan</th>
                <th scope="col" class="text-center">50 - 99 Pcs</th>
                <th scope="col" class="text-center">100 - 299 Pcs</th>
                <th scope="col" class="text-center">300 - 499 Pcs</th>
                <th scope="col" class="text-center bg-success-subtle">500 - 999 Pcs</th>
                <th scope="col" class="text-center bg-success text-white">1.000+ Pcs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>DIN-01</strong> Dinir D300 Resleting Standard (30 x 40 cm)</td>
                <td class="text-center fw-bold">Rp 28.000</td>
                <td class="text-center">Rp 25.000</td>
                <td class="text-center">Rp 23.500</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 22.000</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 21.000</td>
              </tr>
              <tr>
                <td><strong>DIN-02</strong> Dinir D600 Gusset Heavy-Duty (35 x 40 x 10 cm)</td>
                <td class="text-center fw-bold">Rp 34.000</td>
                <td class="text-center">Rp 31.000</td>
                <td class="text-center">Rp 29.000</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 27.500</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 26.500</td>
              </tr>
              <tr>
                <td><strong>COR-01</strong> Cordura Tactical Splashproof (35 x 42 x 10 cm)</td>
                <td class="text-center fw-bold">Rp 42.000</td>
                <td class="text-center">Rp 38.500</td>
                <td class="text-center">Rp 36.500</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 35.000</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 34.000</td>
              </tr>
              <tr>
                <td><strong>COR-02</strong> Cordura Multi-Pocket Executive Laptop Bag</td>
                <td class="text-center fw-bold">Rp 48.000</td>
                <td class="text-center">Rp 44.500</td>
                <td class="text-center">Rp 42.000</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 40.500</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 39.500</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="small text-muted mt-3 mb-0">
          *Harga sudah termasuk sablon rubber 1 warna atau bordir logo standar. Penambahan saku khusus atau bordir bidang besar dapat dikonfirmasi saat pengajuan mockup.
        </p>
      </div>
    </div>
  </section>

  <!-- KEUNGGULAN MATERIAL -->
  <section class="section-space bg-surface-alt" id="keunggulan">
    <div class="container">
      <div class="max-w-75 mb-4">
        <span class="badge-accent mb-2">KARAKTERISTIK KAIN</span>
        <h2 class="section-title mb-2">Keunggulan Material Dinir &amp; Cordura</h2>
        <p class="text-muted small mb-0">
          Dirancang untuk kebutuhan kerja berat yang menuntut tas tahan gesekan dan tahan air.
        </p>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <strong class="text-dark d-block mb-2">1. Lapisan Coating Tahan Air</strong>
            <p class="small text-muted mb-0">Bagian belakang kain dilapisi PVC atau polyurethane yang mencegah rembesan air hujan, melindungi laptop dan berkas penting saat beraktivitas outdoor.</p>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
