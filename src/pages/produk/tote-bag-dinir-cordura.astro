  <!-- Script Penanganan Form RFQ ke WhatsApp (Zero Emojis, Zero Em-Dashes) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('dinirRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelD')?.value || 'DIN-02';
        const qty = document.getElementById('rfqQtyD')?.value || '100 pcs';
        const print = document.getElementById('rfqPrintD')?.value || 'Sablon Rubber';
        const deadline = document.getElementById('rfqDeadlineD')?.value || 'Segera';
        const city = document.getElementById('rfqCityD')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Dinir & Cordura Custom:

*Model Material:* ${model}
*Estimasi Kuantiti:* ${qty}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
