import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pemberitahuan Katalog Bahan | Tote Bag"
  description="Katalog bahan tas tote bag custom workshop kami berfokus pada material kain Canvas, Dinir D300/D600, Cordura, Blacu, Mika, Denim, dan Spunbond."
  canonicalUrl="https://totebag.web.id/produk/tote-bag-dinir-cordura/"
>
  <div class="container py-5 text-center my-5">
    <div class="max-w-75 mx-auto p-5 rounded-4 bg-light border shadow-sm">
      <span class="badge-accent mb-3">INFO KATALOG BAHAN</span>
      <h1 class="h3 fw-bold mb-3">Koleksi Dialihkan ke Dinir D600 &amp; Cordura</h1>
      <p class="text-muted mb-4" style="line-height: 1.7;">
        Workshop kami saat ini memfokuskan lini produksi pada tas tote bag kain fungsional berdaya tahan tinggi: <strong>Canvas, Dinir D300/D600, Cordura Waterproof, Blacu Super, Mika Transparan, Denim, dan Spunbond</strong>.
      </p>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="/produk/tote-bag-dinir-cordura/" class="btn btn-brand">
          Lihat Koleksi Dinir &amp; Cordura
        </a>
        <a href="/produk/" class="btn btn-brand-outline">
