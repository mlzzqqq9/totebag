---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Tote Bag Mika Transparan', url: '/produk/tote-bag-mika/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/produk/tote-bag-mika/#webpage",
      "url": "https://totebag.web.id/produk/tote-bag-mika/",
      "name": "Tote Bag Mika Transparan PVC Custom: Katalog Model & Harga Pabrik | ToteBag",
      "description": "Katalog tote bag mika transparan PVC custom bening kedap air untuk hampers skincare, goodie bag konser, dan merchandise estetik. Mulai Rp 18.000, MOQ 50 pcs.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/produk/tote-bag-mika/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/produk/tote-bag-mika/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Produk",
          "item": "https://totebag.web.id/produk/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tote Bag Mika Transparan",
          "item": "https://totebag.web.id/produk/tote-bag-mika/"
        }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://totebag.web.id/produk/tote-bag-mika/#product",
      "name": "Tote Bag Mika Transparan PVC Custom",
      "image": "https://totebag.web.id/media/tote-bag-mika.webp",
      "description": "Konveksi tote bag mika PVC transparan tebal 0.30 - 0.70 mm, kedap air dan kokoh untuk merchandise konser musik, hampers wedding, dan packaging kosmetik.",
      "brand": {
        "@type": "Brand",
        "name": "ToteBag"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": 13500,
        "highPrice": 33000,
        "offerCount": 4,
        "priceValidUntil": "2027-12-31",
        "validFrom": "2025-01-01",
        "availability": "https://schema.org/InStock",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": 0,
            "currency": "IDR"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "ID"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 3,
              "maxValue": 7,
              "unitCode": "d"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 4,
              "unitCode": "d"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "ID",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 7,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "46"
      },
      "review": [
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Brand Merchandise & Event Organizer"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "Kualitas mika PVC tebal jernih, sablon foil rapi dan presisi, sangat diminati peserta konser dan event festival."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/produk/tote-bag-mika/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah bahan mika PVC mudah menguning atau letoi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak. Kami menggunakan mika PVC grade premium anti-yellowing dengan ketebalan 0.30 mm hingga 0.50 mm yang tetap jernih kristal dan memiliki struktur mandiri yang kokoh."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal pemesanan tote bag mika custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimal pemesanan standar adalah 50 pcs per desain dengan sablon logo 1-3 warna atau cetak fullcolor UV printing."
          }
        }
      ]
    }
  ]
};

const mikaModels = [
  {
    id: 'mik-01',
    code: 'MIK-01',
    slug: 'tote-bag-mika-transparan-aesthetic',
    name: 'Flat Mika Bening 0.30 mm (25 x 35 cm)',
    category: 'Merchandise Konser & Event',
    badge: 'Ekonomis Bening',
    badgeClass: 'bg-info text-dark',
    price: 'Rp 18.000',
    priceRange: 'Rp 13.500 - Rp 18.000',
    moq: '50 pcs',
    image: '/media/tote-bag-mika.webp',
    material: 'Mika PVC Bening Transparan 0.30 mm',
    dimensions: '25 x 35 cm (Flat)',
    target: 'Konser musik, festival seni, goodie bag pameran kecantikan, souvenir photocard idol.',
    features: [
      'Mika kristal jernih 100% tembus pandang',
      'Tali jinjing mika atau webbing katun warna kontras',
      'Jahitan bisban keliling rapi anti robek',
      'Sablon sablon manual atau UV print tajam',
      'Kapasitas beban aman hingga 3-4 kg'
    ],
    waMessage: 'Halo ToteBag, saya tertarik order Model MIK-01 (Flat Mika Bening 0.30 mm).'
  },
  {
    id: 'mik-02',
    code: 'MIK-02',
    slug: 'tote-bag-mika-box-webbing',
    name: 'Box Gusset Mika Tebal 0.50 mm (30 x 38 x 10 cm)',
    category: 'Hampers Skincare & Wedding',
    badge: 'Best Seller Hampers',
    badgeClass: 'bg-success text-white',
    price: 'Rp 24.000',
    priceRange: 'Rp 17.500 - Rp 24.000',
    moq: '50 pcs',
    image: '/media/foto-mika.jpg',
    material: 'Mika PVC Stand-up Tebal 0.50 mm',
    dimensions: '30 x 38 x 10 cm (Bottom & Side Gusset)',
    target: 'Packaging skincare, hampers pernikahan, gift set kosmetik, souvenir hotel mewah.',
    features: [
      'Ketebalan 0.50 mm sangat kokoh berdiri tegak di meja',
      'Alas bawah 10 cm muat toples kue, botol serum, dan box hampers',
      'Kedap air 100% dan sangat mudah dibersihkan dari tumpahan cairan',
      'Tali pegangan selang sintetis atau webbing nylon lembut',
      'Kapasitas beban uji hingga 6-8 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran untuk Model MIK-02 (Box Gusset Mika Tebal 0.50 mm).'
  },
  {
    id: 'mik-03',
    code: 'MIK-03',
    slug: 'tote-bag-mika-kombinasi-canvas',
    name: 'Mika Kombinasi List Canvas / Kulit Sintetis',
    category: 'Retail Fashion & Butik',
    badge: 'Kombinasi Elegan',
    badgeClass: 'bg-primary text-white',
    price: 'Rp 29.000',
    priceRange: 'Rp 22.000 - Rp 29.000',
    moq: '50 pcs',
    image: '/media/tote-bag-mika.webp',
    material: 'Mika Transparan + Aksen Kain Canvas Twill / Kulit',
    dimensions: '32 x 40 x 10 cm',
    target: 'Packaging butik pakaian, brand retail komersial, hampers lebaran modern.',
    features: [
      'Perpaduan mika transparan bening dengan alas dan lis kain kanvas',
      'Menampilkan isi barang namun tetap berkesan hangat dan natural',
      'Tali jinjing webbing kanvas tebal dengan jahitan silang',
      'Opsi kancing magnet neodinium di bagian atas',
      'Kapasitas beban aman hingga 8 kg'
    ],
    waMessage: 'Halo ToteBag, saya ingin konsultasi Model MIK-03 (Mika Kombinasi List Canvas).'
  },
  {
    id: 'mik-04',
    code: 'MIK-04',
    slug: 'holographic-iridescent-pvc-tote',
    name: 'Mika Resleting YKK & Saku Pouch Dalam',
    category: 'Work Bag & Kosmetik Travel',
    badge: 'Keamanan Ekstra',
    badgeClass: 'bg-dark text-white',
    price: 'Rp 33.000',
    priceRange: 'Rp 25.500 - Rp 33.000',
    moq: '50 pcs',
    image: '/media/foto-mika.jpg',
    material: 'Mika Tebal 0.50 mm + Resleting YKK + Pouch Kanvas',
    dimensions: '35 x 40 x 12 cm',
    target: 'Tas kerja modern, tas renang / gym, travel kosmetik anti air, souvenir eksklusif.',
    features: [
      'Dilengkapi resleting YKK anti-macet menjaga isi tas tidak tumpah',
      'Termasuk pouch kain kanvas di bagian dalam untuk privasi dompet dan HP',
      'Tahan air total, ideal untuk area pantai, kolam renang, dan musim hujan',
      'Jahitan ganda dengan bisban penguat di semua sambungan',
      'Kapasitas beban uji hingga 10 kg'
    ],
    waMessage: 'Halo ToteBag, mohon penawaran Model MIK-04 (Mika Resleting YKK).'
  }
];
---

<BaseLayout
  title="Tote Bag Mika Transparan PVC Custom: Katalog Model & Harga Pabrik"
  description="Katalog tote bag mika transparan PVC custom bening kedap air untuk hampers skincare, goodie bag konser, dan merchandise estetik. Mulai Rp 18.000, MOQ 50 pcs."
  canonicalUrl="https://totebag.web.id/produk/tote-bag-mika/"
  ogImage="https://totebag.web.id/media/tote-bag-mika.webp"
  jsonLd={schemaJson}
>
  <!-- Topbar Announcement Strip -->
  <aside class="mika-topbar py-2 text-center text-white small" style="background-color: var(--brand-primary, #173F38);" aria-label="Informasi konveksi mika">
    <div class="container">
      Konveksi Tote Bag Mika Transparan PVC Tebal 0.30 - 0.70 mm • Kedap Air 100% • Kirim Seluruh Indonesia
    </div>
  </aside>

  <!-- Breadcrumbs & Quick-Nav In-Page Navigation -->
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
    <nav class="quick-nav d-none d-md-flex flex-wrap gap-2 pt-2 pb-1" aria-label="Navigasi cepat halaman mika">
      <span class="small fw-semibold text-muted align-self-center me-1">Lompat ke:</span>
      <a href="#katalog-produk" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Katalog Model &amp; Harga</a>
      <a href="#tabel-harga" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Tabel Harga Grosir</a>
      <a href="#keunggulan" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Karakteristik Mika</a>
      <a href="#faq" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">FAQ</a>
      <a href="#penawaran" class="badge badge-cta bg-brand text-white text-decoration-none px-3 py-2 rounded-pill shadow-sm">Minta Penawaran</a>
    </nav>
  </div>

  <!-- Hero Header Section -->
  <section class="section-space-sm pt-3 pb-4 hero-mika" id="konten">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">KATALOG PRODUK &amp; KONVEKSI MIKA PVC</span>
          </div>
          <h1 class="hero-title mb-3">
            Tote Bag Mika Transparan Custom: Bening Kristal, Kedap Air &amp; Estetik
          </h1>

          <p class="lead text-muted fs-5 mb-3" style="line-height: 1.7;">
            Pilihan tas transparan modern untuk hampers skincare, goodie bag konser musik, packaging butik, dan merchandise premium. Menggunakan bahan mika PVC murni tebal 0.30 hingga 0.50 mm yang kokoh berdiri dan tidak mudah menguning.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="#katalog-produk" class="btn btn-brand btn-lg">
              Lihat 4 Model Produk ↓
            </a>
            <a href="#penawaran" class="btn btn-brand-outline btn-lg">
              Konsultasi WhatsApp
            </a>
          </div>

          <div class="d-flex flex-wrap gap-3 text-muted small">
            <span><strong class="text-success">✓</strong> Mulai Rp 18.000 / pcs (MOQ 50 pcs)</span>
            <span><strong class="text-success">✓</strong> Ketebalan 0.30 - 0.70 mm Kokoh</span>
            <span><strong class="text-success">✓</strong> Tahan Air 100% &amp; Mudah Dilap</span>
            <span><strong class="text-success">✓</strong> Sablon &amp; UV Printing Warna Tajam</span>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="position-relative">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
              <img 
                src="/media/tote-bag-mika.webp" 
                alt="Tote bag mika transparan bening dengan sablon logo presisi untuk hampers dan event" 
                width="800" 
                height="600" 
                class="w-100 h-100 object-fit-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="position-absolute bottom-0 end-0 m-3 px-3 py-2 bg-white rounded-3 shadow-sm border text-dark d-none d-sm-block" style="max-width: 250px; z-index: 5;">
              <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-circle p-1 bg-success text-white" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">✓</span>
                <div>
                  <strong class="d-block text-brand fw-bold" style="font-size: 0.85rem; line-height: 1.2;">Mika PVC Kristal</strong>
                  <span class="text-muted" style="font-size: 0.75rem; line-height: 1.2;">Kedap Air 100% • Anti Menguning</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKETPLACE CATALOG SECTION (Tampil Langsung di Depan) -->
  <section class="section-space pt-2 pb-5" id="katalog-produk">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
          <span class="badge-accent mb-2">PILIHAN MODEL SIAP ORDER</span>
          <h2 class="section-title mb-1">Katalog Model Tote Bag Mika</h2>
          <p class="text-muted small mb-0">Klik tombol penawaran pada model yang sesuai untuk langsung mengirimkan brief ke tim sales kami.</p>
        </div>
        <div class="mt-2 mt-md-0">
          <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">MOQ Standar: 50 Pcs per Desain</span>
        </div>
      </div>

      <!-- Grid 4 Model Marketplace Cards -->
      <div class="row g-4 mb-5">
        {mikaModels.map(item => (
          <div class="col-12 col-md-6">
            <article class="card h-100 rounded-4 bg-white border shadow-sm overflow-hidden d-flex flex-column">
              <!-- Product Image Wrapper -->
              <a href={`/produk/${item.slug}/`} class="d-block position-relative overflow-hidden border-bottom text-decoration-none">
                <div class="ratio ratio-4x3 bg-light">
                  <img 
                    src={item.image} 
                    alt={`${item.name} bahan mika transparan custom logo`}
                    width="600" 
                    height="450" 
                    class="w-100 h-100 object-fit-cover"
                    loading="lazy"
                  />
                </div>
                <span class={`position-absolute top-0 end-0 m-3 badge ${item.badgeClass} rounded-pill shadow-sm`} style="font-size: 0.75rem; z-index: 2;">
                  {item.badge}
                </span>
              </a>

              <!-- Product Details -->
              <div class="p-4 d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small fw-bold">{item.code} • {item.category}</span>
                  <span class="badge bg-light text-dark border small">MOQ {item.moq}</span>
                </div>
                <h3 class="h5 fw-bold mb-2">
                  <a href={`/produk/${item.slug}/`} class="text-dark text-decoration-none hover-underline">
                    {item.name}
                  </a>
                </h3>

                <div class="p-2 mb-3 rounded-2 bg-surface-alt border">
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Ketebalan Mika:</span>
                    <strong class="text-dark">{item.material}</strong>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Ukuran Standar:</span>
                    <strong class="text-dark">{item.dimensions}</strong>
                  </div>
                </div>

                <div class="mb-3">
                  <div class="text-muted small fw-bold mb-1">Spesifikasi Fitur:</div>
                  <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-1">
                    {item.features.map(f => (
                      <li class="d-flex align-items-start gap-1">
                        <span class="text-success fw-bold">✓</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-auto pt-3 border-top">
                  <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                      <span class="text-muted" style="font-size: 0.75rem;">Mulai dari:</span>
                      <div class="h4 fw-bold text-brand mb-0">{item.price} <small class="text-muted fw-normal" style="font-size: 0.75rem;">/ pcs</small></div>
                    </div>
                    <span class="small text-muted text-end">{item.priceRange}</span>
                  </div>

                  <div class="row g-2">
                    <div class="col-6">
                      <a href={`/produk/${item.slug}/`} class="btn btn-outline-dark w-100 btn-sm py-2 fw-semibold">
                        Detail Produk
                      </a>
                    </div>
                    <div class="col-6">
                      <a 
                        href={`https://wa.me/6282131087971?text=${encodeURIComponent(item.waMessage)}`} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="btn btn-brand w-100 btn-sm py-2 fw-semibold"
                      >
                        Minta Penawaran
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>

      <!-- Tabel Skala Harga Grosir Mika -->
      <div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm mb-4" id="tabel-harga">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
          <div>
            <h3 class="h4 fw-bold mb-1">Tabel Skala Harga Grosir Tote Bag Mika</h3>
            <p class="text-muted small mb-0">Biaya per pcs semakin hemat seiring bertambahnya kuantiti pesanan.</p>
          </div>
          <span class="badge bg-success-subtle text-success fw-bold px-3 py-2 rounded-pill mt-2 mt-md-0">Pabrik Konveksi Langsung</span>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-specs align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Model &amp; Spesifikasi Mika</th>
                <th scope="col" class="text-center">50 - 99 Pcs</th>
                <th scope="col" class="text-center">100 - 299 Pcs</th>
                <th scope="col" class="text-center">300 - 499 Pcs</th>
                <th scope="col" class="text-center bg-success-subtle">500 - 999 Pcs</th>
                <th scope="col" class="text-center bg-success text-white">1.000+ Pcs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>MIK-01</strong> Flat Mika Bening 0.30 mm (25 x 35 cm)</td>
                <td class="text-center fw-bold">Rp 18.000</td>
                <td class="text-center">Rp 16.000</td>
                <td class="text-center">Rp 14.800</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 14.000</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 13.500</td>
              </tr>
              <tr>
                <td><strong>MIK-02</strong> Box Gusset Mika Tebal 0.50 mm (30 x 38 x 10 cm)</td>
                <td class="text-center fw-bold">Rp 24.000</td>
                <td class="text-center">Rp 21.000</td>
                <td class="text-center">Rp 19.500</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 18.200</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 17.500</td>
              </tr>
              <tr>
                <td><strong>MIK-03</strong> Mika Kombinasi List Canvas / Kulit</td>
                <td class="text-center fw-bold">Rp 29.000</td>
                <td class="text-center">Rp 26.000</td>
                <td class="text-center">Rp 24.000</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 22.800</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 22.000</td>
              </tr>
              <tr>
                <td><strong>MIK-04</strong> Mika Resleting YKK &amp; Saku Pouch Dalam</td>
                <td class="text-center fw-bold">Rp 33.000</td>
                <td class="text-center">Rp 30.000</td>
                <td class="text-center">Rp 28.000</td>
                <td class="text-center bg-success-subtle fw-bold">Rp 26.500</td>
                <td class="text-center bg-success-subtle text-success fw-bold">Rp 25.500</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="small text-muted mt-3 mb-0">
          *Harga sudah termasuk sablon 1 warna atau cetak logo UV printing standar.
        </p>
      </div>
    </div>
  </section>

  <!-- KEUNGGULAN MATERIAL MIKA -->
  <section class="section-space bg-surface-alt" id="keunggulan">
    <div class="container">
      <div class="max-w-75 mb-4">
        <span class="badge-accent mb-2">KARAKTERISTIK MATERIAL</span>
        <h2 class="section-title mb-2">Keunggulan Tote Bag Mika PVC</h2>
        <p class="text-muted small mb-0">
          Estetika visual modern yang menonjolkan produk di dalamnya dengan perlindungan tahan air maksimal.
        </p>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <strong class="text-dark d-block mb-2">1. Visual Transparan Estetik</strong>
