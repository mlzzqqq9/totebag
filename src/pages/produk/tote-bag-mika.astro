  <!-- Script Penanganan Form RFQ ke WhatsApp (Zero Emojis, Zero Em-Dashes) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('mikaRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelM')?.value || 'MIK-02';
        const qty = document.getElementById('rfqQtyM')?.value || '100 pcs';
        const print = document.getElementById('rfqPrintM')?.value || 'Sablon PVC';
        const deadline = document.getElementById('rfqDeadlineM')?.value || 'Segera';
        const city = document.getElementById('rfqCityM')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Mika Transparan Custom:

*Model Mika:* ${model}
*Estimasi Kuantiti:* ${qty}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
