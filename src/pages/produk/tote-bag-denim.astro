---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: 'Tote Bag Denim Custom', url: '/produk/tote-bag-denim/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/produk/tote-bag-denim/#webpage",
      "url": "https://totebag.web.id/produk/tote-bag-denim/",
      "name": "Tote Bag Denim Jeans Custom: Katalog Model, Spesifikasi & Harga Pabrik | ToteBag",
      "description": "Katalog tote bag denim jeans custom 10-12 oz langsung dari konveksi workshop Malang. Jahitan kontras benang tembaga, aksen rivet kuningan, saku jeans fungsional, dan sablon discharge. Harga mulai Rp 35.000, MOQ 50 pcs.",
      "inLanguage": "id-ID",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "breadcrumb": {
        "@id": "https://totebag.web.id/produk/tote-bag-denim/#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/produk/tote-bag-denim/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Produk",
          "item": "https://totebag.web.id/produk/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tote Bag Denim Custom",
          "item": "https://totebag.web.id/produk/tote-bag-denim/"
        }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://totebag.web.id/produk/tote-bag-denim/#product",
      "name": "Tote Bag Denim Jeans Custom Streetwear",
      "image": "https://totebag.web.id/media/tote-bag-denim.webp",
      "description": "Konveksi tote bag denim jeans raw indigo 12 oz untuk merchandise apparel distro, gathering komunitas kreatif, dan corporate souvenir bergaya kasual.",
      "brand": {
        "@type": "Brand",
        "name": "ToteBag"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": 28000,
        "highPrice": 52000,
        "offerCount": 4,
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/produk/tote-bag-denim/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Berapa gramasi kain denim yang digunakan untuk tote bag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami menggunakan kain denim twill katun asli berbobot 10 oz hingga 12 oz (sekitar 340-380 GSM). Karakter kain tebal, bertekstur tenun twill diagonal yang tegas, tidak mudah melar, dan sangat tangguh membawa beban laptop serta buku tebal."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah warna kain denim luntur saat dicuci pertama kali?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk varian raw indigo alami, sedikit pelepasan pigmen warna pada pencucian pertama merupakan sifat alami denim (bleeding). Kami menyediakan opsi denim pre-washed agar warna lebih stabil serta menyertakan kartu panduan perawatan cuci terpisah."
          }
        },
        {
          "@type": "Question",
          "name": "Teknik cetak logo apa yang paling direkomendasikan pada tas denim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk hasil paling autentik dan menyatu dengan kain, kami merekomendasikan sablon discharge (cabut warna). Selain itu, opsi sablon plastisol doff tebal, bordir komputer presisi, maupun patch kulit imitasi emboss sangat cocok untuk tas denim."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal pemesanan (MOQ) tote bag denim custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimal order (MOQ) adalah 50 pcs per model desain. Skala harga grosir bertingkat tersedia untuk pemesanan 100, 300, hingga 500+ pcs dengan potongan harga signifikan."
          }
        }
      ]
    }
  ]
};

// Data Model Marketplace Denim
const denimModels = [
  {
    code: 'DEN-01',
    name: 'Tote Bag Denim Raw Indigo 12 oz Flat',
    category: 'Kasual Distro & Gathering',
    moq: '50 pcs',
    price: 'Rp 35.000',
    priceRange: 'Skala 500+ pcs: Rp 28.000',
    material: 'Denim Twill Cotton 12 oz Raw Indigo',
    dimensions: '35 cm x 40 cm (Flat Klasik)',
    image: '/media/tote-bag-denim.webp',
    badge: 'Favorit Apparel & Komunitas',
    badgeClass: 'bg-primary text-white',
    features: [
      'Jahitan kontras benang tembaga (tobacco stitch)',
      'Tali bahan denim lapis ganda 3.8 cm (panjang 60 cm)',
      'Sablon discharge (cabut warna) atau plastisol doff',
      'Kuat menahan beban dokumen & buku hingga 8 kg'
    ],
    waMessage: 'Halo Tim ToteBag.web.id, saya ingin konsultasi pemesanan model Tote Bag Denim Raw Indigo 12 oz Flat (DEN-01). Mohon info penawaran harga dan mockup.'
  },
  {
    code: 'DEN-02',
    name: 'Tote Bag Denim Saku Depan Jeans + Gusset',
    category: 'Streetwear Utility',
    moq: '50 pcs',
    price: 'Rp 42.000',
    priceRange: 'Skala 500+ pcs: Rp 34.000',
    material: 'Denim Jeans 12 oz + Gusset 8 cm',
    dimensions: '36 cm x 40 cm x 8 cm (Semi Gusset)',
    image: '/media/tote-bag-denim.webp',
    badge: 'Saku Fungsional + Rivet Logam',
    badgeClass: 'bg-success text-white',
    features: [
      'Saku tempel luar depan fungsional khas saku celana jeans',
      'Penguat rivet kuningan anti-karat di pangkal tali',
      'Alas bervolume muat kotak bekal & tumbler botol',
      'Bisa kancing magnet snap nikel atau resleting YKK'
    ],
    waMessage: 'Halo Tim ToteBag.web.id, saya tertarik dengan Tote Bag Denim Saku Depan Jeans + Gusset (DEN-02). Mohon estimasi biaya dan waktu produksi.'
  },
  {
    code: 'DEN-03',
    name: 'Tote Bag Black Washed Denim + Patch Kulit',
    category: 'Premium Vintage Look',
    moq: '50 pcs',
    price: 'Rp 48.000',
    priceRange: 'Skala 500+ pcs: Rp 39.500',
    material: 'Black Sulfur Denim 12 oz Pre-Washed',
    dimensions: '38 cm x 42 cm x 10 cm (Large Capacity)',
    image: '/media/tote-bag-denim.webp',
    badge: 'Patch Kulit Emboss + Resleting YKK',
    badgeClass: 'bg-dark text-white',
    features: [
      'Proses stone-wash menghasilkan tekstur abu-hitam vintage',
      'Aksen patch kulit sintetis embossed logo instansi / brand',
      'Penutup ritsleting logam YKK heavy-duty',
      'Dilengkapi furing katun halus dan saku resleting bagian dalam'
    ],
    waMessage: 'Halo Tim ToteBag.web.id, tolong kirimkan rincian harga untuk model Tote Bag Black Washed Denim + Patch Kulit (DEN-03).'
  },
  {
    code: 'DEN-04',
    name: 'Tote Bag Denim Kombinasi Heavy Canvas 2-Tone',
    category: 'Hybrid Modern Craft',
    moq: '50 pcs',
    price: 'Rp 52.000',
    priceRange: 'Skala 500+ pcs: Rp 43.000',
    material: 'Denim Blue 12 oz + Bottom Heavy Canvas 14 oz',
    dimensions: '36 cm x 42 cm x 10 cm (Boxy Stand-up)',
    image: '/media/tote-bag-denim.webp',
    badge: 'Koleksi Eksklusif',
    badgeClass: 'bg-secondary text-white',
    features: [
      'Konstruksi 2-tone: bodi atas denim biru, alas kanvas kokoh',
      'Tali webbing katun herringbone tebal 3.8 cm nyaman di bahu',
      'Dilengkapi slot karet penahan tumbler botol minum di dalam',
      'Finishing bar-tack X-box pada setiap titik tumpu beban'
    ],
    waMessage: 'Halo Tim ToteBag.web.id, saya ingin meminta katalog dan penawaran Tote Bag Denim Kombinasi Heavy Canvas 2-Tone (DEN-04).'
  }
];

// Tabel Harga Bertingkat Grosir
const wholesaleTiers = [
  { tier: '50 - 99 pcs', den01: 'Rp 35.000', den02: 'Rp 42.000', den03: 'Rp 48.000', den04: 'Rp 52.000' },
  { tier: '100 - 299 pcs', den01: 'Rp 32.000', den02: 'Rp 38.000', den03: 'Rp 43.500', den04: 'Rp 47.000' },
  { tier: '300 - 499 pcs', den01: 'Rp 29.500', den02: 'Rp 35.500', den03: 'Rp 41.000', den04: 'Rp 44.500' },
  { tier: '500+ pcs', den01: 'Rp 28.000', den02: 'Rp 34.000', den03: 'Rp 39.500', den04: 'Rp 43.000' }
];

const categoryWaUrl = `https://wa.me/6282131087971?text=${encodeURIComponent('Halo Tim ToteBag.web.id, saya ingin berkonsultasi mengenai pemesanan Tote Bag Denim Jeans Custom untuk kebutuhan merchandise / gathering perusahaan.')}`;
---

<BaseLayout
  title="Tote Bag Denim Jeans Custom: Katalog Model, Spesifikasi & Harga Grosir Pabrik | ToteBag"
  description="Katalog tote bag denim jeans custom 10-12 oz konveksi workshop Malang. Aksen jahitan kontras benang tembaga, rivet kuningan, saku jeans fungsional, dan sablon discharge. Harga mulai Rp 35.000, MOQ 50 pcs."
  canonicalUrl="https://totebag.web.id/produk/tote-bag-denim/"
  categoryName="Denim"
  jsonLd={schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- HERO SECTION MARKETPLACE -->
  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">PRODUSEN TOTE BAG DENIM</span>
            <span class="badge bg-light text-dark border">Denim Jeans 10-12 oz</span>
          </div>

          <h1 class="hero-title mb-3" style="font-size: clamp(2rem, 3.5vw, 2.85rem);">
            Tote Bag Denim Jeans Custom Kasual &amp; Streetwear
          </h1>

          <p class="lead text-muted fs-5 mb-4" style="line-height: 1.6;">
            Konveksi tote bag berbahan kain denim twill jeans tebal 10 hingga 12 oz. Hadir dengan karakter kasual berjiwa muda, aksen jahitan kontras benang tembaga, rivet kuningan penguat, serta opsi patch kulit sintetis untuk brand distro, komunitas, dan souvenir gathering instansi.
          </p>

          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="#katalog-produk" class="btn btn-brand btn-lg shadow-sm">
              Lihat Katalog &amp; Harga Model
            </a>
            <a href="#tabel-harga" class="btn btn-brand-outline btn-lg">
              Tabel Skala Grosir
            </a>
            <a href={categoryWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-lg d-inline-flex align-items-center gap-2">
              Konsultasi WhatsApp
            </a>
          </div>

          <!-- Feature Pills -->
          <div class="row g-2 pt-2 border-top">
            <div class="col-6 col-sm-3">
              <div class="d-flex align-items-center gap-2 small text-dark fw-medium">
                <span class="text-success fw-bold">✓</span> Raw &amp; Washed 12 oz
              </div>
            </div>
            <div class="col-6 col-sm-3">
              <div class="d-flex align-items-center gap-2 small text-dark fw-medium">
                <span class="text-success fw-bold">✓</span> Benang Tembaga
              </div>
            </div>
            <div class="col-6 col-sm-3">
              <div class="d-flex align-items-center gap-2 small text-dark fw-medium">
                <span class="text-success fw-bold">✓</span> Rivet Logam Penguat
              </div>
            </div>
            <div class="col-6 col-sm-3">
              <div class="d-flex align-items-center gap-2 small text-dark fw-medium">
                <span class="text-success fw-bold">✓</span> Mulai Rp 35.000/pcs
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="position-relative">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
              <img 
                src="/media/tote-bag-denim.webp" 
                alt="Tote bag denim jeans custom dengan jahitan kontras benang tembaga dan patch kulit" 
                width="800" 
                height="600" 
                class="w-100 h-100 object-fit-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="position-absolute bottom-0 end-0 m-3 px-3 py-2 bg-white rounded-3 shadow-sm border text-dark d-none d-sm-block" style="max-width: 250px; z-index: 5;">
              <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-circle p-1 bg-success text-white" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">✓</span>
                <div>
                  <strong class="d-block text-brand fw-bold" style="font-size: 0.85rem; line-height: 1.2;">Denim Cotton 12 oz</strong>
                  <span class="text-muted" style="font-size: 0.75rem; line-height: 1.2;">Serat Twill Tebal • Tidak Mudah Robek</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKETPLACE CATALOG SECTION (Tampil Langsung di Depan) -->
  <section class="section-space pt-2 pb-5" id="katalog-produk">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
          <span class="badge-accent mb-2">PILIHAN MODEL SIAP ORDER</span>
          <h2 class="section-title mb-1">Katalog Model Tote Bag Denim</h2>
          <p class="text-muted small mb-0">Diproduksi dengan standar jahitan rantai garment dan finishing presisi di workshop Malang.</p>
        </div>
        <div class="mt-2 mt-md-0">
          <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">MOQ Standar: 50 Pcs per Desain</span>
        </div>
      </div>

      <!-- Grid 4 Model Marketplace Cards -->
      <div class="row g-4 mb-5">
        {denimModels.map(item => (
          <div class="col-12 col-md-6">
            <article class="card h-100 rounded-4 bg-white border shadow-sm overflow-hidden d-flex flex-column">
              <!-- Product Image Wrapper (Badge di luar .ratio mencegah bug oval raksasa) -->
              <div class="position-relative overflow-hidden border-bottom">
                <div class="ratio ratio-4x3 bg-light">
                  <img 
                    src={item.image} 
                    alt={`${item.name} bahan kain denim twill custom`}
                    width="600" 
                    height="450" 
                    class="w-100 h-100 object-fit-cover"
                    loading="lazy"
                  />
                </div>
                <span class={`position-absolute top-0 end-0 m-3 badge ${item.badgeClass} rounded-pill shadow-sm`} style="font-size: 0.75rem; z-index: 2;">
                  {item.badge}
                </span>
              </div>

              <!-- Product Details -->
              <div class="p-4 d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small fw-bold">{item.code} • {item.category}</span>
                  <span class="badge bg-light text-dark border small">MOQ {item.moq}</span>
                </div>
                <h3 class="h5 fw-bold mb-2 text-dark">{item.name}</h3>

                <div class="p-2 mb-3 rounded-2 bg-surface-alt border">
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Bahan Kain:</span>
                    <strong class="text-dark">{item.material}</strong>
                  </div>
                  <div class="d-flex justify-content-between small text-muted">
                    <span>Ukuran Standar:</span>
                    <strong class="text-dark">{item.dimensions}</strong>
                  </div>
                </div>

                <div class="mb-3">
                  <div class="text-muted small fw-bold mb-1">Spesifikasi Fitur:</div>
                  <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-1">
                    {item.features.map(f => (
                      <li class="d-flex align-items-start gap-1">
                        <span class="text-success fw-bold">✓</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-auto pt-3 border-top">
                  <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                      <span class="text-muted" style="font-size: 0.75rem;">Mulai dari:</span>
                      <div class="h4 fw-bold text-brand mb-0">{item.price} <small class="text-muted fw-normal" style="font-size: 0.75rem;">/ pcs</small></div>
                    </div>
                    <span class="small text-muted text-end">{item.priceRange}</span>
                  </div>

                  <a 
                    href={`https://wa.me/6282131087971?text=${encodeURIComponent(item.waMessage)}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-brand w-100"
                  >
                    Minta Penawaran Model Ini
                  </a>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>

      <!-- Tabel Skala Harga Grosir Denim -->
      <div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm mb-4" id="tabel-harga">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
          <div>
            <span class="badge-accent mb-2">TRANSPARANSI B2B</span>
            <h3 class="h4 fw-bold mb-1">Tabel Skala Harga Grosir Tote Bag Denim</h3>
            <p class="text-muted small mb-0">Estimasi harga satuan mencakup tas bahan denim 12 oz dan sablon logo 1 warna. Harga final ditentukan detail desain.</p>
          </div>
          <div class="mt-2 mt-md-0">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">Harga Workshop Langsung</span>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered align-middle mb-0 text-center">
            <thead class="table-light">
              <tr>
                <th scope="col" class="text-start py-3" style="min-width: 170px;">Jumlah Pesanan (Qty)</th>
                <th scope="col" class="py-3">DEN-01 (Flat 12 oz)</th>
                <th scope="col" class="py-3">DEN-02 (Gusset Saku Jeans)</th>
                <th scope="col" class="py-3">DEN-03 (Black Washed Patch)</th>
                <th scope="col" class="py-3">DEN-04 (Hybrid Canvas 2-Tone)</th>
              </tr>
            </thead>
            <tbody>
              {wholesaleTiers.map(row => (
                <tr>
                  <td class="text-start fw-bold text-dark py-3">{row.tier}</td>
                  <td class="fw-semibold text-brand">{row.den01}</td>
                  <td>{row.den02}</td>
                  <td>{row.den03}</td>
                  <td>{row.den04}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-3 p-3 rounded-3 bg-surface-alt border small text-muted">
          <strong>Keterangan Pemesanan Denim:</strong>
          <ul class="mb-0 mt-1 ps-3">
            <li>Harga sudah termasuk kain denim twill katun 12 oz, jahit ganda benang tembaga, dan sablon rubber / discharge 1 warna 1 sisi.</li>
            <li>Tambahan variasi aksen: Rivet kuningan logam (+Rp 1.500/titik), Patch kulit sintetis deboss (+Rp 3.500 - Rp 5.000/pcs), Ritsleting YKK (+Rp 4.000/pcs).</li>
            <li>Lama pengerjaan berkisar antara 7 hingga 14 hari kerja tergantung kuantiti dan antrean produksi.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DETAIL ANATOMI & KARAKTERISTIK KAIN DENIM -->
  <section class="section-space-sm bg-surface-alt">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6">
          <span class="badge-accent mb-2">ANATOMI &amp; KUALITAS JAHITAN</span>
          <h2 class="section-title mb-3">Mengapa Tote Bag Denim Menjadi Favorit Brand &amp; Komunitas?</h2>
          <p class="text-muted mb-3" style="line-height: 1.7;">
            Denim bukan sekadar kain biasa, melainkan ikon budaya kasual modern. Berbeda dengan tas belanja biasa yang tipis, tote bag denim memiliki struktur tenun twill diagonal yang rapat, berbobot mantap di tangan, dan memiliki nilai prestise tinggi saat digunakan oleh audiens muda.
          </p>

          <div class="d-flex flex-column gap-3 mb-4">
            <div class="p-3 bg-white rounded-3 border">
              <strong class="d-block text-dark mb-1">1. Tenun Twill 10-12 oz Kokoh &amp; Tahan Gesek</strong>
              <p class="text-muted small mb-0">Serat katun twill bergramasi 340-380 GSM memberikan perlindungan maksimal pada barang bawaan tanpa risiko robek saat terkena sudut laptop tajam.</p>
            </div>
            <div class="p-3 bg-white rounded-3 border">
              <strong class="d-block text-dark mb-1">2. Jahitan Kontras Benang Tembaga (Tobacco Stitch)</strong>
              <p class="text-muted small mb-0">Kami menggunakan benang nilon nomor 20 warna tembaga khas celana jeans klasik dengan jahitan rantai double-needle untuk aksen visual yang autentik dan kekuatan sambungan ekstra.</p>
            </div>
            <div class="p-3 bg-white rounded-3 border">
              <strong class="d-block text-dark mb-1">3. Karakter Semakin Keren Seiring Waktu (Fading Effect)</strong>
              <p class="text-muted small mb-0">Seperti jaket atau celana jeans kesayangan, denim raw indigo akan membentuk pola lipatan dan efek pudar alami yang membuat setiap tas memiliki nilai personal unik.</p>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm">
            <h3 class="h4 fw-bold mb-3">Pilihan Teknik Branding pada Denim</h3>
            <p class="text-muted small mb-4">
              Pilih teknik cetak logo yang paling sesuai dengan konsep visual identitas Anda:
            </p>

            <div class="d-flex flex-column gap-3">
              <div class="d-flex gap-3 align-items-start">
                <div class="badge bg-brand text-white p-2 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">1</div>
                <div>
                  <h4 class="h6 fw-bold mb-1 text-dark">Sablon Discharge (Cabut Warna)</h4>
