---
// src/pages/produk/tote-bag-denim.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import { categories, products, denimFaqs, getWhatsAppUrl } from '../../data/siteData';

const category = categories.find(c => c.slug === 'tote-bag-denim')!;
const categoryProducts = products.filter(p => p.categorySlug === 'tote-bag-denim');
const categoryFaqs = denimFaqs;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: category.title, url: `/produk/${category.slug}/` }
];

const categoryWaUrl = getWhatsAppUrl({
  categoryName: category.title,
  sourcePage: `/produk/${category.slug}/`
});
---

<BaseLayout
  title={`${category.title} — Karakter Kasual Jeans Indigo & Awet`}
  description="Konveksi tote bag denim jeans custom raw indigo 12 oz. Aksen jahitan kontras benang tembaga, rivet kuningan, dan patch kulit timbul untuk distro & gathering."
  canonicalUrl={`https://totebag.web.id/produk/${category.slug}/`}
  categoryName={category.title}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <span class="badge-accent mb-2">KATEGORI MATERIAL</span>
          <h1 class="hero-title mb-3">{category.title}</h1>
          <p class="lead text-muted fs-5 mb-4">
            {category.tagline}
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href={categoryWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-lg">
              Minta Penawaran Tote Bag Denim
            </a>
            <a href="/cara-pesan/" class="btn btn-brand-outline btn-lg">
              Alur Pemesanan
            </a>
          </div>
        </div>
        <div class="col-12 col-lg-5">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
            <img 
              src={category.imageUrl} 
              alt={`Tote Bag Denim Jeans Custom B2B`} 
              width="600" 
              height="450" 
              class="w-100 h-100 object-fit-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview & Benefits -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-12 col-lg-6">
          <h2 class="section-title mb-3">Karakteristik &amp; Keunggulan Kain Denim Jeans</h2>
          <p class="text-muted mb-3">
            {category.overview}
          </p>
          <p class="text-muted mb-4">
            {category.materialDescription}
          </p>

          <h3 class="h5 fw-bold mb-3">Kelebihan Utama Bahan Denim:</h3>
          <ul class="list-unstyled d-flex flex-column gap-2 text-muted">
            {category.benefits.map(b => (
              <li class="d-flex align-items-start gap-2">
                <span class="badge rounded-circle bg-success text-white p-1">✓</span>
                <span class="fw-medium text-dark">{b}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-12 col-lg-6">
          <div class="p-4 p-lg-5 rounded-4 bg-white border h-100">
            <h3 class="h4 fw-bold mb-3">Rekomendasi Penggunaan</h3>
            <p class="text-muted small mb-4">
              Denim adalah material favorit bagi organisasi yang menginginkan merchandise berkarakter santai, berjiwa muda, dan memiliki nilai prestise jangka panjang:
            </p>
            <div class="row g-3">
              {category.recommendedUses.map(use => (
                <div class="col-12 col-sm-6">
                  <div class="p-3 rounded-3 bg-light border h-100">
                    <span class="fw-semibold text-dark small">{use}</span>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-4 pt-3 border-top">
              <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded bg-success bg-opacity-10 text-success">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v2H6V3a2 2 0 0 1 2-2m3 4V3a3 3 0 1 0-6 0v2H3.36a1.5 1.5 0 0 0-1.483 1.277L.85 13.13A2.5 2.5 0 0 0 3.322 16h9.355a2.5 2.5 0 0 0 2.473-2.87l-1.028-6.853A1.5 1.5 0 0 0 12.64 5z"/>
                  </svg>
                </div>
                <div>
                  <div class="fw-bold small text-dark">Kain Jeans 10 oz - 12 oz</div>
                  <div class="text-muted small">Tebal, tahan tarikan, dengan warna indigo wash yang autentik.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilihan Produk / Model -->
  <section class="section-space">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">MODEL PRODUK</span>
        <h2 class="section-title mb-3">Pilihan Model Tote Bag Denim</h2>
        <p class="section-subtitle mx-auto">
          Tersedia format tote bag raw denim kasual, model saku depan bergaya celana jeans, hingga kombinasi patch kulit sintetis.
        </p>
      </div>

      <div class="row g-4">
        {categoryProducts.map(product => (
          <div class="col-12 col-md-6 col-lg-4">
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-space-sm bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mx-auto">
        <div class="text-center mb-4">
          <span class="badge-accent mb-2">TANYA JAWAB</span>
          <h2 class="section-title mb-2">Pertanyaan Seputar Tote Bag Denim</h2>
          <p class="text-muted small">Seputar ketebalan kain jeans, teknik sablon discharge, dan perawatan warna.</p>
        </div>
        <FAQAccordion items={categoryFaqs} />
      </div>
    </div>
  </section>
</BaseLayout>
