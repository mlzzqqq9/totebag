  <!-- Script Form WhatsApp Handler -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('denimRfqForm');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const model = document.getElementById('rfqModelD')?.value || 'DEN-01';
        const qty = document.getElementById('rfqQtyD')?.value || '50 pcs';
        const print = document.getElementById('rfqPrintD')?.value || 'Sablon Discharge';
        const deadline = document.getElementById('rfqDeadlineD')?.value || 'Segera';
        const city = document.getElementById('rfqCityD')?.value || 'Malang';

        const messageText = 
`Halo Tim ToteBag.web.id, saya ingin meminta penawaran resmi untuk Tote Bag Denim Custom:

*Model Denim:* ${model}
*Estimasi Kuantiti:* ${qty}
*Teknik Logo:* ${print}
*Rencana Penggunaan:* ${deadline}
*Tujuan Kirim:* ${city}

Mohon informasi kalkulasi harga terbaik dan prosedur sampel mockup. Terima kasih!`;

        const waUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(messageText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    });
  </script>
