---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { products, categories, faqs, getWhatsAppUrl } from '@/data/siteData';

export async function getStaticPaths() {
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const category = categories.find(c => c.slug === product.categorySlug) || {
  slug: product.categorySlug,
  title: product.categoryName,
  shortName: product.categoryName
};

const relatedProducts = products.filter(p => p.categorySlug === product.categorySlug && p.id !== product.id).slice(0, 4);
const productFaqs = faqs.slice(0, 4);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk', url: '/produk/' },
  { name: category.shortName, url: `/produk/${category.slug}/` },
  { name: product.name, url: `/produk/${product.slug}/` }
];

const waMessage = `Halo Tim ToteBag.web.id, saya tertarik dengan produk *${product.name}* (Kode: ${product.id}).

*Spesifikasi:*
- Ukuran: ${product.dimensions}
- Bahan: ${product.material}
- MOQ: ${product.moq || product.specTable.rekomendasiQty}
- Estimasi Harga: ${product.price || 'Sesuai Kuantiti'}

Mohon informasi kalkulasi penawaran resmi dan prosedur sampel mockup. Terima kasih!`;

const rfqWaUrl = `https://wa.me/6282131087971?text=${encodeURIComponent(waMessage)}`;

// Default detail images if not specifically defined
const detailPhotos = product.detailImages && product.detailImages.length > 0 ? product.detailImages : [
  { url: '/media/foto-macro.jpg', caption: `Detail Tekstur Serat ${product.material}`, alt: `Detail tekstur ${product.name}` },
  { url: '/media/quality-control-inspection-checklist.webp', caption: 'Detail Jahitan Bar-Tack & Kualitas Penutup', alt: `Inspeksi jahitan ${product.name}` },
  { url: '/media/foto-seminar.jpg', caption: 'Aplikasi Paket Seminar Kit & Goodie Bag Acara', alt: `Penggunaan ${product.name} seminar` },
  { url: '/media/proses-cetak-dtf-heat-press.webp', caption: 'Detail Cetak Sablon Logo Presisi', alt: `Proses sablon ${product.name}` }
];

// Parse numeric price for Google Merchant Listings (e.g. "Rp 40.000" -> 40000)
const numericPrice = product.price ? parseInt(product.price.replace(/[^0-9]/g, ''), 10) : 35000;

// JSON-LD Product Schema compliant with Google Merchant Listings & Rich Snippets
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "image": `https://totebag.web.id${product.imageUrl}`,
  "sku": product.id,
  "mpn": product.id,
  "category": category.title,
  "material": product.material,
  "brand": {
    "@type": "Brand",
    "name": "ToteBag"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://totebag.web.id/produk/${product.slug}/`,
    "priceCurrency": "IDR",
    "price": numericPrice,
    "priceValidUntil": "2027-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@id": "https://totebag.web.id/#organization"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": 0,
        "currency": "IDR"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "ID"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 5,
          "maxValue": 10,
          "unitCode": "d"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 2,
          "maxValue": 5,
          "unitCode": "d"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "ID",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "48"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5"
    },
    "author": {
      "@type": "Person",
      "name": "Hendra Kusuma"
    },
    "reviewBody": "Kualitas bahan dan pengerjaan sablon sangat presisi dan rapi. Pengadaan tas seminar instansi kami selesai tepat waktu."
  }
};
---

<BaseLayout
  title={`${product.name} | Spesifikasi, Foto Detail & Penawaran B2B`}
  description={`Katalog lengkap ${product.name}. Ukuran ${product.dimensions}, bahan ${product.material}. Foto detail material, jahitan, harga grosir, dan pemesanan custom logo.`}
  canonicalUrl={`https://totebag.web.id/produk/${product.slug}/`}
  ogImage={`https://totebag.web.id${product.imageUrl}`}
  jsonLd={productSchema}
  productName={product.name}
  categoryName={category.title}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- HERO SECTION PRODUK (Layout 2 Kolom TheBatik Reference) -->
  <section class="section-space-sm pt-2 pb-5">
    <div class="container">
      <div class="row g-4 g-lg-5 align-items-start">
        
        <!-- KOLOM KIRI: FOTO UTAMA & THUMBNAIL GALLERY -->
        <div class="col-12 col-lg-6">
          <div class="sticky-top" style="top: 85px; z-index: 1;">
            <!-- Main Featured Image -->
            <div class="position-relative bg-white rounded-4 border shadow-sm overflow-hidden mb-3 text-center p-3">
              <div class="ratio ratio-4x3 bg-light rounded-3 overflow-hidden">
                <img 
                  id="mainProductImg"
                  src={product.imageUrl} 
                  alt={product.altText} 
                  width="800" 
                  height="600" 
                  class="w-100 h-100 object-fit-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
              <span class="position-absolute top-0 start-0 m-4 badge bg-brand text-white rounded-pill px-3 py-2 small shadow-sm">
                KODE: {product.id}
              </span>
            </div>

            <!-- Thumbnail Gallery Row -->
            <div class="row g-2">
              <div class="col-3">
                <button 
                  type="button" 
                  class="thumb-btn btn p-1 w-100 border rounded-3 bg-white active"
                  data-img-src={product.imageUrl}
                  aria-label="Foto Utama Produk"
                >
                  <div class="ratio ratio-1x1 rounded-2 overflow-hidden bg-light">
                    <img src={product.imageUrl} alt="Foto Utama" class="w-100 h-100 object-fit-cover" />
                  </div>
                </button>
              </div>
              {detailPhotos.slice(0, 3).map((item, idx) => (
                <div class="col-3">
                  <button 
                    type="button" 
                    class="thumb-btn btn p-1 w-100 border rounded-3 bg-white"
                    data-img-src={item.url}
                    aria-label={item.caption}
                  >
                    <div class="ratio ratio-1x1 rounded-2 overflow-hidden bg-light">
                      <img src={item.url} alt={item.alt} class="w-100 h-100 object-fit-cover" />
                    </div>
                  </button>
                </div>
              ))}
            </div>

            <div class="d-flex align-items-center justify-content-between p-3 mt-3 bg-surface-alt rounded-3 border small text-muted">
              <span class="d-flex align-items-center gap-1">
                <span class="text-success fw-bold">✓</span> Workshop Konveksi Malang
              </span>
              <span class="d-flex align-items-center gap-1">
                <span class="text-success fw-bold">✓</span> Free Mockup Digital
              </span>
              <span class="d-flex align-items-center gap-1">
                <span class="text-success fw-bold">✓</span> Kirim Kargo Se-Indonesia
              </span>
            </div>
          </div>
        </div>

        <!-- KOLOM KANAN: DETAIL SPESIFIKASI, DESKRIPSI & CTA WHATSAPP -->
        <div class="col-12 col-lg-6">
          <div class="d-flex align-items-center gap-2 mb-2">
            <a href={`/produk/${category.slug}/`} class="badge-accent text-decoration-none">
              {category.title}
            </a>
            <span class="badge bg-light text-dark border">B2B Custom Corporate</span>
          </div>

          <!-- Product Title H1 (Besar & Tegas seperti referensi) -->
          <h1 class="h2 fw-bold text-dark mb-3" style="line-height: 1.35; letter-spacing: -0.01em;">
            {product.name.toUpperCase()} - TAS SEMINAR KIT &amp; SOUVENIR KANTOR EKSKLUSIF
          </h1>

          <!-- TABEL SPESIFIKASI RINGKAS (Clean Definition List TheBatik Style) -->
          <div class="table-responsive mb-4 bg-white rounded-3 border shadow-none">
            <table class="table table-borderless align-middle mb-0" style="font-size: 0.92rem;">
              <tbody>
                <tr class="border-bottom">
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3" style="width: 140px;">Ukuran</th>
                  <td class="py-2 pe-3 text-dark fw-bold">{product.dimensions}</td>
                </tr>
                <tr class="border-bottom">
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3">Material</th>
                  <td class="py-2 pe-3 text-dark">{product.material}</td>
                </tr>
                <tr class="border-bottom">
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3">MOQ</th>
                  <td class="py-2 pe-3 text-dark fw-bold text-brand">{product.moq || product.specTable.rekomendasiQty}</td>
                </tr>
                <tr class="border-bottom">
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3">Logo / Tulisan</th>
                  <td class="py-2 pe-3 text-dark">{product.techniques.join(', ')}</td>
                </tr>
                <tr class="border-bottom">
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3">Pilihan Penutup</th>
                  <td class="py-2 pe-3 text-dark">{product.specTable.pilihanPenutup}</td>
                </tr>
                <tr>
                  <th scope="row" class="text-muted fw-semibold py-2 ps-3">Estimasi Harga</th>
                  <td class="py-2 pe-3 text-brand fw-bold fs-5">
                    {product.price || 'Hubungi Kami'} 
                    <small class="text-muted fw-normal fs-6">/ pcs ({product.priceScale || 'Harga Skala Grosir'})</small>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Paragraf Penjelasan Singkat & Padat -->
          <div class="mb-4">
            <p class="text-muted fs-6" style="line-height: 1.75;">
              {product.description}
            </p>
          </div>

          <!-- Kategori & Tags (TheBatik Reference Format) -->
          <div class="p-3 rounded-3 bg-surface-alt border mb-4 small">
            <div class="mb-2">
              <strong class="text-dark">category:</strong> 
              <a href={`/produk/${category.slug}/`} class="text-decoration-none text-brand fw-medium ms-1">{category.title.toLowerCase()}</a>, 
              <a href="/tote-bag-seminar/" class="text-decoration-none text-brand fw-medium">tas seminar</a>,
              <a href="/tote-bag-custom/" class="text-decoration-none text-brand fw-medium">tote bag custom</a>
            </div>
            <div>
              <strong class="text-dark">tags:</strong> 
              <span class="text-muted ms-1">
                {product.tags && product.tags.length > 0 
                  ? product.tags.join(', ') 
                  : `${product.name.toLowerCase()}, tas seminar kit, tote bag kantor, souvenir eksklusif, konveksi tote bag malang`}
              </span>
            </div>
          </div>

          <!-- Tombol CTA Pesan / WhatsApp -->
          <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
            <a 
              href={rfqWaUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-brand btn-lg py-3 px-4 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm flex-grow-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/>
              </svg>
              <span class="fw-bold">Minta Penawaran Model Ini via WhatsApp</span>
            </a>
            <a href="#spesifikasi-lengkap" class="btn btn-brand-outline btn-lg py-3 px-4 text-center">
              Rincian Spek &amp; Grosir
            </a>
          </div>

          <!-- Key Highlights Bullet -->
          <div class="p-3 bg-light rounded-3 border">
            <div class="fw-bold text-dark small mb-2">Keunggulan Fitur Model Ini:</div>
            <ul class="list-unstyled mb-0 small text-muted d-flex flex-column gap-2">
              {product.features.map(f => (
                <li class="d-flex align-items-start gap-2">
                  <span class="text-success fw-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- SECTION FOTO DETAIL & FITUR PENGERJAAN (Screenshot 2 Reference) -->
  <section class="section-space bg-surface-alt" id="foto-detail">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">FOTO DETAIL &amp; FITUR</span>
        <h2 class="section-title mb-2">Dokumentasi Detail Material &amp; Kualitas Jahitan</h2>
        <p class="section-subtitle mx-auto">
          Foto close-up nyata yang memperlihatkan kerapatan serat bahan, jahitan penguat bar-tack, furing interior, dan aplikasi sablon presisi.
        </p>
      </div>

      <div class="row g-4">
        {detailPhotos.map((item, index) => (
          <div class="col-12 col-md-6">
            <div class="card h-100 rounded-4 bg-white border shadow-sm overflow-hidden">
              <div class="ratio ratio-16x9 bg-light">
                <img 
                  src={item.url} 
                  alt={item.alt}
                  width="800" 
                  height="450" 
                  class="w-100 h-100 object-fit-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <span class="badge rounded-circle bg-brand text-white p-1" style="width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px;">
                    {index + 1}
                  </span>
                  <h3 class="h6 fw-bold mb-0 text-dark">{item.caption}</h3>
                </div>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                  {item.alt}. Dikerjakan dengan mesin jahit industri berkecepatan tinggi dan inspeksi quality control berlapis sebelum pengiriman.
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION TABEL SPESIFIKASI TEKNIS & SKALA GROSIR -->
  <section class="section-space" id="spesifikasi-lengkap">
    <div class="container">
      <div class="row g-5">
        <div class="col-12 col-lg-8">
          <div class="mb-4">
            <span class="badge-accent mb-2">SPESIFIKASI LENGKAP</span>
            <h2 class="h3 fw-bold mb-2">Rincian Parameter Teknis Produksi</h2>
            <p class="text-muted small mb-0">Spesifikasi bahan kain, ukuran standar, pilihan penutup, dan estimasi waktu produksi massal.</p>
          </div>

          <div class="table-responsive rounded-3 border bg-white shadow-sm mb-4">
            <table class="table table-bordered align-middle mb-0">
              <tbody>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3" style="width: 200px;">Nama Model &amp; Kode</th>
                  <td class="ps-3 py-3 fw-bold text-dark">{product.name} ({product.id})</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Nama Material</th>
                  <td class="ps-3 py-3">{product.specTable.material}</td>
                </tr>
                {product.specTable.gramasi && (
                  <tr>
                    <th scope="row" class="table-light ps-3 py-3">Gramasi / Ketebalan</th>
                    <td class="ps-3 py-3">{product.specTable.gramasi}</td>
                  </tr>
                )}
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Ukuran Standard</th>
                  <td class="ps-3 py-3">{product.specTable.ukuranStandard}</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Tali Handle</th>
                  <td class="ps-3 py-3">{product.specTable.pilihanTali}</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Pilihan Penutup</th>
                  <td class="ps-3 py-3">{product.specTable.pilihanPenutup}</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Pilihan Cetak Logo</th>
                  <td class="ps-3 py-3">{product.specTable.opsiCetak}</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Minimal Order (MOQ)</th>
                  <td class="ps-3 py-3 fw-bold text-brand">{product.specTable.rekomendasiQty}</td>
                </tr>
                <tr>
                  <th scope="row" class="table-light ps-3 py-3">Estimasi Pengerjaan</th>
                  <td class="ps-3 py-3">{product.specTable.estimasiPengerjaan}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Kustomisasi Tambahan -->
          <div class="p-4 rounded-4 bg-surface-alt border">
            <h3 class="h5 fw-bold mb-3 text-dark">Opsi Kustomisasi Khusus untuk Kebutuhan Anda:</h3>
            <div class="row g-3 small text-muted">
              <div class="col-12 col-sm-6">
                <div class="p-3 bg-white rounded-3 border h-100">
                  <strong class="text-dark d-block mb-1">Custom Ukuran (P x T x Gusset)</strong>
                  Dapat disesuaikan dengan ukuran laptop, binder dokumen, atau kotak hampers Anda.
                </div>
              </div>
              <div class="col-12 col-sm-6">
                <div class="p-3 bg-white rounded-3 border h-100">
                  <strong class="text-dark d-block mb-1">Furing &amp; Saku Tambahan</strong>
                  Pilihan lapisan furing katun/parasut halus serta saku dalam beresleting.
                </div>
              </div>
              <div class="col-12 col-sm-6">
                <div class="p-3 bg-white rounded-3 border h-100">
                  <strong class="text-dark d-block mb-1">Pilihan Warna Bahan</strong>
                  Tersedia aneka varian warna kain katalog resmi (hitam, navy, maroon, olive, beige, dll).
                </div>
              </div>
              <div class="col-12 col-sm-6">
                <div class="p-3 bg-white rounded-3 border h-100">
                  <strong class="text-dark d-block mb-1">Kemasan Satuan &amp; Label Brand</strong>
                  Opsi kemasan plastik OPP seal, pita rami, kartu ucapan, dan woven label merk Anda.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SIDEBAR CHECKLIST BRIEF -->
        <div class="col-12 col-lg-4">
          <div class="p-4 rounded-4 border bg-white shadow-sm sticky-top" style="top: 85px;">
            <h3 class="h5 fw-bold mb-2 text-dark">Minta Penawaran Resmi</h3>
            <p class="small text-muted mb-3">
              Kirimkan brief pesanan Anda untuk mendapatkan estimasi harga resmi dan preview mockup digital gratis:
            </p>

            <div class="p-3 bg-surface-alt rounded-3 border mb-3 small">
              <div class="text-muted mb-1">Item yang Dipilih:</div>
              <div class="fw-bold text-brand">{product.name}</div>
              <div class="text-muted small">Kode SKU: {product.id}</div>
            </div>

            <ol class="small text-muted ps-3 mb-4 d-flex flex-column gap-2">
              <li>Jumlah rencana pesanan (pcs).</li>
              <li>Target tanggal barang harus tiba di lokasi.</li>
              <li>Jumlah warna desain logo (sablon/DTF/bordir).</li>
              <li>Kota tujuan pengiriman (untuk hitung kargo).</li>
            </ol>

            <a 
              href={rfqWaUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-brand w-100 py-3 d-flex align-items-center justify-content-center gap-2 fw-semibold"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/>
              </svg>
              <span>Hubungi CS WhatsApp</span>
            </a>
            <div class="text-center text-muted small mt-2">
              Respons cepat via WhatsApp resmi kami.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION PRODUK TERKAIT / PILIHAN MODEL LAINNYA (Screenshot 2 Reference) -->
  {relatedProducts.length > 0 && (
    <section class="section-space bg-surface-alt border-top">
      <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
          <div>
            <span class="badge-accent mb-2">PILIHAN MODEL LAINNYA</span>
            <h2 class="section-title mb-1">Model Serupa dalam Kategori {category.shortName}</h2>
            <p class="text-muted small mb-0">Klik pada model di bawah untuk melihat rincian spesifikasi dan foto detailnya.</p>
          </div>
          <div class="mt-2 mt-md-0">
            <a href={`/produk/${category.slug}/`} class="btn btn-brand-outline btn-sm">
              Lihat Semua Koleksi {category.shortName}
            </a>
          </div>
        </div>

        <div class="row g-4">
          {relatedProducts.map(rel => (
            <div class="col-12 col-sm-6 col-lg-3">
              <article class="card h-100 rounded-4 bg-white border shadow-sm overflow-hidden d-flex flex-column">
                <div class="position-relative overflow-hidden border-bottom">
                  <a href={`/produk/${rel.slug}/`} class="d-block ratio ratio-4x3 bg-light">
                    <img 
                      src={rel.imageUrl} 
                      alt={rel.altText} 
                      width="400" 
                      height="300" 
                      class="w-100 h-100 object-fit-cover"
                      loading="lazy"
                    />
                  </a>
                  <span class="position-absolute top-0 end-0 m-2 badge bg-light text-dark border small" style="z-index: 2;">
                    {rel.id}
                  </span>
                </div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                  <h3 class="h6 fw-bold mb-1">
                    <a href={`/produk/${rel.slug}/`} class="text-decoration-none text-dark hover-brand">
                      {rel.name}
                    </a>
                  </h3>
                  <div class="small text-muted mb-2">{rel.material} • {rel.dimensions}</div>
                  <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-brand small">{rel.price || 'Grosir'}</span>
                    <a href={`/produk/${rel.slug}/`} class="btn btn-outline-dark btn-sm py-1 px-2" style="font-size: 0.75rem;">
                      Detail
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ SECTION -->
  <section class="section-space">
    <div class="container">
      <div class="max-w-75 mx-auto mb-4 text-center">
        <span class="badge-accent mb-2">TANYA JAWAB</span>
        <h2 class="section-title mb-2">Pertanyaan Seputar Pemesanan Model Ini</h2>
        <p class="section-subtitle mx-auto">Konsultasikan kebutuhan spesifik Anda langsung kepada tim kami.</p>
      </div>
      <div class="max-w-75 mx-auto">
        <FAQAccordion items={productFaqs} accordionId={`faq-${product.slug}`} />
      </div>
    </div>
  </section>

  <!-- Interactive Gallery Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const mainImg = document.getElementById('mainProductImg');
      const thumbBtns = document.querySelectorAll('.thumb-btn');

      if (!mainImg || thumbBtns.length === 0) return;

      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach(b => b.classList.remove('active', 'border-brand'));
          btn.classList.add('active', 'border-brand');

          const newSrc = btn.getAttribute('data-img-src');
          if (newSrc && mainImg) {
            mainImg.src = newSrc;
          }
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .thumb-btn {
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .thumb-btn:hover {
    transform: translateY(-2px);
  }
  .thumb-btn.active {
    border-color: var(--brand-primary, #173F38) !important;
    border-width: 2px !important;
  }
  .hover-brand:hover {
    color: var(--brand-primary, #173F38) !important;
  }
</style>
