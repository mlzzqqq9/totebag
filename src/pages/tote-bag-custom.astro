---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { faqs, getWhatsAppUrl } from '@/data/siteData';

const naskah = getNaskahById('21');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tote Bag Custom Logo', url: '/tote-bag-custom/' }
];

const customWaUrl = getWhatsAppUrl({
  notes: "Konsultasi teknik custom sablon / DTF / bordir",
  sourcePage: "/tote-bag-custom/"
});

// Combine specific FAQs from siteData and naskah 21
const customFaqs = [
  ...(naskah?.faqs.map((f, i) => ({
    id: `faq-custom-naskah-${i}`,
    question: f.question,
    answer: f.answer,
    category: 'desain' as const
  })) || []),
  ...faqs.filter(f => f.category === 'desain' || f.category === 'bahan')
];
---

<BaseLayout
  title={naskah?.seoTitle || "Tote Bag Custom Logo untuk Perusahaan dan Event | Tote Bag"}
  description={naskah?.metaDescription || "Layanan tote bag custom dengan berbagai teknik cetak logo: sablon manual rubber, DTF digital full-color, dan bordir komputer. Free preview mockup digital."}
  canonicalUrl={naskah?.canonical || "https://totebag.web.id/tote-bag-custom/"}
  jsonLd={naskah?.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">PANDUAN BRANDING &amp; CETAK</span>
          </div>
          <h1 class="hero-title mb-3" style="font-size: clamp(2rem, 3.4vw, 2.7rem);">
            {naskah?.h1 || "Tote Bag Custom Logo untuk Perusahaan dan Event"}
          </h1>
          <p class="lead text-muted fs-5 mb-4">
            Sesuaikan teknik aplikasi logo perusahaan dengan karakter kain dan desain visual Anda. Kami memastikan ketajaman warna, daya rekat tinta tahan cuci, serta hasil akhir yang rapi.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href={customWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-lg">
              Kirim Desain untuk Free Mockup
            </a>
            <a href="/produk/" class="btn btn-brand-outline btn-lg">
              Pilih Bahan Tas
            </a>
          </div>
        </div>
        <div class="col-12 col-lg-5">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
            <img 
              src="/media/tote-bag-custom-hero.webp" 
              alt="Koleksi tote bag custom logo perusahaan dan event" 
              width="600" 
              height="450" 
              class="w-100 h-100 object-fit-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Direct Answer & Core Insights from Naskah 21 -->
  {naskah?.directAnswer && (
    <section class="py-3">
      <div class="container">
        <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success shadow-sm">
          <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
            <span class="badge bg-success text-white">Ringkasan Seleksi Custom</span>
            <span class="fs-6">Prinsip Menentukan Desain Logo:</span>
          </div>
          <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
            {naskah.directAnswer}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Matrix Pilihan Cetak -->
  <section class="section-space bg-surface-alt mt-4">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">PERBANDINGAN TEKNIK CETAK</span>
        <h2 class="section-title mb-3">Pilih Teknik Branding yang Paling Sesuai</h2>
        <p class="section-subtitle mx-auto">
          Masing-masing teknik memiliki kelebihan spesifik tergantung pada kerumitan warna logo dan kuantiti pesanan.
        </p>
      </div>

      <div class="row g-4">
        <!-- Technique 1 -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">SABLON MANUAL</div>
            <h3 class="h5 fw-bold mb-2">Rubber &amp; Plastisol</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Pasta sablon diaplikasikan melalui screen kasa manual. Paling awet, lentur, dan paling hemat untuk pemesanan di atas 100 pcs dengan 1–3 warna solid.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Ideal untuk:</strong> Desain tipografi, logo vektor solid, tas blacu seminar, tote bag canvas greige.
            </div>
            <span class="small fw-bold text-success">✓ Biaya paling ekonomis per unit</span>
          </div>
        </div>

        <!-- Technique 2 -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">DIGITAL DTF</div>
            <h3 class="h5 fw-bold mb-2">Direct-to-Film Print</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Mencetak logo menggunakan mesin digital beresolusi tinggi ke film transfer lalu dipress panas. Mampu menghasilkan warna gradasi foto tanpa batasan warna.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Ideal untuk:</strong> Desain ilustrasi warna-warni, logo gradasi, foto, kuantiti fleksibel 50–200 pcs.
            </div>
            <span class="small fw-bold text-success">✓ Akurasi warna gradasi foto</span>
          </div>
        </div>

        <!-- Technique 3 -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">BORDIR KOMPUTER</div>
            <h3 class="h5 fw-bold mb-2">Benang Timbul Presisi</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Jahitan benang bordir mesin komputer dengan kerapatan tusuk tinggi. Menghasilkan tekstur timbul yang formal, eksklusif, dan tidak akan luntur dicuci berulang kali.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Ideal untuk:</strong> Tote bag canvas tebal 12 oz, seragam instansi, tas souvenir eksekutif BUMN.
            </div>
            <span class="small fw-bold text-success">✓ Kesan formal &amp; prestisius</span>
          </div>
        </div>

        <!-- Technique 4 -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">DEBOSS / ENGRAVE</div>
            <h3 class="h5 fw-bold mb-2">Hot Stamping &amp; Kulit</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Pengecapan plat logam panas ke permukaan kulit sintetis (PU) atau patch kulit imitasi. Memberikan kesan mewah minimalis tanpa menggunakan tinta berwarna.
            </p>
            <div class="p-2 rounded bg-light border small text-muted mb-3">
              <strong>Ideal untuk:</strong> Tote bag kulit sintetis VIP, corporate gift akhir tahun, hampers direksi.
            </div>
            <span class="small fw-bold text-success">✓ Sentuhan mewah tanpa tinta</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Showcase: Proses Cetak Heat Press DTF -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="p-4 p-lg-5 rounded-4 border bg-white shadow-sm">
        <div class="row align-items-center g-4 g-lg-5">
          <div class="col-12 col-lg-6">
            <span class="badge-accent mb-2">PROSES WORKSHOP NYATA</span>
            <h2 class="section-title mb-3">Aplikasi Heat Press DTF (Direct to Film) pada Tote Bag</h2>
            <p class="text-muted mb-4" style="line-height: 1.75;">
              Teknologi <strong>Direct to Film (DTF)</strong> merupakan metode cetak paling unggul untuk logo bergradasi halus, ilustrasi seni multi-warna, dan desain seminar kit dengan tipografi arsitektur rumit tanpa batasan warna.
            </p>
            <div class="d-flex flex-column gap-3 mb-4">
              <div class="d-flex align-items-start gap-2">
                <span class="badge rounded-circle bg-success-subtle text-success p-1 mt-1">✓</span>
                <span class="small text-muted"><strong>Suhu &amp; Tekanan Terkalibrasi:</strong> Dipanaskan menggunakan mesin flat heat press pada suhu 160°C–165°C dengan tekanan pneumatik konsisten, menjamin lem hot-melt meresap ke pori-pori kain canvas dan blacu.</span>
              </div>
              <div class="d-flex align-items-start gap-2">
                <span class="badge rounded-circle bg-success-subtle text-success p-1 mt-1">✓</span>
                <span class="small text-muted"><strong>Lapisan Elastis &amp; Tahan Cuci:</strong> Tinta DTF berbasis air memiliki elastisitas tinggi sehingga tidak kaku, tidak pecah saat dilipat, dan tahan cuci berkali-kali.</span>
              </div>
              <div class="d-flex align-items-start gap-2">
                <span class="badge rounded-circle bg-success-subtle text-success p-1 mt-1">✓</span>
                <span class="small text-muted"><strong>Kuantiti Fleksibel &amp; Cepat:</strong> Tanpa biaya pembuatan plat/screen film manual, sangat efisien untuk kuantiti 50 hingga ribuan pcs dengan waktu produksi singkat.</span>
              </div>
            </div>
            <a href="/panduan-file-desain/" class="btn btn-brand-outline">
              Pelajari Panduan File Siap Cetak &rarr;
            </a>
          </div>
          <div class="col-12 col-lg-6">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
              <img 
                src="/media/proses-cetak-dtf-heat-press.webp" 
                alt="Proses peeling film cetak digital transfer DTF heat press pada tote bag di workshop" 
                width="800" 
                height="600" 
                loading="lazy"
                class="w-100 h-100 object-fit-cover"
              />
            </div>
            <p class="text-center text-muted small mt-2 mb-0">
              Dokumentasi Workshop: Proses pengupasan film transfer (peeling) setelah aplikasi heat press DTF pada tote bag kain.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Panduan File Desain & Mockup -->
  <section class="section-space">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6">
          <span class="badge-accent mb-2">PANDUAN FILE DESAIN</span>
          <h2 class="section-title mb-3">Menyiapkan File Logo untuk Hasil Cetak Maksimal</h2>
          <p class="text-muted mb-4">
            Agar proses proofing cepat dan tidak terjadi distorsi resolusi, kami menyarankan Anda menyiapkan file desain sesuai spesifikasi standar industri grafis:
          </p>

          <div class="d-flex flex-column gap-3">
            <div class="p-3 rounded-3 bg-surface-alt border">
              <div class="fw-bold text-dark mb-1">1. Format Vektor Direkomendasikan</div>
              <p class="small text-muted mb-0">File Adobe Illustrator (.AI), CorelDraw (.CDR), atau PDF Vector. Pastikan seluruh font teks telah di-convert to curves / outline.</p>
            </div>
            <div class="p-3 rounded-3 bg-surface-alt border">
              <div class="fw-bold text-dark mb-1">2. File Raster Beresolusi Tinggi</div>
              <p class="small text-muted mb-0">Jika menggunakan PNG atau PSD, pastikan resolusi minimal 300 DPI dengan background transparan agar tidak terjadi pixelation/buram.</p>
            </div>
            <div class="p-3 rounded-3 bg-surface-alt border">
              <div class="fw-bold text-dark mb-1">3. Panduan Kode Warna</div>
              <p class="small text-muted mb-0">Sertakan kode warna Pantone (PMS) atau CMYK jika organisasi Anda memiliki pedoman brand identity yang ketat.</p>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="p-4 p-lg-5 rounded-4 bg-brand-dark text-white">
            <h3 class="h4 fw-bold mb-3 text-white">Layanan Simulasi Mockup Digital Gratis</h3>
            <p class="text-white-50 small mb-4">
              Belum yakin bagaimana tampilan logo Anda di atas tote bag canvas atau blacu? Kirimkan logo Anda via WhatsApp, tim desainer grafis kami akan membuatkan simulasi digital 2D secara gratis.
            </p>
            <div class="p-3 rounded-3 bg-white text-dark mb-4">
              <div class="fw-bold small mb-1">Yang Anda Dapatkan:</div>
              <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-1">
                <li>✓ Preview proporsi ukuran logo terhadap bidang tas</li>
                <li>✓ Rekomendasi penempatan (tengah, sudut bawah, atau saku)</li>
                <li>✓ Perkiraan akurasi kontras warna logo terhadap kain</li>
              </ul>
            </div>
            <a href={customWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp w-100">
              Kirim File Logo via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Section from Naskah 21 -->
  {naskah?.bodyHtml && (
    <section class="section-space-sm pt-0">
      <div class="container">
        <div class="p-4 rounded-4 bg-light border">
          <h2 class="h5 fw-bold text-dark mb-3">Panduan Praktis Pengadaan Logo Custom</h2>
          <div class="article-content-body text-muted small" style="line-height: 1.8;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mx-auto mb-4 text-center">
        <h2 class="section-title mb-2">FAQ Custom Sablon &amp; Branding</h2>
        <p class="section-subtitle mx-auto">Pertanyaan seputar batasan warna, posisi sablon, dan file logo.</p>
      </div>
      <div class="max-w-75 mx-auto">
        <FAQAccordion items={customFaqs} accordionId="customPageFaq" />
      </div>
    </div>
  </section>
</BaseLayout>
