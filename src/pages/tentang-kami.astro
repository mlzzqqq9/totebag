---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { businessProfile, getWhatsAppUrl } from '@/data/siteData';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Tote Bag', url: '/tentang-kami/' }
];

const waConsultUrl = "https://wa.me/6282131087971?text=" + encodeURIComponent("Halo tim Tote Bag, saya ingin konsultasi spesifikasi dan meminta penawaran tote bag custom.");

// JSON-LD Schema sesuai Content Brief ID: 109
const aboutPageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://totebag.web.id/#organization",
      "name": "Tote Bag",
      "url": "https://totebag.web.id/",
      "telephone": "+6282131087971",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kedungkandang",
        "addressLocality": "Malang",
        "addressRegion": "Jawa Timur",
        "postalCode": "65136",
        "addressCountry": "ID"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://totebag.web.id/#website",
      "name": "Tote Bag",
      "url": "https://totebag.web.id/",
      "publisher": {
        "@id": "https://totebag.web.id/#organization"
      }
    },
    {
      "@type": "AboutPage",
      "@id": "https://totebag.web.id/tentang-kami/#webpage",
      "url": "https://totebag.web.id/tentang-kami/",
      "name": "Tentang Tote Bag: Profil dan Layanan",
      "description": "Pelajari tentang tote bag: profil dan layanan dengan panduan spesifikasi, pertimbangan bahan dan langkah memilih produk. Konsultasikan kebutuhan tote bag Anda",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "about": {
        "@type": "Thing",
        "name": "Tentang Tote Bag: Profil dan Layanan"
      }
    }
  ]
};
---

<BaseLayout
  title="Tentang Tote Bag: Profil dan Layanan | Tote Bag"
  description="Pelajari tentang tote bag: profil dan layanan dengan panduan spesifikasi, pertimbangan bahan dan langkah memilih produk. Konsultasikan kebutuhan tote bag Anda"
  canonicalUrl="https://totebag.web.id/tentang-kami/"
  jsonLd={aboutPageSchema}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Page Header & Direct Answer (AEO) -->
  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-850">
        <span class="badge-accent mb-2">PROFIL &amp; LAYANAN</span>
        <h1 class="hero-title mb-4" style="font-size: clamp(2.1rem, 3.8vw, 3.2rem);">
          Tentang Tote Bag: Profil dan Layanan
        </h1>

        <!-- Direct AEO Box -->
        <div class="p-4 rounded-4 bg-white border border-start-4 border-start-success shadow-sm mb-4">
          <p class="lead fs-5 text-dark mb-0 fw-normal" style="line-height: 1.7;">
            <strong>Tote Bag</strong> adalah nama website yang memperkenalkan pilihan tote bag untuk kebutuhan perusahaan, instansi, event, dan usaha. Kami berbasis di Malang dan menyediakan kanal konsultasi agar calon pembeli dapat menanyakan produk serta spesifikasi yang dibutuhkan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Body -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="row g-5">
        <!-- Main Content -->
        <div class="col-12 col-lg-8">

          <!-- Section: Informasi Utama -->
          <div class="mb-5">
            <h2 class="h3 fw-bold mb-3 text-dark">Informasi Utama</h2>
            <p class="text-muted" style="line-height: 1.75;">
              Halaman ini menjelaskan fokus website, pilihan penggunaan produk, dan cara menghubungi tim. Informasi identitas, alamat usaha lengkap, legalitas, dan dokumentasi operasional perlu diisi sesuai dokumen usaha yang telah diverifikasi.
            </p>
            <div class="p-4 rounded-3 bg-surface-alt border mb-4">
              <h3 class="h5 fw-bold mb-3 text-dark">Pertanyaan Utama Pembeli</h3>
              <p class="text-muted mb-0" style="line-height: 1.7;">
                <strong>Apa yang paling penting saat mempertimbangkan tentang tote bag: profil dan layanan?</strong> Pada praktiknya, pembeli perlu mendefinisikan fungsi tas, kebutuhan kapasitas, target kualitas, dan batas anggaran. Spesifikasi teknis sebaiknya dinyatakan secara tertulis supaya contoh dan hasil akhir dapat dibandingkan.
              </p>
            </div>
          </div>

          <!-- Section: Apa yang Perlu Dipersiapkan -->
          <div class="mb-5">
            <h2 class="h3 fw-bold mb-3 text-dark">Apa yang Perlu Dipersiapkan</h2>
            <p class="text-muted" style="line-height: 1.75;">
              Bila Anda menyiapkan kebutuhan pengadaan, informasikan jenis acara, jumlah, ukuran, material, logo, serta tenggat yang diinginkan. Tim kemudian dapat meninjau kemungkinan spesifikasi dan memberikan informasi penawaran.
            </p>
            <div class="p-4 rounded-3 bg-white border mb-3">
              <h4 class="h6 fw-bold text-dark mb-2">Checklist Fisik Saat Memeriksa Contoh Tote Bag:</h4>
              <ul class="text-muted small mb-0 d-flex flex-column gap-2 ps-3">
                <li><strong>Ukuran Lebar &amp; Tinggi:</strong> Pastikan proporsi sesuai isi muatan (dokumen A4, map folio, atau laptop).</li>
                <li><strong>Gusset (Alas/Sisi Samping):</strong> Cek ketersediaan alas jika tas diperuntukkan membawa tumbler atau box konsumsi.</li>
                <li><strong>Panjang &amp; Lebar Tali:</strong> Periksa kenyamanan saat disampirkan di pundak dan kekuatan sambungan silang (jahitan X-box).</li>
                <li><strong>Penutup &amp; Bagian Dalam:</strong> Konfirmasi opsi resleting, kancing magnet, serta ada/tidaknya furing pelapis bagian dalam.</li>
              </ul>
            </div>
            <p class="small text-muted fst-italic">
              *Catatan teknis: Jangan hanya mengandalkan foto karena skala dan tekstur sering sulit dinilai dari gambar tunggal.
            </p>
          </div>

          <!-- Section: Langkah Berikutnya -->
          <div class="mb-5">
            <h2 class="h3 fw-bold mb-3 text-dark">Langkah Berikutnya</h2>
            <p class="text-muted" style="line-height: 1.75;">
              Untuk pemesanan B2B, susun ringkasan kebutuhan berisi: tujuan penggunaan, jumlah unit, ukuran, material, warna, logo dan metode custom, kota tujuan, tanggal penggunaan, serta informasi kontak penanggung jawab. Minta penawaran yang merinci aspek-aspek tersebut agar bisa ditinjau dan disetujui.
            </p>
          </div>

          <!-- Section: Kesalahan yang Perlu Dihindari -->
          <div class="mb-5">
            <h2 class="h3 fw-bold mb-3 text-dark">Kesalahan yang Perlu Dihindari</h2>
            <div class="p-4 rounded-4 bg-white border border-danger-subtle">
              <ul class="d-flex flex-column gap-3 mb-0 text-muted ps-3">
                <li><strong>Memilih produk hanya berdasarkan nama bahan:</strong> Kain "Canvas" atau "Blacu" memiliki variasi ketebalan dan tenunan (oz) yang berbeda-beda; mintalah keterangan gramasi spesifik.</li>
                <li><strong>Menyetujui logo tanpa ukuran pasti:</strong> Pastikan dimensi cetak (contoh: A4 atau 15 × 15 cm) dan titik penempatan logo disepakati di dalam lembar kerja digital (mockup).</li>
                <li><strong>Mengabaikan jadwal distribusi antarkota:</strong> Perhitungkan durasi ekspedisi kargo (1–3 hari kerja) di luar waktu proses produksi garmen dan sablon.</li>
                <li><strong>Mempublikasikan klaim harga serta hasil proyek yang belum terverifikasi:</strong> Apabila keterangan spesifikasi masih belum lengkap, lakukan konfirmasi tertulis sebelum memutuskan.</li>
              </ul>
            </div>
          </div>

          <!-- Section: Pertanyaan yang Sering Diajukan (FAQ) -->
          <div class="mb-5">
            <h2 class="h3 fw-bold mb-4 text-dark">Pertanyaan yang Sering Diajukan</h2>
            <div class="accordion accordion-custom" id="faqAboutPage">
              <div class="accordion-item mb-3">
                <h3 class="accordion-header" id="headingAbout1">
                  <button class="accordion-button fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAbout1" aria-expanded="true" aria-controls="collapseAbout1">
                    Apa yang perlu dipastikan sebelum memesan?
                  </button>
                </h3>
                <div id="collapseAbout1" class="accordion-collapse collapse show" aria-labelledby="headingAbout1" data-bs-parent="#faqAboutPage">
                  <div class="accordion-body text-muted">
                    Pastikan fungsi tas, ukuran, pilihan bahan, desain, jumlah, jadwal, dan alamat pengiriman. Penawaran final bergantung pada spesifikasi yang disetujui.
                  </div>
                </div>
              </div>

              <div class="accordion-item mb-3">
                <h3 class="accordion-header" id="headingAbout2">
                  <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAbout2" aria-expanded="false" aria-controls="collapseAbout2">
                    Apakah harga dan minimum order sudah pasti?
                  </button>
                </h3>
                <div id="collapseAbout2" class="accordion-collapse collapse" aria-labelledby="headingAbout2" data-bs-parent="#faqAboutPage">
                  <div class="accordion-body text-muted">
                    Belum. Harga dan minimum pesanan harus dikonfirmasi berdasarkan produk, spesifikasi dan jumlah yang diminta.
                  </div>
                </div>
              </div>

              <div class="accordion-item mb-3">
                <h3 class="accordion-header" id="headingAbout3">
                  <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAbout3" aria-expanded="false" aria-controls="collapseAbout3">
                    Bisakah mengirim logo untuk diperiksa?
                  </button>
                </h3>
                <div id="collapseAbout3" class="accordion-collapse collapse" aria-labelledby="headingAbout3" data-bs-parent="#faqAboutPage">
                  <div class="accordion-body text-muted">
                    Calon pembeli dapat menyiapkan file logo dan contoh penempatan, kemudian mengonfirmasi format serta kemampuan pengerjaan melalui WhatsApp.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section: Konsultasi dan Langkah Selanjutnya -->
          <div class="p-4 p-md-5 rounded-4 bg-brand text-white mb-4">
            <h2 class="h4 fw-bold mb-3">Konsultasi dan Langkah Selanjutnya</h2>
            <p class="text-white-50 mb-4" style="line-height: 1.7;">
              Jika Anda membutuhkan tote bag untuk perusahaan, instansi, UMKM atau event, kirimkan spesifikasi dan jumlah melalui <strong>WhatsApp +62 821-3108-7971</strong>. Informasi penawaran akhir mengikuti konfirmasi produk, jumlah, desain, dan layanan yang benar-benar tersedia.
            </p>
            <div class="d-flex flex-wrap gap-3">
              <a href={waConsultUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/>
                </svg>
                Konsultasi WhatsApp: +62 821-3108-7971
              </a>
              <a href="/kontak/" class="btn btn-outline-light">
                Formulir Kontak &amp; RFQ &rarr;
              </a>
            </div>
          </div>

          <!-- Internal Link Sesuai Brief -->
          <div class="pt-3 border-top small text-muted">
            <strong class="text-dark">Baca juga:</strong>{' '}
            <a href="/tote-bag-custom/" class="text-decoration-none fw-semibold text-success">Tote Bag Custom</a> ·{' '}
            <a href="/layanan/" class="text-decoration-none fw-semibold text-success">Layanan Pengiriman Kota</a> ·{' '}
            <a href="/kontak/" class="text-decoration-none fw-semibold text-success">Kontak</a>
          </div>

        </div>

        <!-- Sidebar / Trust & Contact Info -->
        <div class="col-12 col-lg-4">
          <div class="position-sticky" style="top: 85px;">
            <div class="p-4 rounded-4 bg-white border shadow-sm mb-4">
              <h3 class="h5 fw-bold mb-3 text-dark">Ringkasan Operasional</h3>
              <div class="d-flex flex-column gap-3 small text-muted">
                <div>
                  <strong class="text-dark d-block">Nama Website / Entitas:</strong>
                  <span>Tote Bag (totebag.web.id)</span>
                </div>
                <div>
                  <strong class="text-dark d-block">Basis Workshop:</strong>
                  <span>Kedungkandang, Kota Malang, Jawa Timur (65136)</span>
                </div>
                <div>
                  <strong class="text-dark d-block">Kanal Konsultasi:</strong>
                  <a href={waConsultUrl} target="_blank" rel="noopener noreferrer" class="text-success fw-bold text-decoration-none">
                    +62 821-3108-7971
                  </a>
                </div>
                <div>
                  <strong class="text-dark d-block">Jangkauan Distribusi:</strong>
                  <span>Pengiriman kargo antarkota ke seluruh Indonesia</span>
                </div>
                <div>
                  <strong class="text-dark d-block">Opsi Pengadaan:</strong>
                  <span>Canvas, Blacu, Spunbond, dan Kulit Sintetis Custom</span>
                </div>
              </div>
            </div>

            <!-- Quick Link Box -->
            <div class="p-4 rounded-4 bg-surface-alt border">
              <h4 class="h6 fw-bold mb-3 text-dark">Panduan Sesuai Kebutuhan</h4>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                <li><a href="/produk/tote-bag-canvas/" class="text-decoration-none text-dark d-flex justify-content-between"><span>Tote Bag Canvas</span> &rarr;</a></li>
                <li><a href="/produk/tote-bag-blacu/" class="text-decoration-none text-dark d-flex justify-content-between"><span>Tote Bag Blacu</span> &rarr;</a></li>
                <li><a href="/produk/tote-bag-spunbond/" class="text-decoration-none text-dark d-flex justify-content-between"><span>Tote Bag Spunbond</span> &rarr;</a></li>
                <li><a href="/cara-pesan/" class="text-decoration-none text-dark d-flex justify-content-between"><span>Alur Pemesanan B2B</span> &rarr;</a></li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
