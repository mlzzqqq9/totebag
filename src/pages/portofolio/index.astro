---
// src/pages/portofolio/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import ClientSlider from '../../components/ui/ClientSlider.astro';
import TestimonialSection from '../../components/ui/TestimonialSection.astro';
import { getNaskahById } from '../../utils/naskah';
import { getWhatsAppUrl } from '../../data/siteData';

// Ambil data naskah portofolio (ID: 101)
const naskah = getNaskahById('101');

// Fixed Breadcrumbs items (using name & url schema)
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Portofolio', url: '/portofolio/' }
];

// 12 Curated Aesthetic Studio Photos (Penuh, Rapi, & Tanpa Celah Kosong)
const galleryPhotos = [
  {
    id: "foto-1",
    image: "/media/lifestyle-tote-bag-green-energy.webp",
    alt: "Dokumentasi tote bag Danantara Indonesia PLN Green Energy for Better Future",
    title: "Tote Bag Danantara PLN Green Energy",
    client: "Danantara Indonesia, PLN & NGKI",
    material: "Kain Hitam Twill + Tali Webbing Tan",
    category: "dinir",
    spanClass: "span-wide"
  },
  {
    id: "foto-2",
    image: "/media/tote-bag-canvas-ethnic-tenun.webp",
    alt: "Tote bag canvas kombinasi tenun ikat etnik nusantara dan aksen kulit",
    title: "Canvas Tenun Etnik Nusantara Series",
    client: "Dekranasda & Komunitas Kreatif",
    material: "Canvas Greige + Tenun Ikat Asli",
    category: "canvas",
    spanClass: "span-standard"
  },
  {
    id: "foto-3",
    image: "/media/quality-control-inspection-checklist.webp",
    alt: "Meja inspeksi quality control tote bag aksara kost dengan checklist standar mutu",
    title: "Meja Inspeksi QC & Standar Mutu",
    client: "Standar Mutu QC Workshop Malang",
    material: "Canvas Katun + Tag QC Passed",
    category: "canvas",
    spanClass: "span-standard"
  },
  {
    id: "foto-4",
    image: "/media/tote-bag-mika.webp",
    alt: "Tote bag mika transparan PVC aesthetic dompet dalam",
    title: "Aesthetic Clear PVC Mika Tote Bag",
    client: "Kementerian & Exhibition Expo",
    material: "Mika Transparan 0.5 mm",
    category: "mika",
    spanClass: "span-standard"
  },
  {
    id: "foto-5",
    image: "/media/portfolio-blacu-350pcs.webp",
    alt: "Dokumentasi produksi heat press 350 pcs tote bag blacu seminar nasional teknologi SMK Telkom Malang",
    title: "Pengadaan 350 Pcs Tote Bag Seminar Teknologi",
    client: "SMK Telkom Malang & Seminar",
    material: "Blacu Hitam + Tali Webbing Tan",
    category: "blacu",
    spanClass: "span-wide"
  },
  {
    id: "foto-6",
    image: "/media/tote-bag-seminar-kit-canvas.webp",
    alt: "Paket tote bag canvas seminar nasional 2026 lengkap dengan tumbler stainless dan buku catatan",
    title: "Paket Canvas Seminar Kit Nasional 2026",
    client: "Panitia Konferensi & Seminar Akademik",
    material: "Canvas Broken White + Tali Katun",
    category: "blacu",
    spanClass: "span-standard"
  },
  {
    id: "foto-7",
    image: "/media/tote-bag-black-green-energy.webp",
    alt: "Studio foto tote bag hitam Danantara Indonesia PLN Green Energy for Better Future",
    title: "Tote Bag Danantara Green Energy Series",
    client: "Danantara Indonesia & BUMN",
    material: "Canvas Twill Hitam + Tali Webbing Tan",
    category: "canvas",
    spanClass: "span-standard"
  },
  {
    id: "foto-8",
    image: "/media/tote-bag-cordura.webp",
    alt: "Tote bag cordura 1000D tactical heavy duty waterproof",
    title: "Cordura 1000D Tactical Onboarding",
    client: "PT Pamapersada (PAMA)",
    material: "Cordura 1000D Heavy Duty",
    category: "cordura",
    spanClass: "span-standard"
  },
  {
    id: "foto-9",
    image: "/media/lifestyle-tote-bag-navy-batik.webp",
    alt: "Tote bag navy blue kombinasi batik Mohon Diri Ny Tri Kuncoro",
    title: "Navy Blue Batik Motif Tradisional",
    client: "Instansi & Kehormatan Purnatugas",
    material: "Canvas Twill Navy + Sablon Batik",
    category: "denim",
    spanClass: "span-wide"
  },
  {
    id: "foto-10",
    image: "/media/tote-bag-spunbond-color.webp",
    alt: "Tumpukan goodie bag spunbond warna warni ramah lingkungan",
    title: "Eco Spunbond Non-Woven Folded",
    client: "SMK Telkom & Event Edukasi",
    material: "Spunbond 100 gsm Tebal",
    category: "spunbond",
    spanClass: "span-standard"
  },
  {
    id: "foto-11",
    image: "/media/tote-bag-satin.webp",
    alt: "Tote bag satin printing full sublimasi botanical warna tajam",
    title: "Satin Printing Full Color Sublimasi",
    client: "Dinas Pariwisata & Budaya",
    material: "Satin Bridal Halus Glossy",
    category: "satin",
    spanClass: "span-standard"
  },
  {
    id: "foto-12",
    image: "/media/packing-kargo-tote-bag.webp",
    alt: "Pengemasan rapi pesanan tote bag ke kardus kargo ekspedisi",
    title: "Pengemasan Karton Kargo Siap Ekspedisi",
    client: "PT Putra Perkasa Abadi & VIP",
    material: "Karton Double Wall + Lakban Segel",
    category: "canvas",
    spanClass: "span-standard"
  }
];

const generalWaUrl = getWhatsAppUrl({
  notes: "Halo Tim ToteBag, saya melihat galeri portofolio website dan ingin konsultasi spesifikasi tote bag untuk kebutuhan instansi/event kami.",
  sourcePage: "/portofolio/"
});
---

<BaseLayout
  title={naskah?.seoTitle || "Galeri Portofolio Hasil Produksi Tote Bag Custom | Tote Bag"}
  description={naskah?.metaDescription || "Dokumentasi foto fisik pengerjaan pesanan tote bag custom untuk korporasi BUMN, seminar perguruan tinggi, perbankan, dan instansi nasional."}
  canonicalUrl={naskah?.canonical || "https://totebag.web.id/portofolio/"}
  jsonLd={naskah?.schemaJson}
>
  
  <!-- 1. Luxury Hero Header with Background Image & Breadcrumbs -->
  <header class="portfolio-hero-header position-relative overflow-hidden text-white">
    <div class="hero-bg-cover" style="background-image: url('/media/foto-giftset.jpg');"></div>
    <div class="hero-gradient-overlay"></div>
    
    <div class="container position-relative z-2 py-5 my-md-2">
      <!-- Breadcrumb inside hero header -->
      <div class="hero-breadcrumb-wrap mb-3">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="max-w-75">
        <span class="badge-gold-hero mb-3 d-inline-block">DOKUMENTASI HASIL PRODUKSI B2B</span>
        <h1 class="display-6 fw-bold mb-3 text-white" style="letter-spacing: -0.02em;">
          Portofolio &amp; Hasil Karya Tote Bag Custom
        </h1>
        <p class="hero-lead-text text-white-50 mb-4" style="line-height: 1.7; font-size: 1.08rem; max-width: 680px;">
          Koleksi foto fisik pengerjaan pesanan tas suvenir korporat, seminar kit akademik, dan goodie bag promosi untuk lebih dari 100+ instansi BUMN, kementerian, universitas, dan swasta nasional.
        </p>
        
        <div class="d-flex flex-wrap gap-2 text-white-50 small">
          <span class="hero-trust-tag">✓ Jahitan Double-Stitch Nilon</span>
          <span class="hero-trust-tag">✓ Sablon DTF Tahan Cuci</span>
          <span class="hero-trust-tag">✓ 100% Zero Defect QC</span>
          <span class="hero-trust-tag">✓ Ekspedisi Kargo Seluruh Indonesia</span>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Testimoni Klien di Bawah Header (Layout Proporsional & Bebas Void) -->
  <TestimonialSection 
    title="Dipercaya Oleh Lebih dari 100+ Mitra Pengadaan Nasional"
    subtitle="Simak testimoni langsung dari pejabat pembuat komitmen, manajemen CSR, dan koordinator logistik instansi yang secara rutin mempercayakan produksi tas tote bag kepada kami."
  />

  <!-- 3. Galeri Foto Produk Jadi Estetik (12 Foto, Dense Grid, Tanpa Celah Kosong) -->
  <section class="section-space py-5 bg-white border-top">
    <div class="container">
      
      <!-- Section Header -->
      <div class="text-center max-w-75 mx-auto mb-4">
        <span class="badge-accent">KATALOG VISUAL PRODUK</span>
        <h2 class="h2 fw-bold text-dark mt-2 mb-2" style="letter-spacing: -0.02em;">
          Galeri Hasil Karya &amp; Suvenir Fisik
        </h2>
        <p class="text-muted small" style="line-height: 1.6; max-width: 620px; margin: 0 auto;">
          Semua foto adalah dokumentasi asli dari pesanan nyata klien kami dengan berbagai variasi bahan baku, teknik cetak logo, dan paket aksesori.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="d-flex flex-wrap justify-content-center gap-2 mb-4 mb-md-5" id="galleryFilters">
        <button class="filter-pill active" data-filter="all">Semua Foto (12)</button>
        <button class="filter-pill" data-filter="canvas">Canvas &amp; Blacu</button>
        <button class="filter-pill" data-filter="dinir">Dinir &amp; Cordura</button>
        <button class="filter-pill" data-filter="mika">Mika Transparan</button>
        <button class="filter-pill" data-filter="denim">Denim &amp; Satin</button>
        <button class="filter-pill" data-filter="spunbond">Spunbond</button>
      </div>

      <!-- Asymmetric Aesthetic Photo Gallery (Dense Grid - 0 Whitespace Gaps) -->
      <div class="photo-dense-grid" id="photoGrid">
        {galleryPhotos.map((item, index) => {
          const itemWa = getWhatsAppUrl({
            notes: `Halo Tim ToteBag, saya tertarik memesan model seperti di portofolio foto: "${item.title}" (${item.material}) untuk instansi kami. Boleh minta info harga dan estimasi produksinya?`,
            sourcePage: "/portofolio/"
          });
          return (
            <div 
              class={`photo-item-tile ${item.spanClass}`} 
              data-category={item.category}
            >
              <a 
                href={itemWa} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="photo-link"
                title={`Konsultasi model ${item.title}`}
              >
                <img 
                  src={item.image} 
                  alt={item.alt}
                  loading={index < 4 ? "eager" : "lazy"}
                  decoding="async"
                  class="photo-asset"
                />
                
                <!-- Floating Glassmorphism Hover Overlay -->
                <div class="photo-card-overlay">
                  <div class="overlay-top">
                    <span class="client-pill-overlay">{item.client}</span>
                  </div>
                  <div class="overlay-bottom">
                    <span class="material-pill-overlay">{item.material}</span>
                    <h3 class="photo-card-title">{item.title}</h3>
                    <div class="cta-hint">
                      <span>Tanya Spesifikasi Model Ini &rarr;</span>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          );
        })}
      </div>

      <!-- Single Luxury CTA Bar Underneath Gallery -->
      <div class="mt-5 p-4 p-md-5 rounded-4 cta-gallery-banner text-center text-white position-relative overflow-hidden shadow-sm">
        <div class="position-relative z-1 max-w-75 mx-auto">
          <span class="badge px-3 py-2 rounded-pill mb-3" style="background: rgba(193, 135, 85, 0.3); color: #F5D3B3; font-weight: 500;">
            KUSTOMISASI BEBAS &amp; MOCKUP GRATIS
          </span>
          <h3 class="h3 fw-bold mb-3 text-white">Ingin Buat Tote Bag Serupa dengan Logo &amp; Ukuran Sendiri?</h3>
          <p class="text-white-50 mb-4" style="line-height: 1.7; font-size: 1.05rem;">
            Kirimkan logo atau referensi model yang Anda sukai. Tim desainer kami siap membuatkan simulasi digital 3D dan mengirimkan sampel fisik ke kantor Anda.
          </p>
          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a 
              href={generalWaUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-gold px-4 py-3 fw-bold shadow-sm d-inline-flex align-items-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/>
              </svg>
              <span>Konsultasi Desain &amp; Minta Sampel</span>
            </a>
            <a href="/harga-tote-bag-custom/" class="btn btn-outline-light px-4 py-3 fw-medium">
              Lihat Simulasi Harga
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. Client Slider Showcase (Klien Resmi Kita - Auto Scroll Mulus) -->
  <ClientSlider 
    title="Dokumentasi Brand &amp; Klien Partner Resmi"
    subtitle="Arsip visual pengadaan tas goodie bag untuk instansi kementerian, BUMN, perbankan, dan universitas."
  />

  <!-- 5. FAQ Section -->
  <section class="section-space-sm bg-white py-5">
    <div class="container">
      <div class="max-w-75 mx-auto">
        <div class="text-center mb-4">
          <span class="badge-accent">PERTANYAAN UMUM</span>
          <h2 class="h3 fw-bold text-dark mt-2 mb-2">FAQ Seputar Portofolio &amp; Pengadaan</h2>
          <p class="text-muted small">Informasi mengenai izin produksi, contoh fisik sampel, dan ketentuan kerahasiaan brand (NDA).</p>
        </div>
        <FAQAccordion items={naskah?.faqs || []} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* Hero Header Styling */
.portfolio-hero-header {
  min-height: 340px;
  background-color: #173F38;
}

.hero-bg-cover {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: blur(2px);
  transform: scale(1.05);
  opacity: 0.35;
}

.hero-gradient-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(23, 63, 56, 0.94) 0%, rgba(15, 45, 40, 0.90) 100%);
}

.badge-gold-hero {
  background: rgba(193, 135, 85, 0.25);
  color: #F5D3B3;
  border: 1px solid rgba(193, 135, 85, 0.45);
  padding: 0.35rem 0.9rem;
  border-radius: 50rem;
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.hero-trust-tag {
  display: inline-block;
  padding: 0.3rem 0.75rem;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  color: #E2ECE8;
  font-size: 0.8rem;
}

/* Filter Pills */
.filter-pill {
  padding: 0.5rem 1.15rem;
  border-radius: 50rem;
  border: 1px solid rgba(23, 63, 56, 0.12);
  background: #ffffff;
  color: #173F38;
  font-weight: 500;
  font-size: 0.86rem;
  cursor: pointer;
  transition: all 0.2s ease;
}
.filter-pill:hover,
.filter-pill.active {
  background: #173F38;
  color: #ffffff;
  border-color: #173F38;
  box-shadow: 0 4px 12px rgba(23, 63, 56, 0.15);
}

/* Dense 4-Column Asymmetric Photo Grid (No empty gaps guaranteed) */
.photo-dense-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 240px;
  grid-auto-flow: dense;
  gap: 18px;
}

@media (max-width: 991px) {
  .photo-dense-grid {
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 220px;
    gap: 14px;
  }
}
@media (max-width: 575px) {
  .photo-dense-grid {
    grid-template-columns: 1fr;
    grid-auto-rows: 230px;
    gap: 14px;
  }
}

.photo-item-tile {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #F5F7F6;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.span-wide {
  grid-column: span 2;
}
.span-standard {
  grid-column: span 1;
}

@media (max-width: 575px) {
  .span-wide,
  .span-standard {
    grid-column: span 1;
  }
}

.photo-item-tile:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 28px rgba(23, 63, 56, 0.12);
}

.photo-link {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
  text-decoration: none;
}

.photo-asset {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}

.photo-item-tile:hover .photo-asset {
  transform: scale(1.03);
}

/* Glassmorphism Hover Overlay */
.photo-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(15, 45, 40, 0.88) 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 16px;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.photo-item-tile:hover .photo-card-overlay {
  opacity: 1;
}

.client-pill-overlay {
  display: inline-block;
  padding: 0.25rem 0.65rem;
  background: rgba(255, 255, 255, 0.92);
  color: #173F38;
  font-weight: 600;
  font-size: 0.74rem;
  border-radius: 50rem;
  backdrop-filter: blur(6px);
}

.material-pill-overlay {
  display: inline-block;
  color: #E2B285;
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.4px;
  margin-bottom: 2px;
}

.photo-card-title {
  color: #ffffff;
  font-size: 0.98rem;
  font-weight: 700;
  margin-bottom: 4px;
  line-height: 1.3;
}

.cta-hint {
  color: rgba(255, 255, 255, 0.85);
  font-size: 0.78rem;
  font-weight: 500;
}

/* CTA Banner Underneath */
.cta-gallery-banner {
  background: linear-gradient(135deg, #173F38 0%, #0F2D28 100%);
}

.btn-gold {
  background: linear-gradient(135deg, #C18755 0%, #A06738 100%);
  color: #ffffff;
  border: none;
  border-radius: 10px;
  transition: all 0.25s ease;
}
.btn-gold:hover {
  background: linear-gradient(135deg, #D49866 0%, #B27544 100%);
  color: #ffffff;
  transform: translateY(-2px);
}
</style>

<script>
(function() {
  const filterBtns = document.querySelectorAll('.filter-pill');
  const items = document.querySelectorAll('.photo-item-tile');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all') {
          (item as HTMLElement).style.display = '';
        } else if (filter === 'canvas' && (cat === 'canvas' || cat === 'blacu')) {
          (item as HTMLElement).style.display = '';
        } else if (filter === 'dinir' && (cat === 'dinir' || cat === 'cordura')) {
          (item as HTMLElement).style.display = '';
        } else if (filter === 'denim' && (cat === 'denim' || cat === 'satin')) {
          (item as HTMLElement).style.display = '';
        } else if (cat === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
})();
</script>
