---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { portfolioItems, getWhatsAppUrl } from '@/data/siteData';

export async function getStaticPaths() {
  return portfolioItems.map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Portofolio', url: '/portofolio/' },
  { name: item.title, url: `/portofolio/${item.slug}/` }
];

const projectWaUrl = getWhatsAppUrl({
  notes: `Inquiry terkait studi kasus portofolio: ${item.title}`,
  sourcePage: `/portofolio/${item.slug}/`
});
---

<BaseLayout
  title={`${item.title} — Studi Kasus Portofolio B2B`}
  description={`Studi kasus pengerjaan ${item.title}. Kuantiti ${item.qty}, bahan ${item.material}, metode cetak ${item.technique}.`}
  canonicalUrl={`https://totebag.web.id/portofolio/${item.slug}/`}
  ogImage={`https://totebag.web.id${item.imageUrl}`}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row g-5">
        <!-- Visual & Overview -->
        <div class="col-12 col-lg-6">
          <div class="p-4 rounded-4 border bg-surface-alt">
            <div class="ratio ratio-4x3 rounded-3 overflow-hidden mb-3">
              <img 
                src={item.imageUrl} 
                alt={item.altText} 
                width="600" 
                height="450" 
                class="w-100 h-100 object-fit-cover"
              />
            </div>
            <div class="d-flex justify-content-between small text-muted">
              <span>Lokasi Klien: <strong>{item.city}</strong></span>
              <span>Waktu Selesai: <strong>{item.date}</strong></span>
            </div>
          </div>
        </div>

        <!-- Detail Project -->
        <div class="col-12 col-lg-6 d-flex flex-column">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-brand">{item.clientType}</span>
            <span class="badge-accent">{item.qty}</span>
          </div>

          <h1 class="h2 fw-bold mb-3">{item.title}</h1>

          <!-- Meta specs table -->
          <div class="table-responsive mb-4">
            <table class="table table-specs w-100">
              <tbody>
                <tr>
                  <th>Material Tas</th>
                  <td class="fw-semibold text-dark">{item.material}</td>
                </tr>
                <tr>
                  <th>Dimensi Produk</th>
                  <td>{item.dimensions}</td>
                </tr>
                <tr>
                  <th>Metode Cetak Logo</th>
                  <td>{item.technique}</td>
                </tr>
                <tr>
                  <th>Jumlah Produksi</th>
                  <td>{item.qty}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="p-4 rounded-4 bg-surface-alt border mt-auto">
            <h3 class="h5 fw-bold mb-2">Ingin Memesan Tas Serupa?</h3>
            <p class="small text-muted mb-3">
              Konsultasikan kebutuhan jumlah dan jadwal acara Anda bersama tim kami. Dapatkan penawaran harga dan simulasi desain cepat.
            </p>
            <a href={projectWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand w-100 py-3">
              Diskusikan Pesanan Serupa via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Dive Brief & Solution -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mx-auto">
        <div class="p-4 p-lg-5 rounded-4 bg-white border">
          <h2 class="h3 fw-bold mb-4">Detail Pengerjaan &amp; Tantangan Produksi</h2>

          <div class="mb-4">
            <h3 class="h5 fw-bold text-dark">1. Kebutuhan Awal Klien (Brief)</h3>
            <p class="text-muted">{item.brief}</p>
          </div>

          <div class="mb-4">
            <h3 class="h5 fw-bold text-dark">2. Solusi Rekayasa Material &amp; Produksi</h3>
            <p class="text-muted">{item.solution}</p>
          </div>

          <div class="p-4 rounded-3 bg-light border">
            <h3 class="h6 fw-bold text-success mb-1">Hasil Akhir &amp; Feedback Klien:</h3>
            <p class="mb-0 text-muted small">{item.keyTakeaway}</p>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/portofolio/" class="btn btn-brand-outline">
            &larr; Kembali ke Semua Portofolio
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
