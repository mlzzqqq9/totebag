---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { faqs, getWhatsAppUrl } from '@/data/siteData';

const naskah = getNaskahById('110');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Cara Pesan', url: '/cara-pesan/' }
];

const pesanWaUrl = getWhatsAppUrl({
  notes: "Konsultasi langkah pemesanan tote bag",
  sourcePage: "/cara-pesan/"
});

const pesanFaqs = faqs.filter(f => f.category === 'pemesanan');
---

<BaseLayout
  title={naskah?.seoTitle || "Cara Memesan Tote Bag Custom | Tote Bag"}
  description={naskah?.metaDescription || "Panduan 6 langkah mudah pemesanan tote bag custom untuk perusahaan dan panitia seminar: konsultasi brief, digital mockup, sampel fisik, produksi, QC, dan kargo."}
  canonicalUrl="https://totebag.web.id/cara-pesan/"
  jsonLd={naskah?.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-75">
        <span class="badge-accent mb-2">PANDUAN PEMESANAN B2B</span>
        <h1 class="hero-title mb-3">Alur &amp; Prosedur Pemesanan</h1>
        <p class="lead text-muted fs-5">
          Proses kerja terstruktur untuk menjamin spesifikasi kain, akurasi sablon logo, dan ketepatan tanggal pengiriman pesanan Anda.
        </p>
      </div>
    </div>
  </section>

  <!-- 6 Langkah Pemesanan Detail -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="row g-4">
        <!-- Step 1 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 01</span>
            <h2 class="h5 fw-bold mb-2">1. Konsultasi Awal &amp; Brief</h2>
            <p class="small text-muted mb-0">
              Hubungi tim kami via WhatsApp. Sampaikan jenis bahan yang diinginkan (Canvas/Blacu/Spunbond/Kulit), perkiraan jumlah (pcs), ukuran tas, serta target tanggal barang harus tiba.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 02</span>
            <h2 class="h5 fw-bold mb-2">2. Penawaran &amp; Mockup Digital</h2>
            <p class="small text-muted mb-0">
              Kami mengirimkan surat penawaran harga resmi (Quotation) beserta simulasi digital (mockup) tata letak logo pada tas untuk Anda konfirmasi atau revisi bersama tim internal.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 03</span>
            <h2 class="h5 fw-bold mb-2">3. Konfirmasi DP &amp; Sampel Fisik</h2>
            <p class="small text-muted mb-0">
              Setelah kesepakatan harga dan pembayaran uang muka (DP 50%), untuk pemesanan di atas 300 pcs kami dapat membuatkan 1 unit sampel fisik (sample proofing) sebelum produksi massal.
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 04</span>
            <h2 class="h5 fw-bold mb-2">4. Pemotongan &amp; Lini Jahit Massal</h2>
            <p class="small text-muted mb-0">
              Kain dipotong menggunakan mesin potong presisi, kemudian proses sablon/DTF/bordir dilakukan, dilanjutkan ke lini penjahit ahli dengan standar jahitan double-stitch.
            </p>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 05</span>
            <h2 class="h5 fw-bold mb-2">5. Quality Control (QC) &amp; Packing</h2>
            <p class="small text-muted mb-0">
              Pembersihan sisa benang, inspeksi kerapian sablon, dan penghitungan jumlah per kardus. Setiap kardus dikemas tebal untuk menjaga tas tetap bersih selama pengiriman.
            </p>
          </div>
        </div>

        <!-- Step 6 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="p-4 rounded-4 bg-white border h-100 position-relative">
            <span class="badge-accent mb-3">LANGKAH 06</span>
            <h2 class="h5 fw-bold mb-2">6. Pelunasan &amp; Ekspedisi Kargo</h2>
            <p class="small text-muted mb-0">
              Pelunasan sisa pembayaran dilakukan sebelum atau saat paket diserahkan ke pihak ekspedisi kargo. Kami mengirimkan nomor resi/surat jalan agar status pengiriman dapat dipantau.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Checklist Persiapan Pesanan -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6">
          <span class="badge-accent mb-2">CHECKLIST BRIEF</span>
          <h2 class="section-title mb-3">Data yang Perlu Anda Siapkan</h2>
          <p class="text-muted mb-4">
            Agar konsultasi berjalan cepat dan penawaran harga akurat, siapkan poin-poin berikut sebelum menghubungi tim kami:
          </p>
          <div class="p-4 rounded-4 bg-white border">
            <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small text-muted">
              <li class="d-flex align-items-start gap-2">
                <span class="fw-bold text-success fs-6">1.</span>
                <div><strong class="text-dark">Estimasi Jumlah:</strong> misalnya 100 pcs, 300 pcs, atau 1.000 pcs.</div>
              </li>
              <li class="d-flex align-items-start gap-2">
                <span class="fw-bold text-success fs-6">2.</span>
                <div><strong class="text-dark">Pilihan Bahan:</strong> Canvas Twill, Canvas Greige, Blacu Super, Spunbond, atau Kulit PU.</div>
              </li>
              <li class="d-flex align-items-start gap-2">
                <span class="fw-bold text-success fs-6">3.</span>
                <div><strong class="text-dark">Dimensi Tas:</strong> ukuran standar (misal 30×40 cm) atau ukuran custom dengan lebar alas gusset.</div>
              </li>
              <li class="d-flex align-items-start gap-2">
                <span class="fw-bold text-success fs-6">4.</span>
                <div><strong class="text-dark">File Logo Acara:</strong> format vektor (.AI, .CDR, .PDF) atau PNG resolusi tinggi.</div>
              </li>
              <li class="d-flex align-items-start gap-2">
                <span class="fw-bold text-success fs-6">5.</span>
                <div><strong class="text-dark">Target Tanggal Pengiriman &amp; Kota Tujuan:</strong> untuk perhitungan rute kargo logistik.</div>
              </li>
            </ul>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="p-4 p-lg-5 rounded-4 bg-brand-dark text-white">
            <h3 class="h4 fw-bold mb-3 text-white">Mulai Konsultasi Pesanan Sekarang</h3>
            <p class="text-white-50 small mb-4">
              Tim kami siap membantu merekomendasikan bahan yang paling efisien sesuai plafon anggaran dan waktu acara Anda.
            </p>
            <a href={pesanWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp w-100 py-3 fs-6">
              Mulai Chat WhatsApp: +62 821-3108-7971
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Pemesanan -->
  <section class="section-space">
    <div class="container">
      <div class="max-w-75 mx-auto mb-4 text-center">
        <h2 class="section-title mb-2">FAQ Teknis Pemesanan</h2>
        <p class="section-subtitle mx-auto">Seputar pembayaran DP, termin invoice, dan kebijakan garansi cacat produksi.</p>
      </div>
      <div class="max-w-75 mx-auto">
        <FAQAccordion items={pesanFaqs} accordionId="caraPesanFaq" />
      </div>
    </div>
  </section>
</BaseLayout>
