---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { getWhatsAppUrl, products, pricingFaqs } from '@/data/siteData';

const naskah = getNaskahById('53');
if (!naskah) {
  throw new Error("Naskah ID 53 not found");
}

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Panduan Biaya & Harga', url: '/harga-tote-bag-custom/' }
];

const waQuoteUrl = getWhatsAppUrl({
  notes: "Permintaan estimasi penawaran harga tote bag custom",
  sourcePage: "/harga-tote-bag-custom/"
});

const faqItems = pricingFaqs;
---

<BaseLayout
  title={naskah.seoTitle || "Harga Tote Bag Custom: Faktor dan Cara Menghitungnya | Tote Bag"}
  description={naskah.metaDescription}
  canonicalUrl={naskah.canonical}
  jsonLd={naskah.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <header class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-75">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge-accent">PANDUAN HARGA &amp; ANGGARAN</span>
        </div>
        <h1 class="hero-title mb-3">
          {naskah.h1}
        </h1>
        <p class="lead text-muted fs-5 mb-0" style="line-height: 1.7;">
          Pahami 6 komponen utama pembentuk harga tote bag custom: bahan kain, jumlah order (MOQ), dimensi pola, kerumitan sablon, serta aksesoris tambahan untuk efisiensi anggaran pengadaan Anda.
        </p>
      </div>
    </div>
  </header>

  <!-- 4 Faktor Utama Penentu Harga Matrix -->
  <section class="py-3">
    <div class="container">
      <div class="row g-4 mb-5">
        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-success text-white">01</span>
              <h3 class="h6 fw-bold mb-0">Jenis &amp; Gramasi Bahan</h3>
            </div>
            <p class="small text-muted mb-0">
              Spunbond adalah opsi paling ekonomis, disusul Blacu Super Grade A untuk budget menengah, Canvas Twill untuk kualitas tahan lama, dan Kulit Sintetis untuk level eksekutif.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-success text-white">02</span>
              <h3 class="h6 fw-bold mb-0">Kuantiti Pemesanan (Qty)</h3>
            </div>
            <p class="small text-muted mb-0">
              Prinsip skala produksi: biaya pembuatan film cetak dan set-up mesin terdistribusi merata. Semakin banyak jumlah pemesanan, semakin murah harga per unit tas.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-success text-white">03</span>
              <h3 class="h6 fw-bold mb-0">Teknik &amp; Luas Cetak</h3>
            </div>
            <p class="small text-muted mb-0">
              Jumlah warna sablon manual, luas cetak DTF full-color, atau jumlah tusukan benang bordir komputer mempengaruhi waktu pengerjaan dan konsumsi bahan cetak.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
          <div class="p-4 rounded-4 bg-white border h-100 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-success text-white">04</span>
              <h3 class="h6 fw-bold mb-0">Fitur &amp; Aksesoris Jahit</h3>
            </div>
            <p class="small text-muted mb-0">
              Penambahan resleting utama YKK, furing bagian dalam (satin/drill), saku luar/dalam, kancing magnet, atau tali webbing tebal menambah rincian biaya jahit.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="row g-5">
        <!-- Content Column (col-12 col-lg-8) -->
        <div class="col-12 col-lg-8">

          <!-- Direct Answer Callout Box -->
          {naskah.directAnswer && (
            <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success mb-4 shadow-sm">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <span class="badge bg-success text-white">Ringkasan Biaya</span>
                <span class="fs-6">Kunci Menghitung Harga Tote Bag:</span>
              </div>
              <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
                {naskah.directAnswer}
              </p>
            </div>
          )}

          <!-- Quick Navigation / Table of Contents -->
          {naskah.toc && naskah.toc.length > 0 && (
            <div class="p-4 rounded-4 bg-light border mb-4">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                <span>Daftar Pembahasan Panduan:</span>
              </div>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                {naskah.toc.map((item, idx) => (
                  <li class={item.level === 3 ? 'ps-3' : ''}>
                    <a href={`#${item.id}`} class="text-decoration-none text-success fw-medium">
                      {idx + 1}. {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Dynamic HTML Content parsed from Naskah -->
          <div class="article-content-body d-flex flex-column gap-3 text-muted" style="line-height: 1.85; font-size: 1.05rem;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>

          <!-- FAQ Accordion -->
          {faqItems.length > 0 && (
            <div class="mt-5 pt-4 border-top">
              <span class="badge-accent mb-2">TANYA JAWAB BIAYA</span>
              <h2 class="h4 fw-bold text-dark mb-3">Pertanyaan yang Sering Diajukan Seputar Harga</h2>
              <FAQAccordion items={faqItems} accordionId="faqAccordion53" />
            </div>
          )}

          <!-- Bottom Action Banner -->
          <div class="p-4 p-lg-5 rounded-4 bg-brand-dark text-white mt-5">
            <span class="badge bg-warning text-dark fw-bold mb-2">QUOTATION RESMI</span>
            <h3 class="h4 fw-bold mb-2 text-white">Dapatkan Surat Penawaran Harga Rinci</h3>
            <p class="small text-white-50 mb-4" style="max-width: 600px;">
              Sampaikan jumlah tas, pilihan kain, dan kirimkan file logo Anda. Tim kami akan menyusun surat penawaran harga resmi (Quotation) transparan tanpa biaya tersembunyi.
            </p>
            <div class="d-flex flex-wrap gap-2">
              <a href={waQuoteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/></svg>
                Minta Penawaran Harga via WA
              </a>
              <a href="/cara-pesan/" class="btn btn-outline-light">
                Alur Pemesanan &amp; Pembayaran
              </a>
            </div>
          </div>

        </div>

        <!-- Sticky Sidebar (col-12 col-lg-4) -->
        <div class="col-12 col-lg-4">
          <div class="sticky-sidebar d-flex flex-column gap-4" style="top: 85px;">

            <!-- Checklist RFQ Card -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                <span>Checklist Permintaan Penawaran:</span>
              </h3>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                <li class="pb-2 border-bottom">1. Perkiraan kuantiti (pcs)</li>
                <li class="pb-2 border-bottom">2. Jenis bahan yang dituju</li>
                <li class="pb-2 border-bottom">3. Dimensi tas (panjang x tinggi x gusset)</li>
                <li class="pb-2 border-bottom">4. Jumlah warna logo &amp; posisi cetak</li>
                <li class="pb-2 border-bottom">5. Fitur: resleting / furing / saku</li>
                <li class="pt-1">6. Kota tujuan pengiriman kargo</li>
              </ul>
            </div>

            <!-- Material Categories Card -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3">Estimasi Menurut Bahan:</h3>
              <div class="d-flex flex-column gap-2 small">
                {products.map(prod => (
                  <a href={`/produk/${prod.slug}/`} class="text-decoration-none d-flex align-items-center justify-content-between p-2 rounded-3 hover-bg-light">
                    <div>
                      <div class="fw-semibold text-dark">{prod.name}</div>
                      <div class="text-muted" style="font-size: 0.75rem;">{prod.material}</div>
                    </div>
                    <span class="text-success">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Related Pages -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3">Halaman Terkait:</h3>
              <div class="d-flex flex-column gap-2 small">
                <a href="/tote-bag-custom/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Opsi Cetak Sablon &amp; DTF Logo
                </a>
                <a href="/jenis-bahan-tote-bag/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Karakteristik &amp; Pilihan Bahan
                </a>
                <a href="/tote-bag-perusahaan/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Solusi Pengadaan Korporat
                </a>
                <a href="/cara-pesan/" class="text-decoration-none text-dark py-1 hover-text-success">
                  &bull; 6 Langkah Alur Pemesanan
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-content-body :global(h2) {
    font-size: 1.45rem;
    font-weight: 700;
    color: #173F38;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(23, 63, 56, 0.1);
  }

  .article-content-body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    color: #2b3330;
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .article-content-body :global(p) {
    margin-bottom: 1.1rem;
    line-height: 1.85;
  }

  .article-content-body :global(ul),
  .article-content-body :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: 1.2rem;
  }

  .article-content-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-content-body :global(a) {
    color: #173F38;
    font-weight: 600;
    text-decoration: underline;
  }

  .article-content-body :global(a:hover) {
    color: #C18755;
  }

  .hover-bg-light:hover {
    background: rgba(23, 63, 56, 0.05);
  }

  .hover-text-success:hover {
    color: #173F38 !important;
  }
</style>
