---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { getWhatsAppUrl, products } from '@/data/siteData';

const naskah = getNaskahById('01');
if (!naskah) {
  throw new Error("Naskah ID 01 not found");
}

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Fundamental Tote Bag', url: '/tote-bag/' }
];

const waUrl = getWhatsAppUrl({
  notes: "Konsultasi dari panduan fundamental tote bag",
  sourcePage: "/tote-bag/"
});

const faqItems = naskah.faqs.map((f, i) => ({
  id: `faq-01-${i}`,
  question: f.question,
  answer: f.answer,
  category: 'umum' as const
}));
---

<BaseLayout
  title={naskah.seoTitle || "Tote Bag: Pengertian, Jenis, Bahan dan Kegunaannya | Tote Bag"}
  description={naskah.metaDescription}
  canonicalUrl={naskah.canonical}
  jsonLd={naskah.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero Header -->
  <header class="section-space-sm pt-2">
    <div class="container">
      <div class="max-w-75">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge-accent">PANDUAN FUNDAMENTAL</span>
        </div>
        <h1 class="hero-title mb-3">
          {naskah.h1}
        </h1>
        <p class="lead text-muted fs-5 mb-0" style="line-height: 1.7;">
          Panduan komprehensif memahami fungsi, variasi bentuk, material kain, dan cara pengadaan tote bag untuk kebutuhan perusahaan, instansi, UMKM, maupun event massal.
        </p>
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <section class="section-space pt-0">
    <div class="container">
      <div class="row g-5">
        <!-- Content Column (col-12 col-lg-8) -->
        <div class="col-12 col-lg-8">

          <!-- Direct Answer Callout Box -->
          {naskah.directAnswer && (
            <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success mb-4 shadow-sm">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <span class="badge bg-success text-white">Ringkasan Konsep</span>
                <span class="fs-6">Definisi &amp; Esensi Tote Bag:</span>
              </div>
              <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
                {naskah.directAnswer}
              </p>
            </div>
          )}

          <!-- Quick Navigation / Table of Contents -->
          {naskah.toc && naskah.toc.length > 0 && (
            <div class="p-4 rounded-4 bg-light border mb-4">
              <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                <span>Daftar Pembahasan:</span>
              </div>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                {naskah.toc.map((item, idx) => (
                  <li class={item.level === 3 ? 'ps-3' : ''}>
                    <a href={`#${item.id}`} class="text-decoration-none text-success fw-medium">
                      {idx + 1}. {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Dynamic HTML Content parsed from Naskah -->
          <div class="article-content-body d-flex flex-column gap-3 text-muted" style="line-height: 1.85; font-size: 1.05rem;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>

          <!-- FAQ Accordion -->
          {faqItems.length > 0 && (
            <div class="mt-5 pt-4 border-top">
              <span class="badge-accent mb-2">TANYA JAWAB PENGADAAN</span>
              <h2 class="h4 fw-bold text-dark mb-3">Pertanyaan yang Sering Diajukan</h2>
              <FAQAccordion items={faqItems} accordionId="faqAccordion01" />
            </div>
          )}

          <!-- Bottom Action Banner -->
          <div class="p-4 p-lg-5 rounded-4 bg-brand-dark text-white mt-5">
            <span class="badge bg-warning text-dark fw-bold mb-2">PENAWARAN RESMI</span>
            <h3 class="h4 fw-bold mb-2 text-white">Konsultasikan Spesifikasi Tas Anda</h3>
            <p class="small text-white-50 mb-4" style="max-width: 600px;">
              Kirimkan brief mencakup jumlah unit, ukuran, pilihan kain, dan file logo Anda. Tim kami akan menyiapkan surat penawaran harga resmi (Quotation) dalam hitungan jam.
            </p>
            <div class="d-flex flex-wrap gap-2">
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/></svg>
                Konsultasi Spesifikasi via WA
              </a>
              <a href="/tote-bag-custom/" class="btn btn-outline-light">
                Katalog Custom Sablon &amp; DTF
              </a>
            </div>
          </div>

        </div>

        <!-- Sticky Sidebar (col-12 col-lg-4) -->
        <div class="col-12 col-lg-4">
          <div class="sticky-sidebar d-flex flex-column gap-4" style="top: 85px;">

            <!-- Summary Specifications Box -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span>Ringkasan Opsi Spesifikasi:</span>
              </h3>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                <li class="pb-2 border-bottom d-flex justify-content-between">
                  <span>Pilihan Bahan:</span>
                  <strong class="text-dark">Canvas, Blacu, Spunbond, Kulit</strong>
                </li>
                <li class="pb-2 border-bottom d-flex justify-content-between">
                  <span>Ukuran Populer:</span>
                  <strong class="text-dark">30x40 cm &amp; 35x40x10 cm</strong>
                </li>
                <li class="pb-2 border-bottom d-flex justify-content-between">
                  <span>Teknik Cetak:</span>
                  <strong class="text-dark">Sablon Manual, DTF, Bordir</strong>
                </li>
                <li class="pb-2 border-bottom d-flex justify-content-between">
                  <span>Fitur Tambahan:</span>
                  <strong class="text-dark">Resleting, Furing, Kancing</strong>
                </li>
                <li class="pt-1 d-flex justify-content-between">
                  <span>Basis Produksi:</span>
                  <strong class="text-dark">Kedungkandang, Malang</strong>
                </li>
              </ul>
            </div>

            <!-- Material Links Card -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3">Jelajahi Berdasarkan Bahan:</h3>
              <div class="d-flex flex-column gap-2">
                {products.map(prod => (
                  <a href={`/produk/${prod.slug}/`} class="text-decoration-none d-flex align-items-center justify-content-between p-2 rounded-3 hover-bg-light">
                    <div>
                      <div class="fw-semibold text-dark small">{prod.name}</div>
                      <div class="text-muted" style="font-size: 0.75rem;">{prod.material}</div>
                    </div>
                    <span class="text-success">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Related Pillar Pages -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
              <h3 class="h6 fw-bold mb-3">Tautan Terkait:</h3>
              <div class="d-flex flex-column gap-2 small">
                <a href="/jenis-bahan-tote-bag/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Panduan Karakteristik Bahan
                </a>
                <a href="/tote-bag-custom/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Jasa Tote Bag Custom Sablon &amp; DTF
                </a>
                <a href="/tote-bag-perusahaan/" class="text-decoration-none text-dark py-1 hover-text-success border-bottom">
                  &bull; Solusi Pengadaan Perusahaan &amp; HRD
                </a>
                <a href="/cara-pesan/" class="text-decoration-none text-dark py-1 hover-text-success">
                  &bull; 6 Langkah Alur Prosedur Pemesanan
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-content-body :global(h2) {
    font-size: 1.45rem;
    font-weight: 700;
    color: #173F38;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(23, 63, 56, 0.1);
  }

  .article-content-body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    color: #2b3330;
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .article-content-body :global(p) {
    margin-bottom: 1.1rem;
    line-height: 1.85;
  }

  .article-content-body :global(ul),
  .article-content-body :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: 1.2rem;
  }

  .article-content-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-content-body :global(a) {
    color: #173F38;
    font-weight: 600;
    text-decoration: underline;
  }

  .article-content-body :global(a:hover) {
    color: #C18755;
  }

  .hover-bg-light:hover {
    background: rgba(23, 63, 56, 0.05);
  }

  .hover-text-success:hover {
    color: #173F38 !important;
  }
</style>
