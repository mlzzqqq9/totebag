---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import { getNaskahById } from '@/utils/naskah';
import { corporateFaqs, getWhatsAppUrl } from '@/data/siteData';

const naskah = getNaskahById('33');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan & Solusi', url: '/layanan/' },
  { name: 'Tote Bag Perusahaan', url: '/tote-bag-perusahaan/' }
];

const corpWaUrl = getWhatsAppUrl({
  notes: "Konsultasi pengadaan tote bag perusahaan / corporate gift",
  sourcePage: "/tote-bag-perusahaan/"
});
---

<BaseLayout
  title={naskah?.seoTitle || "Tote Bag Perusahaan untuk Merchandise dan Corporate Gift | Tote Bag"}
  description={naskah?.metaDescription || "Solusi pengadaan tote bag custom korporat untuk HR onboarding kit, merchandise perusahaan, dan cinderamata mitra bisnis. Faktur resmi dan pengiriman antarkota."}
  canonicalUrl={naskah?.canonical || "https://totebag.web.id/tote-bag-perusahaan/"}
  jsonLd={naskah?.schemaJson}
>
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="section-space-sm pt-2">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">SOLUSI PENGADAAN KORPORAT</span>
          </div>
          <h1 class="hero-title mb-3" style="font-size: clamp(2rem, 3.4vw, 2.7rem);">
            {naskah?.h1 || "Tote Bag Perusahaan untuk Merchandise dan Corporate Gift"}
          </h1>
          <p class="lead text-muted fs-5 mb-4">
            Pengadaan merchandise korporat yang memenuhi standar representasi brand: jahitan kuat, furing rapi, kompartemen laptop, serta kelengkapan administrasi faktur pengadaan.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href={corpWaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-brand btn-lg">
              Minta Penawaran RFQ Korporat
            </a>
            <a href="/portofolio/" class="btn btn-brand-outline btn-lg">
              Lihat Studi Kasus Klien
            </a>
          </div>
        </div>
        <div class="col-12 col-lg-5">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
            <img 
              src="/media/lifestyle-tote-bag-navy-batik.webp" 
              alt="Tote bag perusahaan eksklusif kombinasi batik untuk merchandise korporat" 
              width="724" 
              height="543" 
              class="w-100 h-100 object-fit-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Direct Answer & Core Insights from Naskah 33 -->
  {naskah?.directAnswer && (
    <section class="py-3">
      <div class="container">
        <div class="p-4 rounded-4 bg-surface-alt border-start border-4 border-success shadow-sm">
          <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
            <span class="badge bg-success text-white">Ringkasan Pengadaan</span>
            <span class="fs-6">Prinsip Merchandise Perusahaan:</span>
          </div>
          <p class="mb-0 text-muted fs-6" style="line-height: 1.8;">
            {naskah.directAnswer}
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- 3 Skenario Kebutuhan Korporat -->
  <section class="section-space bg-surface-alt mt-4">
    <div class="container">
      <div class="text-center max-w-75 mx-auto mb-5">
        <span class="badge-accent mb-2">SKENARIO PENGGUNAAN</span>
        <h2 class="section-title mb-3">Solusi Tote Bag Berdasarkan Agenda Kantor</h2>
        <p class="section-subtitle mx-auto">
          Mulai dari paket penerimaan karyawan hingga bingkisan eksekutif untuk relasi bisnis dan stakeholders.
        </p>
      </div>

      <div class="row g-4">
        <!-- Paket 1 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">HR &amp; PEOPLE</div>
            <h3 class="h5 fw-bold mb-2">New Hire Onboarding Kit</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Tas pembungkus perlengkapan karyawan baru (laptop tumbler lanyard buku). Menggunakan Canvas Twill tebal dengan bordir logo atau sablon rubber awet.
            </p>
            <ul class="list-unstyled small text-muted mb-4 d-flex flex-column gap-2 border-top pt-3">
              <li>✓ Ukuran 35×40×10 cm (Muat Laptop 14")</li>
              <li>✓ Dilengkapi resleting utama &amp; furing</li>
              <li>✓ Beban rekomendasi: hingga 8 kg</li>
            </ul>
            <a href="/produk/tote-bag-canvas/" class="btn btn-outline-success btn-sm w-100">
              Lihat Spesifikasi Canvas
            </a>
          </div>
        </div>

        <!-- Paket 2 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">MARKETING &amp; PR</div>
            <h3 class="h5 fw-bold mb-2">Company Gathering &amp; HUT</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Merchandise peringatan hari jadi instansi atau gathering keluarga kantor. Menggunakan Blacu Super Grade A yang rapi dengan cetak DTF full color.
            </p>
            <ul class="list-unstyled small text-muted mb-4 d-flex flex-column gap-2 border-top pt-3">
              <li>✓ Ukuran standar 30×40 cm tanpa gusset</li>
              <li>✓ Opsi cetak desain tema acara gradasi</li>
              <li>✓ Biaya optimal untuk ratusan peserta</li>
            </ul>
            <a href="/produk/tote-bag-blacu/" class="btn btn-outline-success btn-sm w-100">
              Lihat Spesifikasi Blacu
            </a>
          </div>
        </div>

        <!-- Paket 3 -->
        <div class="col-12 col-md-4">
          <div class="p-4 rounded-4 bg-white border h-100 d-flex flex-column shadow-sm">
            <div class="badge-brand align-self-start mb-3">B2B RELATIONS</div>
            <h3 class="h5 fw-bold mb-2">Executive Corporate Gift</h3>
            <p class="small text-muted mb-3 flex-grow-1">
              Cinderamata eksklusif untuk jajaran direksi mitra dan tamu VVIP. Terbuat dari kulit sintetis premium dengan logo deboss hot-stamping minimalis.
            </p>
            <ul class="list-unstyled small text-muted mb-4 d-flex flex-column gap-2 border-top pt-3">
              <li>✓ Bahan Kulit PU/PVC water-repellent</li>
              <li>✓ Saku dalam dengan ritsleting khusus kartu</li>
              <li>✓ Kesan formal prestisius untuk relasi bisnis</li>
            </ul>
            <a href="/produk/tote-bag-kulit/" class="btn btn-outline-success btn-sm w-100">
              Lihat Spesifikasi Kulit
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Section from Naskah 33 -->
  {naskah?.bodyHtml && (
    <section class="section-space-sm pt-0">
      <div class="container">
        <div class="p-4 rounded-4 bg-light border">
          <h2 class="h5 fw-bold text-dark mb-3">Panduan Pengadaan &amp; Standar B2B</h2>
          <div class="article-content-body text-muted small" style="line-height: 1.8;">
            <Fragment set:html={naskah.bodyHtml} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  <section class="section-space bg-surface-alt">
    <div class="container">
      <div class="max-w-75 mx-auto mb-4 text-center">
        <h2 class="section-title mb-2">FAQ Pengadaan Korporat</h2>
        <p class="section-subtitle mx-auto">Pertanyaan seputar faktur resmi, pembayaran termin B2B, dan pengiriman kargo.</p>
      </div>
      <div class="max-w-75 mx-auto">
        <FAQAccordion items={corporateFaqs} accordionId="corporatePageFaq" />
      </div>
    </div>
  </section>
</BaseLayout>
