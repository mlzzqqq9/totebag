y---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Vendor Tote Bag Custom di Malang', url: '/tote-bag-custom-malang/' }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://totebag.web.id/#website",
      "url": "https://totebag.web.id/",
      "name": "ToteBag",
      "inLanguage": "id-ID"
    },
    {
      "@type": "WebPage",
      "@id": "https://totebag.web.id/tote-bag-custom-malang/#webpage",
      "url": "https://totebag.web.id/tote-bag-custom-malang/",
      "name": "Vendor Tote Bag Custom di Malang untuk Perusahaan & Event",
      "description": "Vendor tote bag custom di Malang untuk seminar, perusahaan, kampus dan event. Bandingkan bahan, teknik logo dan proses pemesanan. Konsultasi via WhatsApp.",
      "isPartOf": {
        "@id": "https://totebag.web.id/#website"
      },
      "inLanguage": "id-ID"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://totebag.web.id/tote-bag-custom-malang/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://totebag.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Vendor Tote Bag Custom di Malang",
          "item": "https://totebag.web.id/tote-bag-custom-malang/"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://totebag.web.id/tote-bag-custom-malang/#service",
      "name": "Layanan Pemesanan Tote Bag Custom di Malang",
      "serviceType": "Pemesanan tote bag custom untuk kebutuhan B2B dan event",
      "areaServed": {
        "@type": "Place",
        "name": "Malang, Jawa Timur"
      },
      "provider": {
        "@type": "Organization",
        "name": "ToteBag",
        "url": "https://totebag.web.id/",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+62-821-3108-7971",
          "contactType": "sales",
          "availableLanguage": "Indonesian"
        }
      },
      "url": "https://totebag.web.id/tote-bag-custom-malang/"
    },
    {
      "@type": "FAQPage",
      "@id": "https://totebag.web.id/tote-bag-custom-malang/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Di mana bisa memesan tote bag custom di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Anda dapat mengajukan kebutuhan tote bag custom melalui ToteBag di situs ini. Sampaikan bahan, ukuran, jumlah, desain logo, lokasi pengiriman, dan tanggal penggunaan agar tim dapat menyiapkan penawaran yang relevan."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa minimal order tote bag custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimum pemesanan bergantung pada bahan, ukuran, model, teknik logo, dan jadwal produksi. Angka 50–100 pcs sering digunakan sebagai gambaran untuk pengadaan konveksi, tetapi bukan MOQ pasti untuk semua produk. Konfirmasikan jumlah Anda saat meminta penawaran."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama proses produksi tote bag custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Waktu produksi dipengaruhi jumlah pesanan, ketersediaan kain, kerumitan desain, persetujuan sampel, dan antrean pengerjaan. Estimasi 3–10 hari kerja dalam materi panduan bukan janji layanan; pastikan tanggal produksi dan pengiriman tertulis di quotation."
          }
        },
        {
          "@type": "Question",
          "name": "Apa bahan tote bag yang cocok untuk seminar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spunbond cocok untuk kebutuhan ringan dan anggaran ketat, blacu untuk tampilan natural, serta canvas untuk penggunaan berulang dan kesan lebih premium. Pilih ukuran yang mampu memuat materi acara dan uji sampel sebelum memesan banyak."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah tote bag bisa memakai logo perusahaan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tote bag dapat dipersonalisasi dengan sablon manual, transfer/DTF, atau bordir tergantung material dan desain. Kirim logo beresolusi tinggi atau vektor serta posisi cetak yang diinginkan agar hasil mockup dapat diperiksa."
          }
        },
        {
          "@type": "Question",
          "name": "Apa yang memengaruhi harga tote bag custom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Faktor utama meliputi jenis dan ketebalan kain, dimensi, gusset atau resleting, jumlah unit, ukuran dan jumlah warna logo, teknik cetak, serta biaya sampel dan pengiriman. Minta penawaran dengan spesifikasi lengkap agar dapat membandingkan secara adil."
          }
        },
        {
          "@type": "Question",
          "name": "Bisakah pemesanan dilakukan dari luar Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Konsultasi dan persetujuan desain dapat dibahas secara daring. Ketersediaan layanan kirim, ongkos angkut, serta perkiraan tiba harus dikonfirmasi sesuai tujuan dan jadwal acara."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah spunbond selalu lebih ramah lingkungan daripada kain lain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak selalu. Dampak lingkungan bergantung pada bahan baku, proses produksi, masa pakai, frekuensi penggunaan ulang, dan pengelolaan akhir pakai. Spunbond umumnya berbahan polipropilena non-woven; jangan menyamakannya dengan kain alami atau otomatis dapat didaur ulang di semua daerah."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Vendor Tote Bag Custom Malang untuk Perusahaan & Event"
  description="Cari vendor tote bag custom di Malang? Pilih canvas, blacu, spunbond, dan custom logo untuk seminar, perusahaan, kampus, dan event. Konsultasi pesanan."
  canonicalUrl="https://totebag.web.id/tote-bag-custom-malang/"
  ogImage="https://totebag.web.id/media/produksi-massal-tote-bag.webp"
  jsonLd={schemaJson}
>
  <!-- Topbar Information Strip -->
  <aside class="malang-topbar py-2 text-center text-white small" style="background-color: var(--brand-primary, #173F38);" aria-label="Informasi layanan workshop">
    <div class="container">
      Layanan tote bag custom untuk perusahaan, instansi, kampus dan event • Konsultasi spesifikasi sebelum order
    </div>
  </aside>

  <!-- Breadcrumbs & In-Page Anchor Navigation -->
  <div class="container pt-3">
    <Breadcrumbs items={breadcrumbs} />
    <nav class="quick-nav d-none d-md-flex flex-wrap gap-2 pt-2 pb-1" aria-label="Navigasi cepat halaman">
      <span class="small fw-semibold text-muted align-self-center me-1">Lompat ke:</span>
      <a href="#layanan" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Layanan B2B</a>
      <a href="#bahan" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Pilihan Bahan</a>
      <a href="#custom" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Teknik Logo</a>
      <a href="#proses" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">Cara Pesan</a>
      <a href="#faq" class="badge bg-white text-dark border text-decoration-none px-3 py-2 rounded-pill">FAQ</a>
      <a href="#penawaran" class="badge badge-cta bg-brand text-white text-decoration-none px-3 py-2 rounded-pill shadow-sm">Minta Penawaran</a>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="section-space-sm pt-3 pb-5 hero-malang" id="konten">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-accent">Solusi tote bag custom • Malang, Jawa Timur</span>
          </div>
          <h1 class="hero-title mb-3" style="font-size: clamp(2.2rem, 3.8vw, 3.2rem);">
            Vendor Tote Bag Custom di Malang untuk Perusahaan &amp; Berbagai Acara
          </h1>
          <p class="lead text-muted fs-5 mb-4" style="line-height: 1.75;">
            Butuh tote bag custom berlogo untuk seminar, perusahaan, kampus atau event? Tentukan bahan, ukuran, jumlah dan teknik cetak sesuai kebutuhan. Melalui ToteBag, Anda dapat mengajukan brief dan meminta penawaran berdasarkan spesifikasi pesanan.
          </p>
          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="#penawaran" class="btn btn-brand btn-lg">
              Minta penawaran custom
            </a>
            <a href="#bahan" class="btn btn-brand-outline btn-lg">
              Bandingkan bahan ↓
            </a>
          </div>
          <div class="d-flex flex-wrap gap-3 text-muted small">
            <span><strong class="text-success">✓</strong> Pilihan bahan &amp; model</span>
            <span><strong class="text-success">✓</strong> Custom logo presisi</span>
            <span><strong class="text-success">✓</strong> Kebutuhan B2B &amp; acara</span>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="position-relative">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border shadow-sm">
              <img 
                src="/media/produksi-massal-tote-bag.webp" 
                alt="Proses produksi massal tote bag custom di konveksi workshop Malang" 
                width="800" 
                height="600" 
                class="w-100 h-100 object-fit-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <!-- Floating Spec Tag -->
            <div class="position-absolute bottom-0 end-0 m-3 px-3 py-2 bg-white rounded-3 shadow-sm border text-dark d-none d-sm-block" style="max-width: 240px; z-index: 5;">
              <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-circle p-1 bg-success text-white" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">✓</span>
                <div>
                  <strong class="d-block text-brand fw-bold" style="font-size: 0.85rem; line-height: 1.2;">Mulai dari brief</strong>
                  <span class="text-muted" style="font-size: 0.75rem; line-height: 1.2;">Jumlah • bahan • logo • deadline</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 04: #layanan - Solusi pemesanan tote bag untuk kebutuhan bisnis dan acara -->
  <section class="section-space pt-4 pb-5" id="layanan">
    <div class="container">
      <div class="max-w-75 mb-5">
        <span class="badge-accent mb-2">Layanan custom</span>
        <h2 class="section-title mb-3">Solusi pemesanan tote bag untuk kebutuhan bisnis dan acara</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          Vendor tote bag custom di Malang membantu pengadaan tas sesuai identitas brand, fungsi pemakaian, dan kebutuhan distribusi. Yang paling penting bukan sekadar memilih tas murah, melainkan menetapkan spesifikasi agar penawaran, sampel, dan produk akhir dapat diperiksa secara konsisten.
        </p>
      </div>

      <div class="row g-4">
        <!-- 01 / Corporate -->
        <div class="col-12 col-md-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border mb-3">
              <img 
                src="/media/lifestyle-tote-bag-navy-batik.webp" 
                alt="Tote bag perusahaan eksklusif untuk corporate gift dan onboarding" 
                width="600" 
                height="338" 
                class="w-100 h-100 object-fit-cover"
                loading="lazy"
              />
            </div>
            <span class="badge bg-light text-brand align-self-start mb-2 fw-bold">01 / Corporate</span>
            <h3 class="h5 fw-bold mb-2">Tote bag perusahaan &amp; HRD</h3>
            <p class="text-muted small flex-grow-1">
              Merchandise kantor, paket onboarding, hadiah karyawan, dan aktivitas branding internal. Utamakan warna identitas, logo rapi, dan kenyamanan saat dipakai ulang.
            </p>
            <a href="/tote-bag-custom/" class="fw-bold text-brand small text-decoration-none mt-2">
              Lihat layanan custom logo →
            </a>
          </article>
        </div>

        <!-- 02 / Event -->
        <div class="col-12 col-md-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border mb-3">
              <img 
                src="/media/tote-bag-seminar-kit-canvas.webp" 
                alt="Tote bag seminar kit custom kampus dan konferensi" 
                width="600" 
                height="338" 
                class="w-100 h-100 object-fit-cover"
                loading="lazy"
              />
            </div>
            <span class="badge bg-light text-brand align-self-start mb-2 fw-bold">02 / Event</span>
            <h3 class="h5 fw-bold mb-2">Seminar, workshop &amp; kampus</h3>
            <p class="text-muted small flex-grow-1">
              Tas untuk buku, dokumen A4, notebook, pulpen, dan lanyard. Pilih ukuran berdasarkan isi serta tingkat penggunaan setelah acara.
            </p>
            <a href="/tote-bag-seminar/" class="fw-bold text-brand small text-decoration-none mt-2">
              Panduan tote bag seminar →
            </a>
          </article>
        </div>

        <!-- 03 / Instansi -->
        <div class="col-12 col-md-4">
          <article class="card h-100 p-4 rounded-4 bg-white border shadow-sm d-flex flex-column">
            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border mb-3">
              <img 
                src="/media/lifestyle-tote-bag-green-energy.webp" 
                alt="Pengadaan tote bag dinas instansi dan organisasi" 
                width="600" 
                height="338" 
                class="w-100 h-100 object-fit-cover"
                loading="lazy"
              />
            </div>
            <span class="badge bg-light text-brand align-self-start mb-2 fw-bold">03 / Instansi</span>
            <h3 class="h5 fw-bold mb-2">Pengadaan organisasi &amp; instansi</h3>
            <p class="text-muted small flex-grow-1">
              Pemesanan untuk pelatihan, rapat kerja, kegiatan dinas, dan program promosi. Siapkan dokumen spesifikasi, artwork, dan jadwal penggunaan sebelum meminta quotation.
            </p>
            <a href="#penawaran" class="fw-bold text-brand small text-decoration-none mt-2">
              Susun brief pengadaan →
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 05: #bahan - Pilih bahan tote bag custom berdasarkan fungsi, bukan tren semata -->
  <section class="section-space bg-surface-alt" id="bahan">
    <div class="container">
      <div class="max-w-75 mb-4">
        <span class="badge-accent mb-2">Panduan material</span>
        <h2 class="section-title mb-3">Pilih bahan tote bag custom berdasarkan fungsi, bukan tren semata</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          Canvas, blacu, spunbond, cordura/polyester, denim, dan mika memiliki karakter berbeda. Tabel berikut merupakan panduan kualitatif, bukan hasil uji laboratorium maupun daftar harga resmi.
        </p>
      </div>

      <div class="table-responsive rounded-4 border bg-white shadow-sm mb-3">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="min-width: 160px;">Bahan</th>
              <th scope="col" style="min-width: 220px;">Karakter umum</th>
              <th scope="col" style="min-width: 220px;">Penggunaan yang cocok</th>
              <th scope="col" style="min-width: 240px;">Pertimbangan</th>
            </tr>
          </thead>
          <tbody class="small">
            <tr>
              <th scope="row" class="fw-bold text-dark">Canvas / Kanvas</th>
              <td>Tenunan relatif tebal dan berstruktur; nyaman untuk pemakaian berulang.</td>
              <td>Corporate merchandise, tote bag premium, seminar eksekutif.</td>
              <td>Ketebalan dan kualitas jahitan memengaruhi kekuatan; biaya dapat lebih tinggi.</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Blacu</th>
              <td>Warna natural, tampilan sederhana, umumnya lebih ringan.</td>
              <td>Workshop kreatif, kampus, souvenir bernuansa natural.</td>
              <td>Ketebalan dan tingkat menerawang bervariasi.</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Spunbond</th>
              <td>Non-woven sintetis, ringan, mudah dibentuk.</td>
              <td>Goodie bag promosi, event massal, kemasan materi ringan.</td>
              <td>Jangan menyimpulkan semua spunbond ramah lingkungan; lihat siklus pakai dan daur ulang lokal.</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Cordura / Polyester</th>
              <td>Kain sintetis dengan beragam tingkat ketahanan dan finishing.</td>
              <td>Tas event berkompartemen, kebutuhan perjalanan atau perlengkapan yang lebih berat.</td>
              <td>Spesifikasi gramasi, coating, dan jahitan harus diverifikasi.</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Denim</th>
              <td>Tekstur khas jeans, tampilan kasual.</td>
              <td>Merchandise kreatif, tote bag komunitas atau ritel.</td>
              <td>Berat bahan dan kemungkinan luntur perlu diperiksa.</td>
            </tr>
            <tr>
              <th scope="row" class="fw-bold text-dark">Mika / PVC</th>
              <td>Transparan dan mudah dibersihkan pada jenis tertentu.</td>
              <td>Souvenir display, kosmetik, kebutuhan visual transparan.</td>
              <td>Periksa ketebalan, kelenturan, serta aturan acara terkait material plastik.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="p-4 rounded-4 bg-white border-start border-4 border-success shadow-sm mb-4">
        <p class="text-dark small mb-0" style="line-height: 1.8;">
          <strong>Cara cepat memilih:</strong> untuk distribusi ringan dalam jumlah besar, pertimbangkan spunbond; untuk kesan natural, blacu; untuk tas yang diharapkan sering digunakan, canvas; dan untuk model berfitur khusus, evaluasi polyester/cordura serta konstruksi tas.
        </p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/produk/tote-bag-canvas/" class="btn btn-outline-success btn-sm">Detail tote bag canvas →</a>
        <a href="/produk/tote-bag-blacu/" class="btn btn-outline-success btn-sm">Detail tote bag blacu →</a>
        <a href="/produk/tote-bag-spunbond/" class="btn btn-outline-success btn-sm">Detail tote bag spunbond →</a>
      </div>
    </div>
  </section>

  <!-- Section 06: #custom - Sablon manual, DTF, transfer, atau bordir: mana yang paling tepat? -->
  <section class="section-space" id="custom">
    <div class="container">
      <div class="max-w-75 mb-5">
        <span class="badge-accent mb-2">Teknik personalisasi</span>
        <h2 class="section-title mb-3">Sablon manual, DTF, transfer, atau bordir: mana yang paling tepat?</h2>
        <p class="text-muted fs-6" style="line-height: 1.8;">
          Teknik pencetakan logo perlu mengikuti jenis kain, jumlah warna, ukuran artwork, dan kuantitas order. Tidak semua proses sablon memakai kertas transfer; metode manual dan digital memiliki tahapan berbeda.
        </p>
      </div>

      <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="display-6 fw-bold text-accent mb-2" style="color: var(--brand-accent, #C18755);">01</span>
            <h3 class="h5 fw-bold mb-2">Sablon manual</h3>
            <p class="text-muted small mb-0">
              Cocok untuk desain sederhana dan produksi berulang pada material yang kompatibel. Biaya dipengaruhi jumlah warna, ukuran bidang cetak, dan jumlah unit.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="display-6 fw-bold text-accent mb-2" style="color: var(--brand-accent, #C18755);">02</span>
            <h3 class="h5 fw-bold mb-2">DTF / transfer digital</h3>
            <p class="text-muted small mb-0">
              Memungkinkan artwork penuh warna dan detail kecil pada material yang sesuai. Uji daya rekat, temperatur press, dan hasil cuci pada sampel.
            </p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="card h-100 p-4 rounded-4 bg-white border shadow-sm">
            <span class="display-6 fw-bold text-accent mb-2" style="color: var(--brand-accent, #C18755);">03</span>
            <h3 class="h5 fw-bold mb-2">Bordir komputer</h3>
            <p class="text-muted small mb-0">
              Logo dibentuk dari jahitan benang; memberi tekstur timbul. Cocok untuk kain dengan struktur memadai, tetapi desain yang sangat kecil atau rumit perlu penyesuaian.
            </p>
          </div>
        </div>
      </div>

      <!-- Narrative on cost factors -->
      <div class="p-4 p-md-5 rounded-4 bg-surface-alt border">
        <h3 class="h5 fw-bold text-dark mb-3">Apa saja faktor biaya sablon tote bag?</h3>
        <p class="text-muted fs-6 mb-3" style="line-height: 1.8;">
          Materi awal Anda menyebut ilustrasi biaya sablon sekitar Rp5.000–Rp50.000 per tas, serta Rp2.000–Rp5.000 untuk spunbond. Angka tersebut <strong>bukan daftar harga yang terverifikasi untuk vendor ini</strong> sehingga tidak digunakan sebagai penawaran. Biaya nyata ditentukan oleh ukuran dan warna logo, pilihan metode, kuantitas, dan material.
        </p>
        <p class="text-muted fs-6 mb-0" style="line-height: 1.8;">
          Untuk membandingkan penawaran secara adil, minta rincian apakah harga sudah mencakup tas polos, pencetakan logo, finishing, sampel, pajak bila berlaku, dan pengiriman. Lihat juga <a href="/tote-bag-custom/" class="fw-bold text-brand text-decoration-none">panduan personalisasi tote bag custom</a>.
        </p>
      </div>
    </div>
  </section>

