    body {
      padding-bottom: 65px;
    }

    .malang-sticky-cta {
      z-index: 1020;
    }

    :global(.floating-wa-btn) {
      bottom: 70px !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('rfqMalangForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        e.stopPropagation();
        form.classList.add('was-validated');
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.focus();
        }
        return;
      }

      form.classList.add('was-validated');

      const data = new FormData(form);
      const getVal = function (k) {
        return String(data.get(k) || '').trim() || '-';
      };

      const nama = getVal('nama');
      const acara = getVal('acara');
      const bahan = getVal('bahanInput');
      const jumlah = getVal('jumlah');
      const ukuran = getVal('ukuran');
      const tanggal = getVal('tanggal');
      const kota = getVal('kota');
      const desain = getVal('desain');

      const lines = [
        'Halo ToteBag, saya ingin meminta penawaran tote bag custom di Malang.',
        '',
        'Nama/instansi: ' + nama,
        'Kebutuhan: ' + acara,
        'Bahan: ' + bahan,
        'Jumlah: ' + jumlah + ' pcs',
        'Ukuran/model: ' + ukuran,
        'Tanggal dibutuhkan: ' + tanggal,
        'Tujuan pengiriman: ' + kota,
        'Catatan desain: ' + desain,
        '',
        'Mohon info pilihan spesifikasi, estimasi harga dan jadwal yang memungkinkan.'
      ];

      const text = lines.join('\n');
      const waUrl = 'https://wa.me/6282131087971?text=' + encodeURIComponent(text);

      window.open(waUrl, '_blank', 'noopener,noreferrer');
    });
  })();
</script>
