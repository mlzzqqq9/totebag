---
import type { Category } from '@/data/siteData';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<article class="custom-card h-100 d-flex flex-column overflow-hidden">
  <div class="product-img-wrapper" style="aspect-ratio: 4 / 3;">
    <img 
      src={category.imageUrl} 
      alt={`Kategori ${category.title}`} 
      loading="lazy" 
      width="400" 
      height="300"
      class="w-100 h-100"
      style="object-fit: cover; display: block;"
    />
  </div>

  <div class="p-3 p-xl-4 d-flex flex-column flex-grow-1">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <span class="badge-accent">{category.shortName}</span>
      <span class="text-muted" style="font-size: 0.72rem;">Spesialisasi Bahan</span>
    </div>

    <h3 class="h6 fw-bold mb-2">
      <a href={`/produk/${category.slug}/`} class="text-decoration-none text-reset">
        {category.title}
      </a>
    </h3>

    <p class="small text-muted mb-3 flex-grow-1" style="font-size: 0.8125rem; line-height: 1.5;">
      {category.tagline}
    </p>

    <!-- Key benefits list -->
    <ul class="list-unstyled mb-3 d-flex flex-column gap-1 text-muted" style="font-size: 0.78rem;">
      {category.benefits.slice(0, 3).map(benefit => (
        <li class="d-flex align-items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#173F38" viewBox="0 0 16 16" class="mt-1 flex-shrink-0">
            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z"/>
          </svg>
          <span>{benefit}</span>
        </li>
      ))}
    </ul>

    <a href={`/produk/${category.slug}/`} class="btn btn-brand-outline btn-sm align-self-start mt-auto d-inline-flex align-items-center gap-1" style="font-size: 0.775rem;">
      <span>Lihat {category.shortName}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
      </svg>
    </a>
  </div>
</article>
