---
// TestimonialSection.astro - Komponen Testimoni Klien B2B & Institusi Estetik & Proporsional
interface Props {
  title?: string;
  subtitle?: string;
  limit?: number;
}

const {
  title = "Pengalaman Nyata Mitra Pengadaan B2B",
  subtitle = "Ulasan otentik dari tim procurement BUMN, panitia seminar kampus, perbankan, dan perusahaan energi yang mempercayakan produksi tas tote bag custom kepada workshop kami.",
  limit
} = Astro.props;

export interface Testimonial {
  name: string;
  role: string;
  organization: string;
  categoryLabel: string;
  orderSpec: string;
  quote: string;
  badge?: string;
}

const featuredTestimonial: Testimonial = {
  name: "Ir. Hendra Kusuma",
  role: "Assistant Manager Komunikasi & CSR",
  organization: "PT PLN (Persero) UID Jawa Timur",
  categoryLabel: "BUMN Ketenagalistrikan",
  orderSpec: "1.200 Pcs Tote Bag Dinir D600 Waterproof + Sablon Rubber",
  quote: "Pengadaan tas untuk rangkaian Hari Listrik Nasional sangat sukses. Jahitan dinir D600 sangat presisi, tahan percikan air, dan sablon logo tajam. Pengiriman kargo tiba 3 hari sebelum gladi bersih. Standar pengerjaannya sangat profesional dan tepat waktu.",
  badge: "⭐ Verified BUMN Order"
};

const gridTestimonials: Testimonial[] = [
  {
    name: "Dr. Retno Wulandari, M.Si.",
    role: "Ketua Pelaksana Konferensi Internasional",
    organization: "Universitas Brawijaya (UB) Malang",
    categoryLabel: "Perguruan Tinggi",
    orderSpec: "2.500 Pcs Tote Bag Blacu Super Grade A",
    quote: "Kain blacu yang digunakan benar-benar grade A: serat kapasnya bersih, natural, dan kokoh menampung prosiding seminar yang tebal. Administrasi, invoice, dan SPK dibuatkan sangat tertib sesuai standar kampus."
  },
  {
    name: "Farah Salsabila, S.Psi.",
    role: "Talent Acquisition & HR Engagement",
    organization: "PT Bank Mandiri (Persero) Tbk",
    categoryLabel: "Perbankan BUMN",
    orderSpec: "900 Pcs Cordura Tactical + Laptop Compartment",
    quote: "Paket onboarding kit karyawan baru Mandiri mendapat respon sangat antusias. Bahan cordura kokoh, warna navy pekat, dan kompartemen laptopnya sangat fungsional. Sampel approval cepat hanya 2 hari."
  },
  {
    name: "Dimas Suryaputra",
    role: "Tim Pengadaan & Logistik Acara",
    organization: "Bank Indonesia (Kantor Perwakilan)",
    categoryLabel: "Bank Sentral",
    orderSpec: "850 Pcs Canvas Twill Premium + Resleting YKK",
    quote: "Standar merchandise Bank Indonesia menuntut kerapian tinggi. Tim workshop mampu memberikan hasil jahitan double-stitch tanpa sisa benang dan cetak DTF full color yang sangat awet."
  },
  {
    name: "Reza Anindita, S.T.",
    role: "Supply Chain & Procurement Department",
    organization: "PT Pamapersada Nusantara (PAMA)",
    categoryLabel: "Kontraktor Pertambangan",
    orderSpec: "1.500 Pcs Cordura Heavy Duty + Bordir Komputer",
    quote: "Kerapian bordir komputer logo PAMA dan ketahanan material cordura tidak diragukan lagi. Tim CS sangat komunikatif, memberikan simulasi mockup gratis dan foto progres berkala selama proses jahit."
  },
  {
    name: "M. Ikhsan Prabowo",
    role: "Corporate Communication & CSR Lead",
    organization: "PT KIDECO Jaya Agung",
    categoryLabel: "Energi & Sumber Daya",
    orderSpec: "700 Pcs Tote Bag Denim Kasual 12 oz",
    quote: "Desain tas berbahan denim ini memberi nuansa modern, kasual, namun tetap berwibawa. Mitra kerja dan stakeholder perusahaan sangat mengapresiasi keunikan suvenir ini. Sangat direkomendasikan."
  },
  {
    name: "Ahmad Fauzan, S.Kom.",
    role: "Waka Bidang Hubungan Industri & Kesiswaan",
    organization: "SMK Telkom Malang",
    categoryLabel: "Pendidikan Vokasi",
    orderSpec: "600 Pcs Tas Spunbond 100 gsm Jahit Benang",
    quote: "Untuk kegiatan orientasi siswa dan wisuda, kami butuh tas yang ekonomis tapi tidak murahan. Spunbond 100 gsm jahit benang ini kuat memuat modul dan seragam. Selesai tepat waktu."
  }
];

const displayedItems = limit ? gridTestimonials.slice(0, limit) : gridTestimonials;
---

<section class="section-space testimonial-section py-5 position-relative">
  <div class="container position-relative">
    
    <!-- Section Header -->
    <div class="text-center max-w-75 mx-auto mb-4 mb-md-5">
      <span class="badge-accent">ULASAN &amp; REKOMENDASI MITRA</span>
      <h2 class="h2 fw-bold text-dark mt-2 mb-2" style="letter-spacing: -0.02em;">
        {title}
      </h2>
      <p class="text-muted small mb-0" style="line-height: 1.6; max-width: 650px; margin: 0 auto;">
        {subtitle}
      </p>
    </div>

    <!-- 1. Featured Spotlight Review (Horizontal Sleek Banner - No Vertical Void) -->
    <div class="featured-spotlight-banner p-4 p-md-5 rounded-4 position-relative mb-4 shadow-sm text-white overflow-hidden">
      <div class="spotlight-watermark" aria-hidden="true">&ldquo;</div>
      <div class="row align-items-center position-relative z-1 g-4">
        
        <div class="col-12 col-lg-8">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="badge spotlight-badge px-3 py-1 rounded-pill">
              {featuredTestimonial.badge}
            </span>
            <span class="text-warning small fw-semibold">
              ★★★★★ (Rating 5.0)
            </span>
          </div>

          <blockquote class="spotlight-quote mb-3">
            &ldquo;{featuredTestimonial.quote}&rdquo;
          </blockquote>

          <div class="spotlight-spec small text-white-50">
            <span class="text-warning fw-medium">Spesifikasi Pengadaan:</span> {featuredTestimonial.orderSpec}
          </div>
        </div>

        <div class="col-12 col-lg-4 border-start-lg border-white border-opacity-15 ps-lg-4">
          <div class="d-flex align-items-center gap-3">
            <div class="spotlight-avatar rounded-circle d-flex align-items-center justify-content-center fw-bold">
              PLN
            </div>
            <div>
              <div class="text-white fw-bold fs-6">{featuredTestimonial.name}</div>
              <div class="text-white-50 small">{featuredTestimonial.role}</div>
              <div class="text-warning small fw-semibold">{featuredTestimonial.organization}</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- 2. Balanced 3-Column Testimonial Grid (Natural Equal Height Cards) -->
    <div class="row g-3 g-md-4">
      {displayedItems.map(item => (
        <div class="col-12 col-md-6 col-lg-4 d-flex">
          <div class="review-box w-100 p-4 rounded-4 bg-white d-flex flex-column justify-content-between">
            
            <div>
              <!-- Top Meta -->
              <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <span class="org-category-pill small fw-semibold">
                  {item.categoryLabel}
                </span>
                <span class="stars-gold small">★★★★★</span>
              </div>

              <!-- Quote -->
              <p class="review-quote-text text-muted mb-3">
                &ldquo;{item.quote}&rdquo;
              </p>

              <!-- Spec Tag -->
              <div class="review-order-pill small mb-3">
                <span class="pill-dot"></span>
                <span>{item.orderSpec}</span>
              </div>
            </div>

            <!-- Author Footer -->
            <div class="pt-3 border-top d-flex align-items-center gap-2 mt-auto">
              <div class="review-author-badge">
                {item.organization.split(' ')[0]}
              </div>
              <div class="overflow-hidden lh-sm">
                <div class="text-dark fw-bold small text-truncate">{item.name}</div>
                <div class="text-muted" style="font-size: 0.76rem;">{item.organization}</div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- 3. Trust Metric Bar -->
    <div class="mt-4 p-3 p-md-4 rounded-4 bg-white border d-flex flex-wrap align-items-center justify-content-around gap-3 text-center">
      <div class="px-2">
        <div class="fw-bold fs-4 text-brand">100+</div>
        <div class="text-muted small">Instansi BUMN &amp; Kampus</div>
      </div>
      <div class="d-none d-md-block vr"></div>
      <div class="px-2">
        <div class="fw-bold fs-4 text-brand">50.000+</div>
        <div class="text-muted small">Tote Bag Terdistribusi</div>
      </div>
      <div class="d-none d-md-block vr"></div>
      <div class="px-2">
        <div class="fw-bold fs-4 text-brand">99.8%</div>
        <div class="text-muted small">Tepat Waktu &amp; Zero Defect</div>
      </div>
      <div class="d-none d-md-block vr"></div>
      <div class="px-2">
        <div class="fw-bold fs-4 text-brand">4.9 / 5.0</div>
        <div class="text-muted small">Indeks Kepuasan Klien</div>
      </div>
    </div>

  </div>
</section>

<style>
.testimonial-section {
  background: #F9FAF8;
}

/* Featured Spotlight Banner (Compact & Horizontal) */
.featured-spotlight-banner {
  background: linear-gradient(135deg, #173F38 0%, #0F2D28 100%);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.spotlight-watermark {
  position: absolute;
  top: -25px;
  right: 25px;
  font-size: 9rem;
  line-height: 1;
  color: rgba(255, 255, 255, 0.05);
  font-family: Georgia, serif;
  user-select: none;
  pointer-events: none;
}

.spotlight-badge {
  background: rgba(193, 135, 85, 0.25);
  color: #E2B285;
  border: 1px solid rgba(193, 135, 85, 0.4);
  font-size: 0.76rem;
}

.spotlight-quote {
  font-size: 1.05rem;
  line-height: 1.65;
  font-style: italic;
  color: #F0F4F2;
}

.spotlight-avatar {
  width: 48px;
  height: 48px;
  background: #C18755;
  color: #ffffff;
  font-size: 0.85rem;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
}

@media (min-width: 992px) {
  .border-start-lg {
    border-left: 1px solid rgba(255, 255, 255, 0.15) !important;
  }
}

/* Grid Reviews */
.review-box {
  border: 1px solid rgba(23, 63, 56, 0.08);
  box-shadow: 0 4px 12px rgba(23, 63, 56, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.review-box:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(23, 63, 56, 0.08);
}

.org-category-pill {
  color: #173F38;
  background: rgba(23, 63, 56, 0.06);
  padding: 0.15rem 0.6rem;
  border-radius: 50rem;
  font-size: 0.72rem;
}

.stars-gold {
  color: #F59E0B;
  letter-spacing: 1px;
}

.review-quote-text {
  font-size: 0.92rem;
  line-height: 1.6;
}

.review-order-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #F7F9F8;
  padding: 0.3rem 0.65rem;
  border-radius: 6px;
  color: #556B66;
  font-size: 0.76rem;
}

.pill-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #C18755;
  flex-shrink: 0;
}

.review-author-badge {
  padding: 0.2rem 0.45rem;
  background: #173F38;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.68rem;
  border-radius: 5px;
  letter-spacing: 0.3px;
  flex-shrink: 0;
}

.text-brand {
  color: #173F38;
}
</style>
