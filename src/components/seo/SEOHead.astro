---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = 'https://totebag.web.id/media/lifestyle-tote-bag-green-energy.webp',
  ogType = 'website',
  jsonLd
} = Astro.props;

const siteName = "Tote Bag Custom B2B Malang";
const fullTitle = title.includes("Tote Bag") ? title : `${title} | Tote Bag Custom B2B`;

// Default Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://totebag.web.id/#organization",
  "name": "Tote Bag Custom Malang",
  "url": "https://totebag.web.id",
  "logo": "https://totebag.web.id/favicon.svg",
  "image": "https://totebag.web.id/media/lifestyle-tote-bag-green-energy.webp",
  "telephone": "+6282131087971",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+6282131087971",
    "contactType": "sales",
    "areaServed": "ID",
    "availableLanguage": ["id", "en"]
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kedungkandang",
    "addressLocality": "Malang",
    "addressRegion": "Jawa Timur",
    "postalCode": "65136",
    "addressCountry": "ID"
  }
};

function enrichSchemaFields(data: any): any {
  if (!data) return data;
  try {
    const cloned = JSON.parse(JSON.stringify(data));
    const rawImage = ogImage || "https://totebag.web.id/media/lifestyle-tote-bag-green-energy.webp";
    const fallbackImage = rawImage.startsWith("http") ? rawImage : `https://totebag.web.id${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;
    const fallbackLogo = "https://totebag.web.id/favicon.svg";

    const fixItem = (item: any) => {
      if (!item || typeof item !== "object") return;
      const type = item["@type"];

      if (type === "Organization" || type === "LocalBusiness") {
        if (!item.image) item.image = fallbackImage;
        if (!item.logo) item.logo = fallbackLogo;
        if (!item.address) {
          item.address = {
            "@type": "PostalAddress",
            "streetAddress": "Kedungkandang",
            "addressLocality": "Malang",
            "addressRegion": "Jawa Timur",
            "postalCode": "65136",
            "addressCountry": "ID"
          };
        }
      }

      if (type === "BlogPosting" || type === "Article" || type === "NewsArticle") {
        if (!item.image) {
          item.image = fallbackImage;
        }
      }
    };

    if (Array.isArray(cloned["@graph"])) {
      cloned["@graph"].forEach(fixItem);
    } else if (Array.isArray(cloned)) {
      cloned.forEach(fixItem);
    } else {
      fixItem(cloned);
    }
    return cloned;
  } catch {
    return data;
  }
}

const finalJsonLd = jsonLd ? enrichSchemaFields(jsonLd) : organizationSchema;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="id_ID" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
</head>
