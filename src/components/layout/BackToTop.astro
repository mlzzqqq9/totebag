---
// BackToTop.astro - Tombol Kembali ke Atas (Back to Top) Halus & Responsif
---

<button
  type="button"
  id="backToTopBtn"
  class="back-to-top-btn"
  aria-label="Kembali ke atas halaman"
  title="Kembali ke atas"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
    <path fill-rule="evenodd" d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5 5.707V11.5a.5.5 0 0 0 .5.5z"/>
  </svg>
</button>

<style>
.back-to-top-btn {
  position: fixed;
  bottom: 74px;
  right: 20px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: #173F38;
  color: #ffffff;
  border: 2px solid #ffffff;
  box-shadow: 0 4px 14px rgba(23, 63, 56, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity 0.28s ease, transform 0.28s ease, background-color 0.2s ease, visibility 0.28s ease;
}

.back-to-top-btn.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top-btn:hover {
  background-color: #C18755;
  color: #ffffff;
  transform: translateY(-3px);
  box-shadow: 0 6px 18px rgba(193, 135, 85, 0.38);
}

.back-to-top-btn:active {
  transform: translateY(0);
}

@media (max-width: 576px) {
  .back-to-top-btn {
    bottom: 64px;
    right: 14px;
    width: 38px;
    height: 38px;
  }
}
</style>

<script>
(function() {
  const btn = document.getElementById('backToTopBtn');
  if (!btn) return;

  const toggleVisibility = () => {
    if (window.scrollY > 300) {
      btn.classList.add('show');
    } else {
      btn.classList.remove('show');
    }
  };

  window.addEventListener('scroll', toggleVisibility, { passive: true });

  btn.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });

  toggleVisibility();
})();
</script>
