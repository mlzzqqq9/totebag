---
import SEOHead from '@/components/seo/SEOHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppCTA from '@/components/layout/WhatsAppCTA.astro';
import BackToTop from '@/components/layout/BackToTop.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
  productName?: string;
  categoryName?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  jsonLd,
  productName,
  categoryName
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <SEOHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    ogType={ogType}
    jsonLd={jsonLd}
  />
  <body>
    <!-- Skip to main content for accessibility -->
    <a href="#mainContent" class="visually-hidden-focusable p-3 bg-white text-dark position-absolute z-3">
      Lewati ke konten utama
    </a>

    <Header />

    <main id="mainContent">
      <slot />
    </main>

    <Footer />

    <WhatsAppCTA 
      productName={productName}
      categoryName={categoryName}
    />

    <BackToTop />

    <!-- Bootstrap 5.3 JavaScript Bundle -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
